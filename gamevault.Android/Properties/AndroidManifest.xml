<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<!-- The games go to /storage/emulated/0/SanctuaryVault, where RetroArch can read them -->
	<uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
	<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<!-- Downloads go on while another app is on the screen -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
	<!-- RetroArch for Android, downloaded from libretro, is handed to Android's installer -->
	<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
	<!-- Android 11+: RetroArch must be visible to be started -->
	<queries>
		<package android:name="com.retroarch" />
		<package android:name="com.retroarch.aarch64" />
		<package android:name="com.retroarch.ra32" />
		<!-- The emulator apps a console can be played with instead of the app's own player -->
		<package android:name="com.github.stenzek.duckstation" />
		<package android:name="xyz.aethersx2.android" />
		<package android:name="xyz.aethersx2.tturnip" />
		<package android:name="xyz.aethersx2.cturnip" />
		<package android:name="org.dolphinemu.dolphinemu" />
		<package android:name="org.mm.jr" />
		<package android:name="org.dolphinemu.mmjr" />
		<package android:name="me.magnum.melonds" />
		<package android:name="me.magnum.melondualds" />
		<package android:name="com.dsemu.drastic" />
		<package android:name="it.dbtecno.pizzaboygbapro" />
		<package android:name="it.dbtecno.pizzaboygba" />
		<package android:name="com.explusalpha.Snes9xPlus" />
		<package android:name="org.azahar_emu.azahar" />
		<package android:name="io.github.lime3ds.android" />
		<package android:name="org.citra.citra_emu" />
		<intent>
			<action android:name="android.intent.action.VIEW" />
			<data android:scheme="https" />
		</intent>
		<!-- The living-room mode starts the device's other apps (SanctuaryVault as the home screen of a handheld) -->
		<intent>
			<action android:name="android.intent.action.MAIN" />
			<category android:name="android.intent.category.LAUNCHER" />
		</intent>
	</queries>
	<application android:label="SanctuaryVault" android:icon="@mipmap/icon" android:requestLegacyExternalStorage="true" android:usesCleartextTraffic="true">
		<!-- The downloaded RetroArch APK, read by the installer -->
		<provider android:name="androidx.core.content.FileProvider" android:authorities="fr.alexisdominguez.sanctuaryvault.fileprovider"
			android:exported="false" android:grantUriPermissions="true">
			<meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
		</provider>
	</application>
</manifest>

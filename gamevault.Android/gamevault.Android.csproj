<Project Sdk="Microsoft.NET.Sdk">

	<!-- The Android app: the same sources as gamevault/ (linked, not copied), started by MainActivity instead of
	     Program.Main. Its own files are the Android ones (activity, manifest, launcher icon). -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0-android</TargetFramework>
		<SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<!-- The libretro cores are called through function pointers -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ImplicitUsings>disable</ImplicitUsings>
		<!-- Same assembly as the desktop client: the views' resources are avares://gamevault/... -->
		<AssemblyName>gamevault</AssemblyName>
		<RootNamespace>gamevault</RootNamespace>
		<ApplicationId>fr.alexisdominguez.sanctuaryvault</ApplicationId>
		<ApplicationTitle>SanctuaryVault</ApplicationTitle>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.40.0</ApplicationDisplayVersion>
		<Version>1.40.0</Version>
		<Product>SanctuaryVault</Product>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<!-- .NET's own HTTP (SocketsHttpHandler), not Android's: closing a download's connection that was not read to its
		     end reads the rest on the calling thread, and Android stops that on the UI thread (NetworkOnMainThreadException,
		     shown as "Java.Lang.RuntimeException" at the end of a download in several parts) -->
		<UseNativeHttpHandler>false</UseNativeHttpHandler>
		<RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
		<AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
		<!-- The views bind by reflection (compiled bindings are off): no trimming of the app's own types -->
		<TrimMode>partial</TrimMode>
	</PropertyGroup>

	<!-- Smooth from the first scroll: the whole app compiled ahead of time (no code compiled while a list moves) -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<RunAOTCompilation>true</RunAOTCompilation>
		<AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
	</PropertyGroup>
	<PropertyGroup>
		<NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8618;CS8619;CS8620;CS8622;CS8625;CS8629;CS8632;CA1416;CA1422;XA4211;IL2026;IL2104;IL3053</NoWarn>
		<WarningsAsErrors>$(WarningsAsErrors);CS0067;CS0168;CS0169;CS0414;CS0649;CS1998;CS4014;CS8509;CS8612;CS8767;CA2022</WarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<!-- A larger young generation for the garbage collector: fewer pauses while the pages scroll -->
		<AndroidEnvironment Include="environment.txt" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\gamevault\**\*.cs" Exclude="..\gamevault\obj\**;..\gamevault\bin\**;..\gamevault\Program.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
		<AvaloniaXaml Include="..\gamevault\**\*.axaml" Exclude="..\gamevault\obj\**;..\gamevault\bin\**" Link="%(RecursiveDir)%(Filename)%(Extension)" />
		<AvaloniaResource Include="..\gamevault\Resources\Images\**" Link="Resources\Images\%(RecursiveDir)%(Filename)%(Extension)" />
		<AvaloniaResource Include="..\gamevault\Resources\Fonts\*.ttf" Link="Resources\Fonts\%(Filename)%(Extension)" />
		<EmbeddedResource Include="..\gamevault\Resources\Assets\Themes\*.xaml" LogicalName="Themes/%(Filename)%(Extension)" Link="Resources\Assets\Themes\%(Filename)%(Extension)" />
		<EmbeddedResource Include="..\gamevault\Localization\*.json" LogicalName="gamevault.Localization.%(Filename)%(Extension)" Link="Localization\%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="11.3.22" />
		<PackageReference Include="Avalonia.Android" Version="11.3.22" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
		<PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="11.1.5" />
		<PackageReference Include="Avalonia.Controls.WebView" Version="11.4.1" />
		<PackageReference Include="Avalonia.Labs.Gif" Version="11.3.1" />
		<PackageReference Include="Markdown.Avalonia.Tight" Version="11.0.3" />
		<PackageReference Include="CommandLineParser" Version="2.9.1" />
		<PackageReference Include="Velopack" Version="1.2.161" />
		<PackageReference Include="DesktopNotifications.FreeDesktop" Version="1.3.1" />
		<PackageReference Include="Tmds.DBus" Version="0.92.0" />
		<PackageReference Include="DesktopNotifications.Windows" Version="1.3.1" />
		<PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
		<PackageReference Include="SocketIOClient" Version="3.1.2" />
		<PackageReference Include="SkiaSharp" Version="2.88.9" />
		<PackageReference Include="YamlDotNet" Version="16.3.0" />
		<PackageReference Include="YoutubeExplode" Version="6.6.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\GameVault.Core\GameVault.Core.csproj" />
	</ItemGroup>

</Project>

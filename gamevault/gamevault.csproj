<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<ApplicationIcon>Resources\Images\icon.ico</ApplicationIcon>
		<StartupObject>gamevault.Program</StartupObject>
		<!-- Release builds pass -p:Version=<tag>; Velopack packages use the same version -->
		<Version>1.22.0</Version>
		<Product>SanctuaryVault</Product>
		<Copyright>© Phalcode™. All Rights Reserved.</Copyright>
		<AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<!-- The code base predates nullable annotations; keep the build output readable. -->
		<!-- Nullable warnings of the code inherited from the WPF client are still to be fixed (about 560) -->
		<NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8618;CS8619;CS8620;CS8622;CS8625;CS8629;CS8632;CA1416</NoWarn>
		<!-- Fixed everywhere: they must not come back (swallowed exceptions, unawaited tasks, partial reads, ...) -->
		<WarningsAsErrors>$(WarningsAsErrors);CS0067;CS0168;CS0169;CS0414;CS0649;CS1998;CS4014;CS8509;CS8612;CS8767;CA2022</WarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Resources\Images\**" />
		<!-- Figtree (text) and Sora (titles), SIL Open Font License: see Resources/Fonts/OFL-*.txt -->
		<AvaloniaResource Include="Resources\Fonts\*.ttf" />
		<!-- WPF-format theme files: read as data by ThemeManager, never compiled as XAML -->
		<EmbeddedResource Include="Resources\Assets\Themes\*.xaml" LogicalName="Themes/%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="11.3.22" />
		<PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
		<PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="11.1.5" />
		<PackageReference Include="Avalonia.Controls.WebView" Version="11.4.1" />
		<PackageReference Include="Avalonia.Labs.Gif" Version="11.3.1" />
		<PackageReference Include="Avalonia.Diagnostics" Version="11.3.22" Condition="'$(Configuration)' == 'Debug'" />
		<PackageReference Include="Markdown.Avalonia.Tight" Version="11.0.3" />
		<PackageReference Include="CommandLineParser" Version="2.9.1" />
		<PackageReference Include="Velopack" Version="1.2.161" />
		<PackageReference Include="DesktopNotifications.FreeDesktop" Version="1.3.1" />
		<!-- Pinned: 0.9.1 (from DesktopNotifications) has GHSA-xrw6-gwf8-vvr9 -->
		<PackageReference Include="Tmds.DBus" Version="0.92.0" />
		<PackageReference Include="DesktopNotifications.Windows" Version="1.3.1" />
		<PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
		<!-- Same version as Avalonia's renderer: image resizing and JPEG encoding -->
		<PackageReference Include="SkiaSharp" Version="2.88.9" />
		<PackageReference Include="YamlDotNet" Version="16.3.0" />
		<PackageReference Include="YoutubeExplode" Version="6.6.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\GameVault.Core\GameVault.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="GameVault.UiTests" />
	</ItemGroup>

	<ItemGroup>
		<!-- Translations keyed by the English text -->
		<EmbeddedResource Include="Localization\*.json" />
	</ItemGroup>

	<!-- Windows builds ship the bundled 7-Zip and Ludusavi binaries; on Linux the system packages are used
	     (the Linux release adds the Linux Ludusavi itself). Builds without a runtime (development) keep them. -->
	<ItemGroup Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">
		<None Update="Lib\7z\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Lib\savegame\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>

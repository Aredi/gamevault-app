<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:gamevault.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:gamevault.UserControls"
             xmlns:sc="clr-namespace:gamevault.UserControls.SettingsComponents"
             x:Class="gamevault.UserControls.SettingsComponents.PublishGameUserControl"
             Focusable="True">
    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>
    <Grid>
        <Button Classes="round small" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0" ZIndex="1" Click="Close_Click" ToolTip.Tip="{l:T 'Close (Esc)'}">
            <Path Data="m11.25 4.75l-6.5 6.5m0-6.5l6.5 6.5" Stroke="{DynamicResource Brush.Foreground}" StrokeThickness="1.8" Fill="Transparent" Width="11" Height="11" Stretch="Uniform" />
        </Button>
        <Border Background="{DynamicResource Brush.Background}" Padding="28,22">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel MaxWidth="860" HorizontalAlignment="Left">
                <StackPanel Spacing="2" IsEnabled="{Binding IsIdle}">
                    <TextBlock Classes="sectionTitle" Text="{l:T 'Publish a Game'}" FontSize="22" />

                    <TextBlock Classes="label" Text="{l:T '1. Game files'}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <controls:IconButton Text="{l:T 'Game folder'}" Icon="{DynamicResource IconGameSettingsFolder}" IconMargin="0,0,5,0" MinWidth="140" Height="32" FontSize="14" Click="PickFolder_Click" />
                        <controls:IconButton Text="{l:T 'Installer or archive'}" MinWidth="170" Height="32" FontSize="14" Click="PickFile_Click" />
                        <TextBlock Text="{Binding SourcePath}" VerticalAlignment="Center" MaxWidth="440" TextTrimming="CharacterEllipsis" FontSize="13" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding HasSource}">
                        <TextBlock Classes="label" Text="{l:T '2. Game'}" />
                        <Grid ColumnDefinitions="*,140,100" ColumnSpacing="10">
                            <TextBox Text="{Binding Title}" Watermark="{l:T 'Title'}" />
                            <TextBox Grid.Column="1" Text="{Binding Version}" Watermark="{l:T 'Version (1.0)'}" />
                            <TextBox Grid.Column="2" Text="{Binding Year}" Watermark="{l:T 'Year'}" />
                        </Grid>
                        <!-- Already on the server: published as a new version of that game, not as a second game -->
                        <StackPanel IsVisible="{Binding HasExistingMatches}" Margin="0,8,0,0" Spacing="6">
                            <TextBlock Classes="hint" Text="{l:T 'Already on the server? Choose the game to publish this file as its new version:'}" />
                            <ItemsControl ItemsSource="{Binding ExistingMatches}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="wrapper" Margin="0,0,10,8" Padding="0" Cursor="Hand" Click="UseExistingGame_Click">
                                            <Border CornerRadius="10" Padding="8" Width="260" BorderThickness="2" Background="{DynamicResource Brush.Background2}"
                                                    BorderBrush="{Binding IsSelected, Converter={x:Static sc:PublishGameUserControl.SelectedBorder}}">
                                                <Grid ColumnDefinitions="40,*">
                                                    <Border Width="40" Height="60" CornerRadius="5" ClipToBounds="True" Background="{DynamicResource Brush.Surface3}">
                                                        <controls:CacheImage ImageCacheType="GameCover" Stretch="UniformToFill" Data="{Binding Game}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="3">
                                                        <TextBlock Text="{Binding Game.Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Info}" Classes="hint" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Classes="hint" Text="{Binding ExistingHint}" Foreground="{DynamicResource Brush.Accent}" Opacity="1" FontWeight="SemiBold" Margin="0,4,0,0"
                                   IsVisible="{Binding ExistingHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Classes="hint" Text="{Binding TitleWarning}" Foreground="{DynamicResource Brush.Warning}" Opacity="1" FontWeight="SemiBold" Margin="0,4,0,0"
                                   IsVisible="{Binding TitleWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Classes="hint" Text="{Binding VersionWarning}" Foreground="{DynamicResource Brush.Warning}" Opacity="1" FontWeight="SemiBold" Margin="0,4,0,0"
                                   IsVisible="{Binding VersionWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,8,0,0">
                            <ComboBox SelectedIndex="{Binding TypeIndex}" Width="260">
                                <ComboBoxItem Content="{l:T 'Windows game, portable'}" />
                                <ComboBoxItem Content="{l:T 'Windows game, installer'}" />
                                <ComboBoxItem Content="{l:T 'Linux game, portable'}" />
                            </ComboBox>
                            <CheckBox Content="{l:T 'Early access'}" IsChecked="{Binding EarlyAccess}" />
                        </StackPanel>

                        <!-- Portable: main executable -->
                        <StackPanel IsVisible="{Binding IsPortable}">
                            <TextBlock Classes="label" Text="{l:T '3. Executable started by Play'}" />
                            <ComboBox ItemsSource="{Binding Executables}" SelectedItem="{Binding SelectedExecutable}" HorizontalAlignment="Stretch" PlaceholderText="{l:T 'Found automatically (archives: chosen on first start)'}" />
                            <TextBox Text="{Binding LaunchParameters}" Watermark="{l:T 'Launch parameters (optional), e.g. -windowed'}" Margin="0,6,0,0" />
                        </StackPanel>
                        <!-- Installer -->
                        <StackPanel IsVisible="{Binding IsSetup}">
                            <TextBlock Classes="label" Text="{l:T '3. Installer'}" />
                            <ComboBox ItemsSource="{Binding Installers}" SelectedItem="{Binding SelectedInstaller}" HorizontalAlignment="Stretch" PlaceholderText="{l:T 'Installer (setup.exe)'}" SelectionChanged="Installer_SelectionChanged" />
                            <TextBox Text="{Binding InstallerParameters}" Watermark="{l:T 'Installer parameters, %INSTALLDIR% = installation folder'}" Margin="0,6,0,0" />
                            <TextBlock Classes="hint" Text="{Binding InstallerHint}" Margin="0,4,0,0" />
                        </StackPanel>

                        <TextBlock Classes="label" Text="{l:T '4. Destination on the server'}" />
                        <ComboBox SelectedIndex="{Binding DestinationIndex}" Width="420" Margin="0,0,0,6">
                            <ComboBoxItem Content="{l:T 'Copy into the server games folder'}" />
                            <ComboBoxItem Content="{l:T 'Upload to the server'}" />
                        </ComboBox>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding !IsUpload}">
                            <TextBox Text="{Binding TargetDirectory}" Watermark="{l:T 'Folder mounted as /files in the SanctuaryVault server'}" />
                            <controls:IconButton Grid.Column="1" Text="{l:T 'Browse'}" MinWidth="90" Height="32" FontSize="14" Click="PickTarget_Click" />
                        </Grid>
                        <StackPanel IsVisible="{Binding IsUpload}" Spacing="4">
                            <TextBlock Classes="hint" Text="{Binding UploaderStatus, Converter={x:Static l:LocConverter.Instance}}" />
                        </StackPanel>
                        <CheckBox Content="{l:T 'Compress the archive (slower)'}" IsChecked="{Binding Compress}" Margin="0,6,0,0" IsVisible="{Binding !IsArchiveSource}" />

                        <TextBlock Classes="label" Text="{l:T 'File on the server'}" />
                        <SelectableTextBlock Text="{Binding FileName}" FontSize="14" />

                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,15,0,0">
                            <controls:IconButton Text="{l:T 'Publish'}" Icon="{DynamicResource IconGameSettingsSave}" IconMargin="0,0,5,2" MinWidth="140" Height="36" FontSize="15" Click="Publish_Click" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <!-- Progress / result, also visible while the form is disabled -->
                <Border Margin="0,15,0,0" Padding="10" CornerRadius="6" Background="{DynamicResource Brush.Background2}"
                        IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Status, Converter={x:Static l:LocConverter.Instance}}" TextWrapping="Wrap" FontSize="14" />
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="6" IsVisible="{Binding IsBusy}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding PublishedGame, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <controls:IconButton Text="{l:T 'Open game page'}" MinWidth="160" Height="32" FontSize="14" Click="OpenGame_Click" />
                            <controls:IconButton Text="{l:T 'Publish another'}" Kind="Skeleton" MinWidth="160" Height="32" FontSize="14" Click="Reset_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

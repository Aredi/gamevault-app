<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:gamevault.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:gamevault.UserControls"
             x:Class="gamevault.UserControls.SettingsComponents.ProblemReportUserControl"
             Focusable="True">
    <Grid>
        <Button Classes="round small" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0" ZIndex="1" Click="Close_Click" ToolTip.Tip="{l:T 'Close (Esc)'}">
            <Path Data="m11.25 4.75l-6.5 6.5m0-6.5l6.5 6.5" Stroke="{DynamicResource Brush.Foreground}" StrokeThickness="1.8" Fill="Transparent" Width="11" Height="11" Stretch="Uniform" />
        </Button>
        <Border Background="{DynamicResource Brush.Background}" Padding="28,22,28,24" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="18" Width="560">
            <StackPanel Spacing="12">
                <TextBlock Classes="sectionTitle" Text="{l:T 'Report a problem'}" FontSize="22" />
                <TextBlock TextWrapping="Wrap" FontSize="14" Text="{l:T 'Create a report to send to the administrator.'}" />
                <TextBlock TextWrapping="Wrap" FontSize="13" Classes="muted" Text="{l:T 'Passwords, tokens and keys are never included.'}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <controls:IconButton x:Name="uiBtnCreate" Text="{l:T 'Create report'}" Icon="{DynamicResource IconGameSettingsSave}" IconMargin="0,0,5,2" MinWidth="170" Height="36" FontSize="15" Click="Create_Click" />
                    <controls:IconButton x:Name="uiBtnOpenFolder" Text="{l:T 'Open folder'}" Kind="Skeleton" MinWidth="140" Height="36" FontSize="15" Click="OpenFolder_Click" IsVisible="False" />
                    <controls:IconButton x:Name="uiBtnCopyPath" Text="{l:T 'Copy the path'}" Kind="Skeleton" MinWidth="140" Height="36" FontSize="15" Click="CopyPath_Click" IsVisible="False" />
                </StackPanel>
                <SelectableTextBlock x:Name="uiStatus" TextWrapping="Wrap" FontSize="14" />
                <Separator />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{l:T 'A bug in SanctuaryVault itself?'}" FontSize="13" VerticalAlignment="Center" />
                    <Button Classes="link" Click="GitHub_Click">
                        <TextBlock Text="{l:T 'Report it on GitHub'}" FontSize="13" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:gamevault.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:gamevault.UserControls"
             x:Class="gamevault.UserControls.SettingsComponents.ProblemReportUserControl"
             Focusable="True">
    <Grid>
        <Grid Classes="hover" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Margin="0,8,10,0" ZIndex="1" Height="20" Width="20" Cursor="Hand" PointerReleased="Close_Click" ToolTip.Tip="{l:T 'Close (Esc)'}">
            <Path Fill="{DynamicResource Brush.Foreground}" Stroke="{DynamicResource Brush.Foreground}" Data="{DynamicResource IconClose}" />
        </Grid>
        <Border Background="{DynamicResource Brush.Background}" Padding="25" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="2" CornerRadius="10" Width="640">
            <StackPanel Spacing="12">
                <TextBlock Text="{l:T 'Report a problem'}" FontSize="26" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" FontSize="14" Text="{l:T 'Something does not work? Create a report and send it to the administrator of your SanctuaryVault server (e-mail, Discord, ...). It contains the versions, your settings, your installed games and downloads, and the logs of the last days.'}" />
                <TextBlock TextWrapping="Wrap" FontSize="13" Opacity="0.75" Text="{l:T 'Passwords, sign-in tokens and API keys are never part of the report.'}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <controls:IconButton x:Name="uiBtnCreate" Text="{l:T 'Create report'}" Icon="{DynamicResource IconGameSettingsSave}" IconMargin="0,0,5,2" MinWidth="170" Height="36" FontSize="15" Click="Create_Click" />
                    <controls:IconButton x:Name="uiBtnOpenFolder" Text="{l:T 'Open folder'}" Kind="Skeleton" MinWidth="140" Height="36" FontSize="15" Click="OpenFolder_Click" IsVisible="False" />
                    <controls:IconButton x:Name="uiBtnCopyPath" Text="{l:T 'Copy the path'}" Kind="Skeleton" MinWidth="140" Height="36" FontSize="15" Click="CopyPath_Click" IsVisible="False" />
                </StackPanel>
                <SelectableTextBlock x:Name="uiStatus" TextWrapping="Wrap" FontSize="14" />
                <Separator />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{l:T 'A bug in SanctuaryVault itself?'}" FontSize="13" VerticalAlignment="Center" />
                    <Button Classes="link" Click="GitHub_Click">
                        <TextBlock Text="{l:T 'Report it on GitHub'}" FontSize="13" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

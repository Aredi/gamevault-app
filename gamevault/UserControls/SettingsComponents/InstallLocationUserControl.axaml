<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:gamevault.UserControls"
             x:Class="gamevault.UserControls.InstallLocationUserControl"
             Margin="300" Height="300" Width="420">
    <Border CornerRadius="5" Background="{DynamicResource Brush.Background2}" BorderThickness="1" BorderBrush="{DynamicResource Brush.Accent3}">
        <Grid>
            <Button Classes="wrapper" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,3,0" ZIndex="1" Click="Close_Click">
                <Grid Classes="hover" Background="Transparent" Height="25" Width="23">
                    <Path Fill="{DynamicResource Brush.Foreground}" Stroke="{DynamicResource Brush.Foreground}" Data="{DynamicResource IconClose}" />
                </Grid>
            </Button>
            <Button Classes="wrapper" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,35,0" ZIndex="1" Click="DirectorySettings_Click" ToolTip.Tip="Manage root directories">
                <Grid Classes="hover" Background="Transparent" Height="25" Width="23">
                    <Path Fill="{DynamicResource Brush.Foreground}" Data="{DynamicResource IconInstalledGamesSettings}" />
                </Grid>
            </Button>
            <StackPanel>
                <TextBlock Text="Choose your download location" FontWeight="Bold" FontSize="20" Margin="10" />
                <ScrollViewer Height="200" VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <ItemsControl ItemsSource="{Binding RootDirectories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" Classes="base" GroupName="RootDirectorySelection" Width="380" Margin="10,10,10,0" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Fill="White" Data="{StaticResource IconHardDrive}" RenderTransform="scale(0.7)" />
                                        <TextBlock Text="{Binding Key.Uri}" TextTrimming="CharacterEllipsis" Width="270" Margin="5,0,0,0" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Value}" FontSize="12" Width="60" TextAlignment="Right" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
            <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,10" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                <local:IconButton Text="Proceed" Height="25" Width="100" Click="Install_Click" />
                <local:IconButton Text="Cancel" Kind="Skeleton" BorderThickness="1" Height="25" Width="100" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

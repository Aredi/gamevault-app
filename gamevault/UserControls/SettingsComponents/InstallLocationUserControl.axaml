<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:gamevault.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="gamevault.UserControls.InstallLocationUserControl"
             Width="640" Focusable="True">
    <!-- Where the game goes: one of the game folders, or a new one -->
    <Border Background="{DynamicResource Brush.Background}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="18">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="22,18,22,20">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="uiTitle" Classes="sectionTitle" Text="{l:T 'Where should the game be installed?'}" />
                    <TextBlock x:Name="uiNeeded" Classes="muted" FontSize="13" />
                </StackPanel>
                <Button Grid.Column="1" Classes="round small" VerticalAlignment="Top" Click="Close_Click" ToolTip.Tip="{l:T 'Close'}">
                    <Path Data="m11.25 4.75l-6.5 6.5m0-6.5l6.5 6.5" Stroke="{DynamicResource Brush.Foreground}" StrokeThickness="1.8" Fill="Transparent" Width="11" Height="11" Stretch="Uniform" />
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="2" Margin="0,14,0,0" MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="uiLocations">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,6,8" Padding="14,10" CornerRadius="12" Background="{DynamicResource Brush.Background2}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Data="{StaticResource IconHardDrive}" Fill="{DynamicResource Brush.Foreground}" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Path}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="330" ToolTip.Tip="{Binding Path}" />
                                            <Border CornerRadius="8" Padding="8,1" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1" IsVisible="{Binding IsLast}" VerticalAlignment="Center">
                                                <TextBlock Text="{l:T 'Last used'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Details}" Classes="muted" FontSize="12.5" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="ghost small" Background="{DynamicResource Brush.Surface}" Click="Install_Click" IsEnabled="{Binding HasRoom}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Action}" VerticalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.Row="3" Spacing="12" Margin="0,6,0,0">
                <Button Classes="ghost" HorizontalAlignment="Left" Click="OtherFolder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Data="{StaticResource IconGameSettingsFolder}" Fill="{DynamicResource Brush.Foreground}" Width="16" Height="16" Stretch="Uniform" />
                        <TextBlock Text="{l:T 'Another folder…'}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <CheckBox x:Name="uiDontAsk" Content="{l:T 'Do not ask again'}" FontSize="13" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

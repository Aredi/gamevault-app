<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:gamevault.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:gamevault.UserControls"
             x:Class="gamevault.UserControls.SettingsComponents.RetroSettingsUserControl">
    <!-- Settings > Retro: RetroArch, the BIOS and the saves of the retro games (styles of the Settings page) -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,0,28,40" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Classes="h1" Text="RetroArch" />
            <TextBlock x:Name="uiRetroArch" TextWrapping="Wrap" FontSize="14" />
            <TextBlock x:Name="uiCores" Classes="muted" TextWrapping="Wrap" FontSize="13" Margin="0,4,0,0" />
            <WrapPanel Margin="0,12,0,0">
                <controls:IconButton Text="{l:T 'Open RetroArch'}" Icon="{StaticResource IconNavSettings}" FontSize="15" IconMargin="0,0,5,2" MinWidth="175" Height="40" Margin="0,0,10,8"
                                     ToolTip.Tip="{l:T 'RetroArch without a game: controls, picture, sound'}" Click="OpenMenu_Click" />
                <controls:IconButton Text="{l:T 'Reset its settings'}" Icon="{StaticResource IconReload}" FontSize="15" IconMargin="0,0,5,2" MinWidth="175" Height="40" Margin="0,0,10,8"
                                     ToolTip.Tip="{l:T 'Forget the core options and controls changed in RetroArch\&#x27;s menu'}" Click="ResetSettings_Click" />
                <controls:IconButton x:Name="uiUninstall" Text="{l:T 'Uninstall RetroArch'}" Kind="Danger" Icon="{StaticResource IconTrash}" FontSize="15" IconMargin="0,0,5,2" MinWidth="175" Height="40" Margin="0,0,10,8"
                                     Click="Uninstall_Click" />
            </WrapPanel>

            <StackPanel Classes="section">
                <TextBlock Classes="h1" Text="BIOS" />
                <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,8"
                           Text="{l:T 'Some platforms need the BIOS of the console. An administrator adds it in RomM (the Firmware of the platform); it is taken at the first game.'}" />
                <ItemsControl x:Name="uiBios">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="160,*" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Platform}" FontWeight="SemiBold" FontSize="13.5" />
                                <TextBlock Grid.Column="1" Text="{Binding State}" Classes="muted" FontSize="13.5" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Classes="section">
                <TextBlock Classes="h1" Text="{l:T 'Saves'}" />
                <TextBlock x:Name="uiSavesState" TextWrapping="Wrap" FontSize="14" />
                <WrapPanel Margin="0,12,0,0">
                    <controls:IconButton Text="{l:T 'Open the saves'}" Icon="{StaticResource IconGameSettingsFolder}" FontSize="15" IconMargin="0,0,5,2" MinWidth="175" Height="40" Margin="0,0,10,8"
                                         Click="OpenSaves_Click" />
                    <controls:IconButton Text="{l:T 'Open the backups'}" Icon="{StaticResource IconGameSettingsFolder}" FontSize="15" IconMargin="0,0,5,2" MinWidth="175" Height="40" Margin="0,0,10,8"
                                         ToolTip.Tip="{l:T 'The saves of this PC kept when newer ones came from another PC'}" Click="OpenBackups_Click" />
                </WrapPanel>
                <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,0"
                           Text="{l:T 'Each game has its cloud saves: send them, take them back or restore an older version from the page of the game.'}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

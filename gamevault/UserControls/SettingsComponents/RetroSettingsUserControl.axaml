<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:gamevault.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:gamevault.UserControls"
             x:Class="gamevault.UserControls.SettingsComponents.RetroSettingsUserControl">
    <!-- Settings > Retro: RetroArch, the BIOS and the saves of the retro games (styles of the Settings page) -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,0,28,40" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Classes="h1" Text="RetroArch" />
            <TextBlock x:Name="uiRetroArch" TextWrapping="Wrap" FontSize="14" />
            <TextBlock x:Name="uiCores" Classes="muted" TextWrapping="Wrap" FontSize="13" Margin="0,4,0,0" />
            <WrapPanel Margin="0,12,0,0">
                <controls:IconButton Text="{l:T 'Open RetroArch'}" Icon="{StaticResource IconNavSettings}" FontSize="15" IconMargin="0,0,5,2" MinWidth="175" Height="40" Margin="0,0,10,8"
                                     ToolTip.Tip="{l:T 'RetroArch without a game: controls, picture, sound'}" Click="OpenMenu_Click" />
                <controls:IconButton Text="{l:T 'Reset its settings'}" Icon="{StaticResource IconReload}" FontSize="15" IconMargin="0,0,5,2" MinWidth="175" Height="40" Margin="0,0,10,8"
                                     ToolTip.Tip="{l:T 'Forget the core options and controls changed in RetroArch\&#x27;s menu'}" Click="ResetSettings_Click" />
                <controls:IconButton x:Name="uiUninstall" Text="{l:T 'Uninstall RetroArch'}" Kind="Danger" Icon="{StaticResource IconTrash}" FontSize="15" IconMargin="0,0,5,2" MinWidth="175" Height="40" Margin="0,0,10,8"
                                     Click="Uninstall_Click" />
            </WrapPanel>

            <StackPanel Classes="section">
                <TextBlock Classes="h1" Text="BIOS" />
                <ItemsControl x:Name="uiBios">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="160,*" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Platform}" FontWeight="SemiBold" FontSize="13.5" />
                                <TextBlock Grid.Column="1" Text="{Binding State}" Classes="muted" FontSize="13.5" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Classes="section">
                <TextBlock Classes="h1" Text="{l:T 'RomM account'}" />
                <TextBlock x:Name="uiRommState" TextWrapping="Wrap" FontSize="14" />
                <Border x:Name="uiRommCode" IsVisible="False" Background="{DynamicResource Brush.Surface}" CornerRadius="12" Padding="16,12" Margin="0,12,0,0" HorizontalAlignment="Left">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{l:T 'Approve this code on the page of RomM that opened:'}" FontSize="13" />
                        <TextBlock x:Name="uiRommCodeText" FontFamily="{StaticResource Font.Display}" FontSize="30" FontWeight="Bold" LetterSpacing="3" />
                        <Button Classes="link" HorizontalAlignment="Left" Click="RommPage_Click">
                            <TextBlock Text="{l:T 'Open the page of RomM again'}" FontSize="13" TextDecorations="Underline" />
                        </Button>
                    </StackPanel>
                </Border>
                <WrapPanel Margin="0,12,0,0">
                    <controls:IconButton x:Name="uiRommLink" Text="{l:T 'Link my RomM account'}" Icon="{StaticResource IconGameSettingsLinked}" FontSize="15" IconMargin="0,0,5,2" MinWidth="175" Height="40" Margin="0,0,10,8"
                                         Click="RommLink_Click" />
                    <controls:IconButton x:Name="uiRommUnlink" Text="{l:T 'Unlink'}" Kind="Danger" Icon="{StaticResource IconGameSettingsUnlinked}" FontSize="15" IconMargin="0,0,5,2" MinWidth="175" Height="40" Margin="0,0,10,8"
                                         Click="RommUnlink_Click" />
                </WrapPanel>
            </StackPanel>

            <StackPanel Classes="section">
                <TextBlock Classes="h1" Text="RetroAchievements" />
                <TextBlock x:Name="uiAchievementsState" TextWrapping="Wrap" FontSize="14" />
                <WrapPanel x:Name="uiAchievementsForm" Margin="0,12,0,0">
                    <TextBox x:Name="uiAchievementsUser" Watermark="{l:T 'Username'}" Width="210" Height="40" Margin="0,0,10,8" VerticalContentAlignment="Center" />
                    <TextBox x:Name="uiAchievementsPassword" Watermark="{l:T 'Password'}" PasswordChar="●" Classes="revealPasswordButton" Width="210" Height="40" Margin="0,0,10,8"
                             VerticalContentAlignment="Center" KeyDown="AchievementsPassword_KeyDown" />
                    <controls:IconButton x:Name="uiAchievementsSignIn" Text="{l:T 'Sign in'}" Icon="{StaticResource IconGameSettingsLinked}" FontSize="15" IconMargin="0,0,5,2" MinWidth="175" Height="40" Margin="0,0,10,8"
                                         Click="AchievementsSignIn_Click" />
                </WrapPanel>
                <controls:IconButton x:Name="uiAchievementsSignOut" Text="{l:T 'Sign out'}" Kind="Danger" Icon="{StaticResource IconGameSettingsUnlinked}" FontSize="15" IconMargin="0,0,5,2" MinWidth="175" Height="40" Margin="0,12,10,8"
                                     HorizontalAlignment="Left" Click="AchievementsSignOut_Click" />
            </StackPanel>

            <StackPanel Classes="section">
                <TextBlock Classes="h1" Text="{l:T 'Picture'}" />
                <TextBlock Text="{l:T 'CRT look'}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                <ItemsControl x:Name="uiCrt">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsOn}" MinWidth="200" Margin="0,0,12,6" IsCheckedChanged="Crt_Changed" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{l:T 'Definition'}" FontWeight="SemiBold" FontSize="14" Margin="0,14,0,8" />
                <ItemsControl x:Name="uiResolution">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="260,Auto" Margin="0,0,0,8">
                                <TextBlock Text="{Binding Consoles}" FontSize="13.5" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ComboBox Grid.Column="1" MinWidth="120" ItemsSource="{Binding Choices}" SelectedIndex="{Binding Index}" SelectionChanged="Resolution_Changed" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Classes="section">
                <TextBlock Classes="h1" Text="{l:T 'Controls'}" />
                <TextBlock Text="{l:T 'The buttons of each console, on the gamepad or the keyboard, and the controller of the Wii and the PlayStation: set once, for all its games.'}" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,10" />
                <controls:IconButton x:Name="uiControls" Text="{l:T 'Set my controls'}" Icon="{StaticResource IconNavRetro}" FontSize="15" IconMargin="0,0,6,2" MinWidth="200" Height="40" HorizontalAlignment="Left" Margin="0,0,0,8"
                                     Click="Controls_Click" />
                <ItemsControl x:Name="uiControlsSet">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="10,5" Margin="0,0,8,8" Background="{DynamicResource Brush.Background2}">
                                <TextBlock Text="{Binding}" FontSize="12.5" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Classes="section">
                <TextBlock Classes="h1" Text="{l:T 'Game language'}" />
                <TextBlock x:Name="uiLanguageConsoles" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,10" />
                <ComboBox x:Name="uiLanguage" MinWidth="220" SelectionChanged="Language_Changed" />
            </StackPanel>

            <StackPanel Classes="section">
                <TextBlock Classes="h1" Text="{l:T 'Saves'}" />
                <TextBlock x:Name="uiSavesState" TextWrapping="Wrap" FontSize="14" />
                <WrapPanel Margin="0,12,0,0">
                    <controls:IconButton Text="{l:T 'Open the saves'}" Icon="{StaticResource IconGameSettingsFolder}" FontSize="15" IconMargin="0,0,5,2" MinWidth="175" Height="40" Margin="0,0,10,8"
                                         Click="OpenSaves_Click" />
                    <controls:IconButton Text="{l:T 'Open the backups'}" Icon="{StaticResource IconGameSettingsFolder}" FontSize="15" IconMargin="0,0,5,2" MinWidth="175" Height="40" Margin="0,0,10,8"
                                         ToolTip.Tip="{l:T 'The saves of this PC kept when newer ones came from another PC'}" Click="OpenBackups_Click" />
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

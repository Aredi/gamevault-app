<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:gamevault.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:gamevault.UserControls"
             x:Class="gamevault.UserControls.StorageUserControl"
             Focusable="True">
    <!-- The disks of the library and the room each installed game takes; the games not played for months first to go -->
    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24,18,24,18">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Classes="sectionTitle" Text="{l:T 'Storage'}" />
                <TextBlock x:Name="uiSummary" Classes="muted" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Classes="round small" VerticalAlignment="Top" Click="Close_Click" ToolTip.Tip="{l:T 'Close'}">
                <Path Data="m11.25 4.75l-6.5 6.5m0-6.5l6.5 6.5" Stroke="{DynamicResource Brush.Foreground}" StrokeThickness="1.8" Fill="Transparent" Width="11" Height="11" Stretch="Uniform" />
            </Button>
        </Grid>

        <!-- Disks -->
        <ItemsControl x:Name="uiDrives" Grid.Row="1" Margin="0,14,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="330" Margin="0,0,12,12" Padding="14,12" CornerRadius="14" Background="{DynamicResource Brush.Background2}">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Classes="muted" FontSize="12.5" Text="{Binding FreeText}" />
                            </Grid>
                            <!-- Used by SanctuaryVault, by the rest, free -->
                            <Grid Height="10" ClipToBounds="True">
                                <Border CornerRadius="5" Background="{DynamicResource Brush.Surface3}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Border Width="{Binding OursWidth}" CornerRadius="5,0,0,5" Background="{DynamicResource Brush.Accent}" />
                                    <Border Width="{Binding OthersWidth}" Background="{DynamicResource Brush.Muted}" Opacity="0.55" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Classes="muted" FontSize="12" Text="{Binding UsageText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <WrapPanel Grid.Row="2" Margin="0,4,0,10">
            <CheckBox x:Name="uiIdleOnly" Content="{l:T 'Only the games not played for 3 months'}" Margin="0,0,20,6" VerticalAlignment="Center" IsCheckedChanged="IdleOnly_Changed" />
            <TextBlock Classes="muted" Text="{l:T 'Sort by'}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,6" />
            <ComboBox x:Name="uiSort" SelectedIndex="0" MinWidth="200" Margin="0,0,0,6" SelectionChanged="Sort_Changed">
                <ComboBoxItem Content="{l:T 'Size'}" />
                <ComboBoxItem Content="{l:T 'Not played for the longest'}" />
                <ComboBoxItem Content="{l:T 'Title'}" />
            </ComboBox>
            <local:ProgressRing x:Name="uiLoading" IsActive="True" Width="22" Height="22" Margin="14,0,0,6" VerticalAlignment="Center" />
        </WrapPanel>

        <!-- Installed games -->
        <Panel Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="uiGames">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,8,8" Padding="10" CornerRadius="12" Background="{DynamicResource Brush.Background2}">
                                <Grid ColumnDefinitions="48,*,Auto,Auto">
                                    <Border Width="48" Height="72" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource Brush.Surface3}">
                                        <local:CacheImage ImageCacheType="GameCover" Stretch="UniformToFill" Data="{Binding Game}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14.5" TextTrimming="CharacterEllipsis" MaxWidth="460" />
                                            <Border CornerRadius="8" Padding="8,1" Background="{DynamicResource Brush.Warning}" IsVisible="{Binding IsIdle}" VerticalAlignment="Center">
                                                <TextBlock Text="{l:T 'Not played for a while'}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Classes="muted" FontSize="12.5" Text="{Binding PlayText}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Classes="round small" Click="OpenFolder_Click" ToolTip.Tip="{l:T 'Open folder'}">
                                            <Path Data="{StaticResource IconGameSettingsFolder}" Width="14" Height="14" />
                                        </Button>
                                        <Button Classes="ghost small" Background="{DynamicResource Brush.Surface}" Click="Uninstall_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <Path Data="{StaticResource IconTrash}" Fill="IndianRed" Width="13" Height="13" />
                                                <TextBlock Text="{l:T 'Uninstall'}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="uiEmpty" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
        </Panel>
    </Grid>
</UserControl>

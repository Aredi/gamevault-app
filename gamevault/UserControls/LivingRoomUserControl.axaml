<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:gamevault.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:gamevault.Converter"
             xmlns:local="clr-namespace:gamevault.UserControls"
             x:Class="gamevault.UserControls.LivingRoomUserControl"
             Focusable="True" Background="{DynamicResource Brush.Background}">
    <UserControl.Resources>
        <conv:BlurWhenConverter x:Key="blurWhenConv" />
        <conv:AccentShadowConverter x:Key="accentShadowConv" />
        <conv:AccentBrushConverter x:Key="accentBrushConv" />
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- Tiles: the focused one grows and glows in its game's color -->
        <Style Selector="Panel.tile">
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel.tile.focused">
            <Setter Property="RenderTransform" Value="scale(1.1)" />
        </Style>
        <Style Selector="Panel.tile Border.ring">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel.tile.focused Border.ring">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Panel.tile Border.cover">
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel.tile.focused Border.cover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TextBlock.rowTitle">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="TextBlock.rowTitle.current">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.glyph">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="15" />
        </Style>
        <Style Selector="Border.glyph TextBlock">
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,34,0" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto,Auto">
        <!-- The focused game across the whole screen -->
        <Panel Grid.RowSpan="3">
            <local:CacheImage x:Name="uiArt" ImageCacheType="GameBackground" FallbackToCover="True" Stretch="UniformToFill" Data="{Binding FocusedGame}"
                              Effect="{Binding #uiArt.IsShowingFallback, Converter={StaticResource blurWhenConv}, ConverterParameter=50}" />
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="{DynamicResource GameVault.Colors.Background}" Offset="0" />
                        <GradientStop Color="{DynamicResource GameVault.Colors.BackgroundSoft}" Offset="0.45" />
                        <GradientStop Color="{DynamicResource GameVault.Colors.BackgroundClear}" Offset="0.85" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
                        <GradientStop Color="{DynamicResource GameVault.Colors.Background}" Offset="0" />
                        <GradientStop Color="{DynamicResource GameVault.Colors.BackgroundStrong}" Offset="0.45" />
                        <GradientStop Color="{DynamicResource GameVault.Colors.BackgroundClear}" Offset="0.8" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Panel>

        <!-- Top: name, clock; then the focused game -->
        <Grid Grid.Row="0" RowDefinitions="Auto,*" Margin="72,44,72,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Image Source="/Resources/Images/icon.png" Width="40" Height="40" />
                    <TextBlock Text="SanctuaryVault" FontFamily="{StaticResource Font.Display}" FontWeight="ExtraBold" FontSize="22" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding GamepadConnected}">
                        <Path Data="M7 8h2v2h2v2H9v2H7v-2H5v-2h2zm10.5 1a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3M15 11.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3M7 4h10a6 6 0 0 1 6 6v4a5 5 0 0 1-9 3h-4a5 5 0 0 1-9-3v-4a6 6 0 0 1 6-6"
                              Fill="{DynamicResource Brush.Success}" Stretch="Uniform" Width="26" Height="20" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Clock}" FontFamily="{StaticResource Font.Display}" FontWeight="Bold" FontSize="24" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom" MaxWidth="900" HorizontalAlignment="Left" Spacing="12" Margin="0,0,0,26">
                <TextBlock Text="{Binding FocusedEyebrow}" FontSize="15" FontWeight="Bold" LetterSpacing="2" Opacity="0.8" />
                <TextBlock Classes="display" FontSize="64" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Text="{Binding FocusedTitle}" />
                <TextBlock Text="{Binding FocusedInfo}" FontSize="19" Opacity="0.85" />
                <TextBlock Text="{Binding FocusedDescription}" FontSize="17" Opacity="0.75" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" LineHeight="26" />
            </StackPanel>
        </Grid>

        <!-- Rows of covers -->
        <ScrollViewer x:Name="uiRowsScroll" Grid.Row="1" Height="420" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="uiRows" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="10">
                            <TextBlock Classes="rowTitle" Classes.current="{Binding IsCurrent}" Text="{Binding Title}" Margin="72,0,0,0" />
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Tiles}" Margin="72,18,72,26">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="26" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Panel Classes="tile" Classes.focused="{Binding IsFocused}" Width="196" Height="294" Background="Transparent"
                                                   PointerPressed="Tile_PointerPressed" Cursor="Hand">
                                                <Border Classes="ring" CornerRadius="14" Margin="-5" BorderThickness="4"
                                                        BorderBrush="{Binding #tileCover.AccentColor, Converter={StaticResource accentBrushConv}}"
                                                        BoxShadow="{Binding #tileCover.AccentColor, Converter={StaticResource accentShadowConv}, ConverterParameter='18 50 -6 0.85'}" />
                                                <Border Classes="cover" CornerRadius="11" ClipToBounds="True" Background="{DynamicResource Brush.Surface}">
                                                    <local:CacheImage x:Name="tileCover" ImageCacheType="GameCover" ComputeAccent="True" Stretch="UniformToFill" Data="{Binding Game}" />
                                                </Border>
                                                <Border CornerRadius="8" Background="{DynamicResource Brush.Glass}" Padding="8,4" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        IsVisible="{Binding IsInstalled}">
                                                    <TextBlock Text="{l:T 'INSTALLED'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Success}" />
                                                </Border>
                                            </Panel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- What the buttons do -->
        <Border Grid.Row="2" Padding="72,18,72,30">
            <StackPanel Orientation="Horizontal">
                <Border Classes="glyph" Background="#FF2E9E4F"><TextBlock Text="A" /></Border>
                <TextBlock Classes="hint" Text="{Binding ConfirmHint}" />
                <Border Classes="glyph" Background="#FF2F6FD6"><TextBlock Text="X" /></Border>
                <TextBlock Classes="hint" Text="{l:T 'Game page'}" />
                <Border Classes="glyph" Background="#FFC7383B"><TextBlock Text="B" /></Border>
                <TextBlock Classes="hint" Text="{l:T 'Leave the living room mode'}" />
                <Border Classes="glyph" Width="44" CornerRadius="8" Background="{DynamicResource Brush.Surface3}"><TextBlock Text="LB RB" FontSize="11" /></Border>
                <TextBlock Classes="hint" Text="{l:T 'Rows of games'}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

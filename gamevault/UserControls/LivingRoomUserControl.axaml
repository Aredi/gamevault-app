<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:gamevault.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:gamevault.Converter"
             xmlns:local="clr-namespace:gamevault.UserControls"
             x:Class="gamevault.UserControls.LivingRoomUserControl"
             Focusable="True" Background="{DynamicResource Brush.Background}">
    <UserControl.Resources>
        <conv:BlurWhenConverter x:Key="blurWhenConv" />
        <conv:AccentShadowConverter x:Key="accentShadowConv" />
        <conv:AccentBrushConverter x:Key="accentBrushConv" />
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- Tiles: the focused one grows and glows in its game's color -->
        <Style Selector="Panel.tile">
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel.tile.focused">
            <Setter Property="RenderTransform" Value="scale(1.1)" />
        </Style>
        <Style Selector="Panel.tile Border.ring">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel.tile.focused Border.ring">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Panel.tile Border.cover">
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel.tile.focused Border.cover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TextBlock.rowTitle">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="TextBlock.rowTitle.current">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.glyph">
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.glyph.wide">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style Selector="StackPanel.hintItem">
            <Setter Property="Margin" Value="0,4,36,4" />
        </Style>
        <Style Selector="Border.glyph TextBlock">
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- The focused game across the whole screen (never scaled: it always fills the screen) -->
        <Panel>
            <local:CacheImage x:Name="uiArt" ImageCacheType="GameBackground" FallbackToCover="True" Stretch="UniformToFill" Data="{Binding FocusedGame}"
                              Effect="{Binding #uiArt.IsShowingFallback, Converter={StaticResource blurWhenConv}, ConverterParameter=50}" />
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="{DynamicResource GameVault.Colors.Background}" Offset="0" />
                        <GradientStop Color="{DynamicResource GameVault.Colors.BackgroundSoft}" Offset="0.45" />
                        <GradientStop Color="{DynamicResource GameVault.Colors.BackgroundClear}" Offset="0.85" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
                        <GradientStop Color="{DynamicResource GameVault.Colors.Background}" Offset="0" />
                        <GradientStop Color="{DynamicResource GameVault.Colors.BackgroundStrong}" Offset="0.45" />
                        <GradientStop Color="{DynamicResource GameVault.Colors.BackgroundClear}" Offset="0.8" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Panel>

        <!-- Laid out for 1920 x 1080 and scaled to the screen, like a console: the same composition on every TV -->
        <LayoutTransformControl x:Name="uiScale" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid x:Name="uiCanvas" RowDefinitions="Auto,*,Auto,Auto" ClipToBounds="True">
                <!-- Name and clock -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="72,40,72,0">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Image Source="/Resources/Images/icon.png" Width="40" Height="40" />
                        <TextBlock Text="SanctuaryVault" FontFamily="{StaticResource Font.Display}" FontWeight="ExtraBold" FontSize="22" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                        <Path IsVisible="{Binding GamepadConnected}" Data="M7 8h2v2h2v2H9v2H7v-2H5v-2h2zm10.5 1a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3M15 11.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3M7 4h10a6 6 0 0 1 6 6v4a5 5 0 0 1-9 3h-4a5 5 0 0 1-9-3v-4a6 6 0 0 1 6-6"
                              Fill="{DynamicResource Brush.Success}" Stretch="Uniform" Width="28" Height="20" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Clock}" FontFamily="{StaticResource Font.Display}" FontWeight="Bold" FontSize="24" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- The focused game: bottom aligned, clipped rather than over the header -->
                <Panel Grid.Row="1" ClipToBounds="True" Margin="72,0,72,0">
                    <StackPanel VerticalAlignment="Bottom" MaxWidth="980" HorizontalAlignment="Left" Spacing="10" Margin="0,0,0,18">
                        <TextBlock Text="{Binding FocusedEyebrow}" FontSize="15" FontWeight="Bold" LetterSpacing="2" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="display" FontSize="58" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" LineHeight="64" Text="{Binding FocusedTitle}" />
                        <TextBlock Text="{Binding FocusedInfo}" FontSize="19" Opacity="0.85" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding FocusedDescription}" FontSize="17" Opacity="0.75" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" LineHeight="25" />
                    </StackPanel>
                </Panel>

                <!-- Rows of covers: the current row and the title of the next one -->
                <ScrollViewer x:Name="uiRowsScroll" Grid.Row="2" Height="452" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="uiRows" ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Classes="rowTitle" Classes.current="{Binding IsCurrent}" Text="{Binding Title}" Margin="72,6,72,0" TextTrimming="CharacterEllipsis" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Tiles}" Margin="72,26,72,34">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="28" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Panel Classes="tile" Classes.focused="{Binding IsFocused}" Width="196" Height="294" Background="Transparent"
                                                           PointerPressed="Tile_PointerPressed" Cursor="Hand">
                                                        <Border Classes="ring" CornerRadius="14" Margin="-5" BorderThickness="4"
                                                                BorderBrush="{Binding #tileCover.AccentColor, Converter={StaticResource accentBrushConv}}"
                                                                BoxShadow="{Binding #tileCover.AccentColor, Converter={StaticResource accentShadowConv}, ConverterParameter='18 50 -6 0.85'}" />
                                                        <Border Classes="cover" CornerRadius="11" ClipToBounds="True" Background="{DynamicResource Brush.Surface}">
                                                            <local:CacheImage x:Name="tileCover" ImageCacheType="GameCover" ComputeAccent="True" Stretch="UniformToFill" Data="{Binding Game}" />
                                                        </Border>
                                                        <Border CornerRadius="8" Background="{DynamicResource Brush.Glass}" Padding="8,4" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                IsVisible="{Binding IsInstalled}">
                                                            <TextBlock Text="{l:T 'INSTALLED'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Success}" />
                                                        </Border>
                                                    </Panel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- What the buttons do -->
                <WrapPanel Grid.Row="3" Margin="72,10,72,30">
                    <StackPanel Classes="hintItem" Orientation="Horizontal">
                        <Border Classes="glyph" Background="#FF2E9E4F"><TextBlock Text="A" /></Border>
                        <TextBlock Classes="hint" Text="{Binding ConfirmHint}" />
                    </StackPanel>
                    <StackPanel Classes="hintItem" Orientation="Horizontal">
                        <Border Classes="glyph" Background="#FF2F6FD6"><TextBlock Text="X" /></Border>
                        <TextBlock Classes="hint" Text="{l:T 'Game page'}" />
                    </StackPanel>
                    <StackPanel Classes="hintItem" Orientation="Horizontal">
                        <Border Classes="glyph" Background="#FFC7383B"><TextBlock Text="B" /></Border>
                        <TextBlock Classes="hint" Text="{l:T 'Leave the living room mode'}" />
                    </StackPanel>
                    <StackPanel Classes="hintItem" Orientation="Horizontal">
                        <Border Classes="glyph wide" Background="{DynamicResource Brush.Surface3}"><TextBlock Text="LB  RB" FontSize="12" /></Border>
                        <TextBlock Classes="hint" Text="{l:T 'Rows of games'}" />
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </LayoutTransformControl>
    </Panel>
</UserControl>

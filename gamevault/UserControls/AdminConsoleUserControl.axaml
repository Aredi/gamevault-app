<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:gamevault.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:gamevault.UserControls"
             xmlns:vm="clr-namespace:gamevault.ViewModels"
             x:Class="gamevault.UserControls.AdminConsoleUserControl"
             Focusable="True">
    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Border.userRow">
            <Setter Property="Padding" Value="4,8" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- The counters: each opens its part of the console -->
        <Style Selector="ToggleButton.tile">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Bg" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="14" Padding="16,12">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.tile:pointerover /template/ Border#PART_Bg">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
        </Style>
        <Style Selector="ToggleButton.tile:checked /template/ Border#PART_Bg">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Accent4}" />
        </Style>
        <Style Selector="TextBlock.tileValue">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Border.userRow.deleted">
            <Setter Property="Background" Value="#26FF0000" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" MaxWidth="1200" Margin="28,20,28,14" Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                    <TextBlock Classes="pageTitle" Text="{l:T 'Admin Console'}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="muted" Text="{Binding ServerVersionInfo.Key}" FontSize="14" VerticalAlignment="Center" />
                        <Button Classes="link" Content="{l:T '(Update Available)'}" Foreground="{DynamicResource Brush.Danger}" FontSize="14" VerticalAlignment="Center" Click="ServerUpdate_Navigate"
                                IsVisible="{Binding ServerVersionInfo.Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Column="1" x:Name="uiBtnReload" Classes="hover" Background="Transparent" Cursor="Hand" VerticalAlignment="Center" Width="28" Height="28"
                      ToolTip.Tip="{l:T 'Refresh admin console (F5)'}">
                    <Path Data="{StaticResource IconReload}" Fill="{DynamicResource Brush.Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>
            <WrapPanel ItemSpacing="10" LineSpacing="10">
                            <local:IconButton Text="{l:T 'Publish a Game'}" Icon="{StaticResource IconAddSimple}" IconMargin="0,0,5,0" Height="38" Padding="10,0" Click="PublishGame_Click" />
                            <local:IconButton Kind="Skeleton" BorderThickness="1" Text="{l:T 'Backup / Restore Database'}" Icon="{StaticResource IconDatabase}" IconMargin="0,0,5,0" Height="38" Padding="10,0" Click="BackupRestore_Click" />
                            <local:IconButton Kind="Skeleton" BorderThickness="1" Text="{l:T 'Automatic mapping'}" Icon="{StaticResource IconTick}" IconMargin="0,0,5,0" Height="38" Padding="10,0" Click="AutoMatch_Click"
                                              ToolTip.Tip="{l:T 'Map the games without metadata from their file name'}" />
                            <local:IconButton Kind="Skeleton" BorderThickness="1" Text="{l:T 'Reindex Games'}" Icon="{StaticResource IconReload}" IconMargin="0,0,5,0" Height="38" Padding="10,0" Click="Reindex_Click" />
            </WrapPanel>
            <UniformGrid Rows="1" Margin="0,0,-10,0">
                <ToggleButton x:Name="uiTilePlayers" Classes="tile" Tag="{x:Static vm:AdminConsoleSection.Players}" Click="Section_Click" IsChecked="True">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="muted" Text="{l:T 'Users'}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="uiCountPlayers" Classes="tileValue" Text="–" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="uiTileReports" Classes="tile" Tag="{x:Static vm:AdminConsoleSection.Reports}" Click="Section_Click" IsVisible="{Binding #uiReportsCard.IsVisible}">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="muted" Text="{l:T 'Open reports'}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="uiCountReports" Classes="tileValue" Text="–" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="uiTileInvites" Classes="tile" Tag="{x:Static vm:AdminConsoleSection.Invites}" Click="Section_Click" IsVisible="{Binding #uiInvitesCard.IsVisible}">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="muted" Text="{l:T 'Pending invitations'}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="uiCountInvites" Classes="tileValue" Text="–" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="uiTileServer" Classes="tile" Tag="{x:Static vm:AdminConsoleSection.Server}" Click="Section_Click">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="muted" Text="{l:T 'Server'}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="uiCountServer" Classes="tileValue" Text="–" />
                    </StackPanel>
                </ToggleButton>
            </UniformGrid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1200" Margin="28,0,28,28">
                <!-- Users -->
                <Panel x:Name="uiSectionPlayers">
                <Border Classes="card">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                            <TextBlock Classes="cardTitle" Text="{l:T 'Users'}" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1" Content="{l:T 'Show deleted Users'}" IsChecked="{Binding ShowDeletedUsers}" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="round small" VerticalAlignment="Center" Click="RegistrateUser_Click" ToolTip.Tip="{l:T 'Registrate new User'}">
                                <Path Data="{StaticResource IconAddSimple}" />
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,150,70,84" ColumnSpacing="14" Margin="4,12,4,6">
                            <TextBlock Classes="muted" Text="{l:T 'Users'}" FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Classes="muted" Text="{l:T 'Role'}" FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Classes="muted" Text="{l:T 'Activated'}" FontSize="12.5" FontWeight="SemiBold" />
                        </Grid>
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Users}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="userRow"
                                            Classes.deleted="{Binding DeletedAt, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Border.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                <Binding Path="$parent[UserControl].DataContext.ShowDeletedUsers" />
                                                <Binding Path="DeletedAt" Converter="{x:Static ObjectConverters.IsNull}" />
                                            </MultiBinding>
                                        </Border.IsVisible>
                                        <Grid ColumnDefinitions="*,150,70,84" ColumnSpacing="14">
                                            <Button Classes="wrapper" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand" Click="ShowUser_Click">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                    <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True" Background="{DynamicResource Brush.Surface3}">
                                                        <local:CacheImage ImageCacheType="UserAvatar" Data="{Binding}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Username}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Classes="muted" FontSize="12.5" Text="{Binding LastSeenText}" TextTrimming="CharacterEllipsis"
                                                                   IsVisible="{Binding LastSeenText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        <TextBlock Classes="muted" FontSize="12.5" Text="{Binding InviteText}" TextTrimming="CharacterEllipsis"
                                                                   IsVisible="{Binding InviteText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                            <ComboBox Grid.Column="1" Width="150" VerticalAlignment="Center"
                                                      ItemsSource="{Binding $parent[UserControl].DataContext.PermissionRoleEnumTypes}"
                                                      SelectedItem="{Binding Role}" SelectionChanged="PermissionRole_SelectionChanged" />
                                            <ToggleSwitch Grid.Column="2" IsChecked="{Binding Activated}" VerticalAlignment="Center" MinWidth="0" Click="Activated_Toggled" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Button Classes="round small" Click="EditUser_Clicked" ToolTip.Tip="{l:T 'Edit user'}">
                                                    <Path Data="{StaticResource IconInstalledGamesSettings}" />
                                                </Button>
                                                <Button Classes="round small" Click="DeleteUser_Clicked">
                                                    <Grid>
                                                        <Path Data="{DynamicResource IconTrash}" Fill="{DynamicResource Brush.Danger}" ToolTip.Tip="{l:T 'Delete user'}"
                                                              IsVisible="{Binding DeletedAt, Converter={x:Static ObjectConverters.IsNull}}" />
                                                        <Path Data="{DynamicResource IconReload}" ToolTip.Tip="{l:T 'Recover user'}"
                                                              IsVisible="{Binding DeletedAt, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
                </Panel>

                <Panel x:Name="uiSectionReports" IsVisible="False">
                <!-- The problems the players reported on games (SanctuaryVault service) -->
                <Border x:Name="uiReportsCard" Classes="card" IsVisible="False">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="uiReportsTitle" Classes="cardTitle" />
                        <TextBlock x:Name="uiReportsEmpty" Classes="muted" FontSize="13" Text="{l:T 'No open report.'}" />
                        <ItemsControl x:Name="uiReports">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="14,10" Margin="0,0,0,8" Background="{DynamicResource Brush.Surface}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                            <StackPanel Spacing="3">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Byline}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="{Binding CategoryText}" FontSize="13" />
                                                <TextBlock Text="{Binding Details}" FontSize="13" TextWrapping="Wrap" IsVisible="{Binding HasDetails}" />
                                                <TextBlock Text="{Binding Context}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Classes="ghost small" Click="ReportOpenGame_Click" Content="{l:T 'Game page'}" />
                                                <Button Classes="ghost small" Click="ReportResolve_Click" Content="{l:T 'Resolved'}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                </Panel>

                <Panel x:Name="uiSectionInvites" IsVisible="False">
                <!-- Invitation codes: a new account is activated with one (SanctuaryVault service) -->
                <Border x:Name="uiInvitesCard" Classes="card" IsVisible="False">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="cardTitle" Text="{l:T 'Invitations'}" />
                        <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" Text="{l:T 'A new account waits for its activation until it gives a code. Each code is used once and never expires.'}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox x:Name="uiInviteName" Watermark="{l:T 'Who it is for (e.g. Cousin Lucas)'}" MaxLength="60" KeyDown="InviteName_KeyDown" />
                            <Button Grid.Column="1" Classes="action small" Click="CreateInvite_Click" Content="{l:T 'Create a code'}" />
                        </Grid>
                        <ItemsControl x:Name="uiInvites">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="14,10" Margin="0,0,0,8" Background="{DynamicResource Brush.Surface}">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="12" />
                                            </StackPanel>
                                            <SelectableTextBlock Grid.Column="1" Text="{Binding Code}" FontFamily="monospace" FontSize="15" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Classes="ghost small" Click="CopyInvite_Click" Content="{l:T 'Copy'}" />
                                                <Button Classes="ghost small" Click="DeleteInvite_Click" Content="{l:T 'Delete'}" IsVisible="{Binding IsUnused}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                </Panel>

                <StackPanel x:Name="uiSectionServer" IsVisible="False">
                <Border Classes="card">
                    <StackPanel Spacing="5">
                        <TextBlock Classes="cardTitle" Text="{l:T 'Server Information'}" />
                        <TextBlock Text="{Binding ServerVersionInfo.Key}" FontSize="15" />
                        <TextBlock Text="{Binding Source={x:Static vm:SettingsViewModel.Instance}, Path=ServerUrl, StringFormat={l:T 'Server Address: {0}'}}" FontSize="15" />
                    </StackPanel>
                </Border>
                <!-- The text shown to who downloads a game using a hypervisor (SanctuaryVault service) -->
                <Border x:Name="uiHypervisorCard" Classes="card" IsVisible="False">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="cardTitle" Text="{l:T 'Hypervisor'}" />
                        <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" Text="{l:T 'Shown once to who downloads a game marked on its page. Nothing is shown while the text is empty.'}" />
                        <TextBox x:Name="uiHypervisorText" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxLength="4000" />
                        <Button Classes="action small" HorizontalAlignment="Right" Click="SaveHypervisorText_Click" Content="{l:T 'Save'}" />
                    </StackPanel>
                </Border>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

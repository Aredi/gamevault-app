<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:gamevault.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="gamevault.UserControls.ReportDiagnosticPopup"
             Width="760" Focusable="True">
    <!-- What an administrator reads of a report's diagnostic -->
    <Border Background="{DynamicResource Brush.Background}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="18">
        <StackPanel Margin="28,22,28,26" Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="uiTitle" Classes="sectionTitle" FontSize="20" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="uiByline" Classes="muted" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="round small" Click="Close_Click" ToolTip.Tip="{l:T 'Close'}">
                    <Path Data="m11.25 4.75l-6.5 6.5m0-6.5l6.5 6.5" Stroke="{DynamicResource Brush.Foreground}" StrokeThickness="1.8" Fill="Transparent" Width="11" Height="11" Stretch="Uniform" />
                </Button>
            </Grid>
            <Border x:Name="uiHint" Background="{DynamicResource Brush.Surface}" CornerRadius="12" Padding="15,13" IsVisible="False">
                <StackPanel Spacing="3">
                    <TextBlock Classes="muted" FontSize="12.5" FontWeight="Bold" LetterSpacing="0.8" Text="{l:T 'LEAD'}" />
                    <TextBlock x:Name="uiHintTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="uiHintDetail" Classes="muted" FontSize="13.5" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <ItemsControl x:Name="uiFacts">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Brush.Surface}" CornerRadius="11" Padding="13,10" Margin="0,0,10,10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Key}" Classes="muted" FontSize="12.5" />
                                <TextBlock Text="{Binding Value}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel x:Name="uiLogPart" Spacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <TextBlock x:Name="uiLogName" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Classes="ghost small" Click="Copy_Click" Content="{l:T 'Copy'}" />
                    <Button Grid.Column="2" Classes="ghost small" Click="Download_Click" Content="{l:T 'Download'}" />
                </Grid>
                <Border Background="{DynamicResource Brush.Surface}" CornerRadius="11" Padding="12,10">
                    <ScrollViewer Height="190" HorizontalScrollBarVisibility="Disabled">
                        <SelectableTextBlock x:Name="uiLog" FontFamily="monospace" FontSize="12.5" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:gamevault.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:gamevault.UserControls"
             xmlns:vm="clr-namespace:gamevault.ViewModels"
             xmlns:helper="clr-namespace:gamevault.Helper"
             x:Class="gamevault.UserControls.ActivityUserControl"
             Focusable="True">
    <UserControl.Styles>
        <!-- A line of the activity: a card, lit under the pointer -->
        <Style Selector="Border.feed">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.feed:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
        </Style>
        <!-- A reaction: the emoji and how many, a pill -->
        <Style Selector="Button.react">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.react:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent4}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent3}" />
        </Style>
        <Style Selector="Button.react TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.react TextBlock.count">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
        </Style>
        <!-- The player's own reaction stands out -->
        <Style Selector="Button.react.mine">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent4}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        </Style>
        <Style Selector="Button.react.mine TextBlock.count">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        </Style>
        <!-- "Réagir": discreet until the pointer comes -->
        <Style Selector="Button.react.add">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="Border.feed:pointerover Button.react.add">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- The emojis offered, in a row -->
        <Style Selector="Button.pick">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.pick:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.2)" />
        </Style>
        <Style Selector="Button.pick:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
        </Style>
        <Style Selector="Button.pick.mine /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent4}" />
        </Style>
        <Style Selector="Button.pick.text">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Styles>
    <!-- What the players of the server played lately: a page of its own, under Community -->
    <ScrollViewer x:Name="uiScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="uiPage" Margin="40,24,40,40" HorizontalAlignment="Left" Spacing="4">
            <!-- The games the friends recommend to the player: put away with the cross -->
            <StackPanel x:Name="uiRecommendationsSection" IsVisible="False" Spacing="8" Margin="0,0,0,24">
                <TextBlock Classes="sectionTitle" Text="{l:T 'Recommended by your friends'}" />
                <ItemsControl x:Name="uiRecommendations">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="helper:SocialRecommendation">
                            <Border CornerRadius="10" Background="{DynamicResource Brush.Surface}" Padding="14,10">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Text}" />
                                        <TextBlock Text="{Binding Note}" Classes="muted" FontSize="13" TextWrapping="Wrap"
                                                   IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost small" Margin="12,0,6,0" VerticalAlignment="Center" Content="{l:T 'See the game'}" Click="Recommendation_Click" />
                                    <Button Grid.Column="2" Classes="round small" VerticalAlignment="Center" Click="Dismiss_Click" ToolTip.Tip="{l:T 'Put it away'}">
                                        <Path Data="{StaticResource IconClose}" Width="10" Height="10" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <ItemsControl x:Name="uiItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActivityFeedItem">
                        <Border Classes="feed">
                            <Grid ColumnDefinitions="*,Auto">
                                <Button Classes="wrapper" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Cursor="Hand" Click="Item_Click">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Width="44" Height="64" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource Brush.Surface3}">
                                            <Panel>
                                                <local:CacheImage ImageCacheType="GameCover" Stretch="UniformToFill" Data="{Binding Game}" DecodeWidthOverride="132"
                                                                  IsVisible="{Binding Game, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <Image Source="{Binding Retro.CoverImage}" Stretch="UniformToFill" IsVisible="{Binding Retro, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Text}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding When}" Classes="muted" FontSize="12" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <!-- The reactions: "🔥 2", their names in the tooltip; "Réagir" offers the emojis. Beside the game's name: the line stays one line high -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding Key, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <ItemsControl ItemsSource="{Binding Reactions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ReactionChip">
                                                <Button Classes="react" Classes.mine="{Binding Mine}" ToolTip.Tip="{Binding Names}" Click="Reaction_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding Emoji}" />
                                                        <TextBlock Classes="count" Text="{Binding Count}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Classes="react add" IsVisible="{Binding CanReact}" Click="AddReaction_Click" ToolTip.Tip="{l:T 'React'}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="☺" FontSize="15" />
                                            <TextBlock Classes="count" Text="{l:T 'React'}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="uiEmpty" IsVisible="False" Classes="muted" FontSize="13" Margin="0,20" Text="{l:T 'Nobody played lately'}" />
            <local:ProgressRing x:Name="uiLoading" IsActive="False" IsVisible="False" Width="32" Height="32" HorizontalAlignment="Left" Margin="10,20" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

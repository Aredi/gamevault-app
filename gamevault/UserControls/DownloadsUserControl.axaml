<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:gamevault.UserControls"
             x:Class="gamevault.UserControls.DownloadsUserControl">
    <Grid RowDefinitions="50,*">
        <Border Background="{DynamicResource Brush.Background2}" Grid.Row="0">
            <TextBlock Text="Downloads" FontSize="35" Margin="20,0,0,0" VerticalAlignment="Center" />
        </Border>
        <Button Classes="wrapper" Grid.Row="1" ToolTip.Tip="Delete all Downloads" HorizontalAlignment="Right" VerticalAlignment="Top" Width="30" Height="30" Margin="0,15,20,0" ZIndex="1" Click="DeleteAllDownloads_Click">
            <Grid Classes="hover" Background="Transparent">
                <Path Data="{StaticResource IconTrash}" Fill="IndianRed" RenderTransform="scale(1.3)" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Button>
        <TextBlock Grid.Row="1" Text="Downloads empty" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding DownloadedGames.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={StaticResource Zero}}" />
        <ScrollViewer Grid.Row="1" VerticalAlignment="Top" Margin="10,10,0,10" VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="*,*,*">
                <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Top">
                    <ItemsControl ItemsSource="{Binding DownloadedGames}" />
                </Viewbox>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

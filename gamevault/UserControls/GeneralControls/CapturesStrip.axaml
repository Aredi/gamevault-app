<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:gamevault.Localization"
             xmlns:local="clr-namespace:gamevault.UserControls"
             x:Class="gamevault.UserControls.CapturesStrip" IsVisible="False">
    <!-- "Your captures": the screenshots and videos taken in this game, the newest first -->
    <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="sectionTitle" Text="{l:T 'Your captures'}" VerticalAlignment="Center" />
            <TextBlock x:Name="uiCount" Classes="muted" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
        <ScrollViewer x:Name="uiScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="uiItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:CaptureItem">
                        <Button Classes="gameCard" Width="208" Click="Capture_Click" ToolTip.Tip="{Binding Name}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{l:T 'Show in its folder'}" Click="ShowFolder_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Spacing="6">
                                <Border Width="208" Height="117" CornerRadius="9" ClipToBounds="True" Background="{DynamicResource Brush.Surface}">
                                    <Panel>
                                        <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                                        <!-- A video, or a picture the client does not read (HDR): opened by the system -->
                                        <Border Width="40" Height="40" CornerRadius="20" Background="#99000000" IsVisible="{Binding IsVideo}">
                                            <Path Data="{StaticResource IconPlay}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="2,0,0,0" />
                                        </Border>
                                    </Panel>
                                </Border>
                                <TextBlock Classes="cardInfo" Text="{Binding When}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="gamevault.UserControls.CacheImage">
    <Border x:Name="uiBorder" ClipToBounds="True">
        <Panel x:Name="uiPanel">
            <Image x:Name="uiImg" Stretch="UniformToFill">
                <Image.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                    </Transitions>
                </Image.Transitions>
            </Image>
        </Panel>
    </Border>
</UserControl>

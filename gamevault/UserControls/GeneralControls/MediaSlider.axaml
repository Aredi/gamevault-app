<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:gamevault.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uc="clr-namespace:gamevault.UserControls"
             x:Class="gamevault.UserControls.MediaSlider"
             Focusable="True">
    <Grid x:Name="uiRoot">
        <!-- Transparent: the page shows the first screenshot until the player has loaded -->
        <Border Background="Transparent" Margin="0,0,30,0" CornerRadius="5,0,0,5" ClipToBounds="True">
            <Grid>
                <Button Classes="wrapper" VerticalAlignment="Center" HorizontalAlignment="Center" Width="35" Height="35" Margin="0,0,3,0" Click="ReloadMediaSlider_Click">
                    <Grid Classes="hover" Background="#02000000">
                        <Path Data="{StaticResource IconReload}" Fill="#7AFFFFFF" RenderTransform="scale(1.5)" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <NativeWebView x:Name="uiWebView" Background="Black" />
            </Grid>
        </Border>
        <Border HorizontalAlignment="Right" Width="30" Background="{DynamicResource Brush.Background}" Opacity="0.7" CornerRadius="0,5,5,0" />
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="30">
            <TextBlock x:Name="uiTxtMediaIndex" FontSize="12" Foreground="{DynamicResource Brush.Foreground}" HorizontalAlignment="Center" IsVisible="False" />
        </Border>
        <uc:ProgressRing x:Name="uiMediaCountLoadingRing" HorizontalAlignment="Right" VerticalAlignment="Top" Width="20" Height="20" Margin="0,5,5,0" />
        <Button Classes="wrapper" VerticalAlignment="Center" HorizontalAlignment="Right" Width="25" Height="25" Margin="0,0,3,30" Click="PrevMedia_Click">
            <Grid Classes="hover" Background="#02000000">
                <Path Data="{StaticResource IconArrowBordered}" Fill="{DynamicResource Brush.Foreground}" RenderTransform="rotate(-90deg)" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Button>
        <Button Classes="wrapper" VerticalAlignment="Center" HorizontalAlignment="Right" Width="25" Height="25" Margin="0,30,3,0" Click="NextMedia_Click">
            <Grid Classes="hover" Background="#02000000">
                <Path Data="{StaticResource IconArrowBordered}" Fill="{DynamicResource Brush.Foreground}" RenderTransform="rotate(90deg)" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Button>
        <Slider x:Name="uiVolumeSlider" Minimum="0" Maximum="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,35" Orientation="Vertical" Height="80" Width="30" ToolTip.Tip="{l:T 'Volume'}" />
        <Button Classes="wrapper" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="25" Height="25" Margin="0,0,3,2" Click="MediaSliderFullscreen_Click">
            <Grid Classes="hover" Background="#02000000">
                <Path Data="{StaticResource IconGameViewMaximize}" Fill="{DynamicResource Brush.Foreground}" RenderTransform="scale(1.5)" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Button>
    </Grid>
</UserControl>

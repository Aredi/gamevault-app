<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia"
             x:Class="gamevault.UserControls.NewsPopup"
             Height="800" Width="600" Focusable="True" Margin="0,30,0,0">
    <Border Background="{DynamicResource Brush.Background}" CornerRadius="5" Margin="0,10,0,10" BoxShadow="0 0 7 0 #80000000">
        <Grid>
            <Button Classes="wrapper" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,3,0" ZIndex="1" Click="OnClose">
                <Grid Classes="hover" Background="Transparent" Height="25" Width="23">
                    <Path Fill="{DynamicResource Brush.Foreground}" Stroke="{DynamicResource Brush.Foreground}" Data="{DynamicResource IconClose}" />
                </Grid>
            </Button>
            <TabControl Background="Transparent" ClipToBounds="True">
                <TabItem Header="GameVault News">
                    <md:MarkdownScrollViewer x:Name="uiGameVaultNews" />
                </TabItem>
                <TabItem Header="Server News">
                    <md:MarkdownScrollViewer x:Name="uiServerNews" />
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:gamevault.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:gamevault.Converter"
             xmlns:vm="clr-namespace:gamevault.ViewModels"
             xmlns:models="clr-namespace:gamevault.Models"
             xmlns:local="clr-namespace:gamevault.UserControls"
             x:Class="gamevault.UserControls.GameDownloadUserControl">
    <UserControl.Resources>
        <conv:GameSizeConverter x:Key="sizeConv" />
        <conv:EnumDescriptionConverter x:Key="enumDescConv" />
        <conv:GreaterThanConverter x:Key="greaterThanConv" />
        <conv:MappedTitleConverter x:Key="mappedTitleConv" />
        <conv:BoolToValueConverter x:Key="pauseTextConv" TrueValue="Resume" FalseValue="Pause" />
        <conv:BoolToValueConverter x:Key="pauseTipConv" TrueValue="Resume Download" FalseValue="Pause Download" />
        <conv:BoolToValueConverter x:Key="pauseIconConv" TrueValue="{StaticResource IconPlay}" FalseValue="{StaticResource IconPause}" />
        <conv:AccentBrushConverter x:Key="accentBrushConv" />
        <conv:GameTypeIconConverter x:Key="gameTypeIconConv" />
        <conv:BlurWhenConverter x:Key="blurWhenConv" />
        <x:Int32 x:Key="Two">2</x:Int32>
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- Steps: downloaded, extracted, installed -->
        <Style Selector="Border.step">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.step Path">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.step.done">
            <Setter Property="Background" Value="{Binding #uiCover.AccentColor, Converter={StaticResource accentBrushConv}}" />
            <Setter Property="BorderBrush" Value="{Binding #uiCover.AccentColor, Converter={StaticResource accentBrushConv}}" />
        </Style>
        <Style Selector="Border.step.done Path">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="TextBlock.stepLabel">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.stepLabel.done">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}" />
        </Style>
        <Style Selector="Border.stepLine">
            <Setter Property="Height" Value="2" />
            <Setter Property="Width" Value="26" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Brush.Line}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
        </Style>
        <Style Selector="ProgressBar.download">
            <Setter Property="MinHeight" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource Brush.Line}" />
        </Style>
        <Style Selector="TextBlock.info">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.help">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.path">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.path:pointerover">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="local|IconButton.card">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="16" ClipToBounds="True" Margin="0,0,0,14">
        <Panel>
            <!-- The game's artwork, faded behind the right part of the card -->
            <local:CacheImage x:Name="uiArt" ImageCacheType="GameBackground" FallbackToCover="True" Stretch="UniformToFill" Data="{Binding Game}" Opacity="0.28"
                              Height="{Binding #uiCardContent.Bounds.Height}" VerticalAlignment="Top"
                              Effect="{Binding #uiArt.IsShowingFallback, Converter={StaticResource blurWhenConv}, ConverterParameter=30}" />
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="{DynamicResource GameVault.Colors.Background2}" Offset="0.25" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid x:Name="uiCardContent" ColumnDefinitions="Auto,*,Auto" Margin="16">
                <Button Classes="wrapper" Width="92" Height="138" VerticalAlignment="Top" Click="GoToGame_Click" ToolTip.Tip="{l:T 'Go to Game'}">
                    <Border CornerRadius="10" ClipToBounds="True" Background="{DynamicResource Brush.Surface3}" BoxShadow="0 10 24 -10 #B3000000">
                        <local:CacheImage x:Name="uiCover" ImageCacheType="GameCover" ComputeAccent="True" Stretch="UniformToFill" Data="{Binding Game}" />
                    </Border>
                </Button>

                <StackPanel Grid.Column="1" Margin="20,2,16,0" Spacing="10" VerticalAlignment="Top">
                    <StackPanel Spacing="4">
                        <TextBlock FontFamily="{StaticResource Font.Display}" FontWeight="Bold" FontSize="19" TextTrimming="CharacterEllipsis">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource mappedTitleConv}">
                                    <Binding Path="Game" />
                                    <Binding Source="{x:Static vm:SettingsViewModel.Instance}" Path="ShowMappedTitle" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Data="{Binding Game.Type, Converter={StaticResource gameTypeIconConv}}" Fill="{DynamicResource Brush.Muted}" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" />
                            <TextBlock Classes="info" Text="{Binding State, Converter={x:Static l:LocConverter.Instance}}" ToolTip.Tip="{Binding State}" MaxWidth="460" />
                            <TextBlock Classes="info" Text="·" IsVisible="{Binding ShowDiskSize}" />
                            <TextBlock Classes="info" Text="{Binding TotalDataSize, Converter={StaticResource sizeConv}, StringFormat={l:T '{}{0} on disk'}}" IsVisible="{Binding ShowDiskSize}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Steps -->
                    <StackPanel Orientation="Horizontal" IsVisible="{Binding !#uiInstallOptions.IsVisible}">
                        <Border Classes="step" Classes.done="{Binding InstallationStepperProgress, Converter={StaticResource greaterThanConv}, ConverterParameter=-1}">
                            <Path Data="{StaticResource IconTick}" Fill="White" Stretch="Uniform" Width="9" Height="9" />
                        </Border>
                        <TextBlock Classes="stepLabel" Classes.done="{Binding InstallationStepperProgress, Converter={StaticResource greaterThanConv}, ConverterParameter=-1}"
                                   Text="{l:T 'Downloaded'}" Margin="7,0,0,0" />
                        <Border Classes="stepLine" />
                        <Border Classes="step" Classes.done="{Binding InstallationStepperProgress, Converter={StaticResource greaterThanConv}, ConverterParameter=0}">
                            <Path Data="{StaticResource IconTick}" Fill="White" Stretch="Uniform" Width="9" Height="9" />
                        </Border>
                        <TextBlock Classes="stepLabel" Classes.done="{Binding InstallationStepperProgress, Converter={StaticResource greaterThanConv}, ConverterParameter=0}"
                                   Text="{l:T 'Extracted'}" Margin="7,0,0,0" />
                        <Border Classes="stepLine" />
                        <Border Classes="step" Classes.done="{Binding InstallationStepperProgress, Converter={StaticResource greaterThanConv}, ConverterParameter=1}">
                            <Path Data="{StaticResource IconTick}" Fill="White" Stretch="Uniform" Width="9" Height="9" />
                        </Border>
                        <TextBlock Classes="stepLabel" Classes.done="{Binding InstallationStepperProgress, Converter={StaticResource greaterThanConv}, ConverterParameter=1}"
                                   Text="{l:T 'Installed'}" Margin="7,0,0,0" />
                    </StackPanel>

                    <!-- Download in progress -->
                    <StackPanel Spacing="6" IsVisible="{Binding DownloadUIVisibility}">
                        <ProgressBar Classes="download" Minimum="0" Maximum="100" Value="{Binding GameDownloadProgress}"
                                     Foreground="{Binding #uiCover.AccentColor, Converter={StaticResource accentBrushConv}}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="info" Text="{Binding DownloadInfo}" />
                            <TextBlock Grid.Column="1" Classes="info" FontWeight="Bold" Text="{Binding GameDownloadProgress, StringFormat='{}{0} %'}" Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>
                    <!-- Extraction in progress -->
                    <StackPanel Spacing="6" IsVisible="{Binding ExtractionUIVisibility}">
                        <ProgressBar Classes="download" Minimum="0" Maximum="100" Value="{Binding GameExtractionProgress}"
                                     Foreground="{Binding #uiCover.AccentColor, Converter={StaticResource accentBrushConv}}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="info" Text="{Binding ExtractionInfo}" />
                            <TextBlock Grid.Column="1" Classes="info" FontWeight="Bold" Text="{Binding GameExtractionProgress, StringFormat='{}{0} %'}" Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <!-- Installation options -->
                    <Border x:Name="uiInstallOptions" IsVisible="False" Background="{DynamicResource Brush.Background}" CornerRadius="12" Padding="16" Margin="0,4,0,0"
                            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Data="{Binding Game.Type, Converter={StaticResource gameTypeIconConv}}" Fill="{DynamicResource Brush.Foreground}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Game.Type, Converter={StaticResource enumDescConv}}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="round small" Width="30" Height="30" CornerRadius="8" Click="InitOverwriteGameType_Click" ToolTip.Tip="{l:T 'Overwrite game type'}">
                                    <Button.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="Game.Type" Converter="{x:Static ObjectConverters.NotEqual}" ConverterParameter="{x:Static models:GameType.UNDETECTABLE}" />
                                            <Binding ElementName="uiProgressRingInstall" Path="!IsActive" />
                                        </MultiBinding>
                                    </Button.IsVisible>
                                    <Path Data="{StaticResource IconGameSettingsEditDetails}" Width="13" Height="13" />
                                </Button>
                            </Grid>

                            <!-- Windows setup -->
                            <StackPanel Spacing="8" IsVisible="{Binding Game.Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:GameType.WINDOWS_SETUP}}">
                                <TextBlock Classes="help" FontWeight="SemiBold" Text="{l:T 'To install this game, please follow the steps below:'}" />
                                <TextBlock Classes="help" Text="{l:T '1. Pick the correct installer from the dropdown menu below.'}" />
                                <ComboBox x:Name="uiCbSetupExecutable" MinWidth="320" HorizontalAlignment="Left">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Key}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Classes="help" Text="{l:T '2. Hit the \&#x27;Install\&#x27; button to launch the games installer.'}" />
                                <TextBlock Classes="help" Text="{l:T '3. Go through the game\&#x27;s setup process.'}" />
                                <TextBlock Classes="help muted" Text="{l:T 'Make sure to select this folder as the installers destination:'}" />
                                <Border Classes="path" HorizontalAlignment="Left" ToolTip.Tip="{l:T 'Copy to clipboard'}" PointerReleased="CopyInstallPathToClipboard_Click">
                                    <TextBlock Text="{Binding InstallerInstallPath}" FontSize="12.5" FontFamily="Cascadia Mono, Consolas, monospace" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Button x:Name="uiBtnInstallSetup" Classes="action small" HorizontalAlignment="Right" Click="Install_Click"
                                        Background="{Binding #uiCover.AccentColor, Converter={StaticResource accentBrushConv}}"
                                        IsEnabled="{Binding #uiCbSetupExecutable.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" Content="{l:T 'Install'}" />
                            </StackPanel>
                            <!-- Portable -->
                            <StackPanel Spacing="8">
                                <StackPanel.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                        <Binding Path="Game.Type" Converter="{x:Static ObjectConverters.Equal}" ConverterParameter="{x:Static models:GameType.WINDOWS_PORTABLE}" />
                                        <Binding Path="Game.Type" Converter="{x:Static ObjectConverters.Equal}" ConverterParameter="{x:Static models:GameType.LINUX_PORTABLE}" />
                                    </MultiBinding>
                                </StackPanel.IsVisible>
                                <TextBlock Classes="help" Text="{l:T 'This is a Portable Game, so there\&#x27;s no need for any setup. Once you click \&#x27;Install\&#x27;, the files will be automatically moved to the installation folder.'}" />
                                <Button x:Name="uiBtnInstallPortable" Classes="action small" HorizontalAlignment="Right" Click="Install_Click" Content="{l:T 'Install'}"
                                        Background="{Binding #uiCover.AccentColor, Converter={StaticResource accentBrushConv}}" />
                            </StackPanel>
                            <!-- Undetectable -->
                            <StackPanel Spacing="8" IsVisible="{Binding Game.Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:GameType.UNDETECTABLE}}">
                                <TextBlock Classes="help" Text="{l:T 'Unable to detect game type. You can try forcing an installation procedure by selecting it from the options below.'}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="uiCbOverwriteGameType" ItemsSource="{Binding GameTypes}" SelectedValueBinding="{Binding Key}" MinWidth="240">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Value}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Classes="action small" Background="{DynamicResource Brush.Warning}" Foreground="{DynamicResource Brush.Background}" Click="ContinueOverwriteGameType_Click"
                                            IsEnabled="{Binding #uiCbOverwriteGameType.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" Content="{l:T 'Force Install'}" />
                                </StackPanel>
                                <TextBlock Classes="help muted" Text="{l:T 'Or alternatively install the game manually to this folder:'}" />
                                <Border Classes="path" HorizontalAlignment="Left" ToolTip.Tip="{l:T 'Copy to clipboard'}" PointerReleased="CopyInstallPathToClipboard_Click">
                                    <TextBlock Text="{Binding InstallPath}" FontSize="12.5" FontFamily="Cascadia Mono, Consolas, monospace" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </StackPanel>

                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Button Classes="ghost small" Click="InstallOptionCancel_Click" Content="{l:T 'Back'}" Background="{DynamicResource Brush.Surface3}" />
                                <CheckBox Grid.Column="1" Margin="14,0,0,0" Content="{l:T 'Create Shortcut'}" IsChecked="{Binding CreateShortcut, Mode=TwoWay}" VerticalAlignment="Center">
                                    <CheckBox.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="Game.Type" Converter="{x:Static ObjectConverters.NotEqual}" ConverterParameter="{x:Static models:GameType.UNDETECTABLE}" />
                                            <Binding ElementName="uiProgressRingInstall" Path="!IsActive" />
                                        </MultiBinding>
                                    </CheckBox.IsVisible>
                                </CheckBox>
                                <local:ProgressRing Grid.Column="2" x:Name="uiProgressRingInstall" IsActive="False" Width="22" Height="22" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Top" MinWidth="150">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                        <Button Classes="round small" Click="OpenDirectory_Click" ToolTip.Tip="{l:T 'Open Directory'}">
                            <Path Data="{StaticResource IconGameSettingsFolder}" Width="14" Height="14" />
                        </Button>
                        <Button Classes="round small" Click="DeleteFile_Click" ToolTip.Tip="{l:T 'Delete Download'}">
                            <Path Data="{StaticResource IconTrash}" Width="14" Height="14" Fill="IndianRed" />
                        </Button>
                    </StackPanel>

                    <!-- Downloading -->
                    <Button Classes="ghost small" HorizontalAlignment="Stretch" IsVisible="{Binding DownloadUIVisibility}" IsEnabled="{Binding IsDownloadResumed}" Click="PauseResume_Click"
                            ToolTip.Tip="{Binding IsDownloadPaused, Converter={StaticResource pauseTipConv}}" Background="{DynamicResource Brush.Surface3}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Data="{Binding IsDownloadPaused, Converter={StaticResource pauseIconConv}}" Width="12" Height="12" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding IsDownloadPaused, Converter={StaticResource pauseTextConv}}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost small" HorizontalAlignment="Stretch" IsVisible="{Binding DownloadUIVisibility}" Click="CancelDownload_Click" ToolTip.Tip="{l:T 'Cancel Download'}"
                            Content="{l:T 'Cancel'}" Background="{DynamicResource Brush.Surface3}" />
                    <!-- Failed -->
                    <Button Classes="action small" HorizontalAlignment="Stretch" IsVisible="{Binding DownloadFailedVisibility}" Click="RetryDownload_Click" ToolTip.Tip="{l:T 'Download Game'}"
                            Background="{Binding #uiCover.AccentColor, Converter={StaticResource accentBrushConv}}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Data="{StaticResource IconReload}" Width="12" Height="12" />
                            <TextBlock VerticalAlignment="Center" Text="{l:T 'Retry'}" />
                        </StackPanel>
                    </Button>
                    <!-- Waiting in the queue -->
                    <StackPanel Spacing="8" IsVisible="{Binding IsQueued}">
                        <Button Classes="action small" HorizontalAlignment="Stretch" Click="StartQueuedNow_Click" Content="{l:T 'Start now'}"
                                ToolTip.Tip="{l:T 'Start this download now, regardless of the queue and the schedule'}"
                                Background="{Binding #uiCover.AccentColor, Converter={StaticResource accentBrushConv}}" />
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Stretch">
                            <Button Classes="round small" Click="QueueUp_Click" ToolTip.Tip="{l:T 'Earlier in the queue'}">
                                <Path Data="{StaticResource IconChevronDown}" Width="12" Height="12" RenderTransform="rotate(180deg)" />
                            </Button>
                            <Button Classes="round small" Click="QueueDown_Click" ToolTip.Tip="{l:T 'Later in the queue'}">
                                <Path Data="{StaticResource IconChevronDown}" Width="12" Height="12" />
                            </Button>
                            <Button Classes="ghost small" Click="RemoveFromQueue_Click" ToolTip.Tip="{l:T 'Remove from the download queue'}" Content="{l:T 'Remove'}"
                                    Background="{DynamicResource Brush.Surface3}" />
                        </StackPanel>
                    </StackPanel>
                    <!-- Extraction -->
                    <local:IconButton x:Name="uiBtnExtract" Classes="card" IsVisible="{Binding ShowFileActions}" IsEnabled="False" Text="{l:T 'Extract'}" Icon="{StaticResource IconExtract}" IconScale="0.6" IconMargin="0,0,6,0"
                                      ToolTip.Tip="{l:T 'Extract Game'}" Click="Extract_Click" Kind="Skeleton" Background="{DynamicResource Brush.Surface3}" />
                    <Button Classes="ghost small" HorizontalAlignment="Stretch" IsVisible="{Binding ExtractionUIVisibility}" Click="CancelExtraction_Click" Content="{l:T 'Cancel'}"
                            Background="{DynamicResource Brush.Surface3}" />
                    <!-- Installation -->
                    <Button x:Name="uiBtnInstall" Classes="action small" HorizontalAlignment="Stretch" IsEnabled="False" Click="OpenInstallOptions_Click" ToolTip.Tip="{l:T 'Install Game'}"
                            Background="{Binding #uiCover.AccentColor, Converter={StaticResource accentBrushConv}}"
                            IsVisible="{Binding ShowInstallAction}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Data="{StaticResource IconArrowDown}" Width="12" Height="12" />
                            <TextBlock VerticalAlignment="Center" Text="{l:T 'Install'}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="action small" HorizontalAlignment="Stretch" Click="GoToGame_Click"
                            Background="{Binding #uiCover.AccentColor, Converter={StaticResource accentBrushConv}}"
                            IsVisible="{Binding InstallationStepperProgress, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={StaticResource Two}}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Data="{StaticResource IconPlay}" Width="12" Height="12" />
                            <TextBlock VerticalAlignment="Center" Text="{l:T 'Go to Game'}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Panel>
    </Border>
</UserControl>

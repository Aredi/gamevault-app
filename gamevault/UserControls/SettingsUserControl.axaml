<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:gamevault.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:gamevault.Converter"
             xmlns:local="clr-namespace:gamevault.UserControls"
             x:Class="gamevault.UserControls.SettingsUserControl">
    <UserControl.Resources>
        <conv:GameSizeConverter x:Key="sizeConv" />
        <conv:DownloadLimitConverter x:Key="downloadLimitConv" />
        <conv:StringToArrayConverter x:Key="stringToArrayConv" />
        <conv:ToolFlavorNameConverter x:Key="toolFlavorConv" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,22,0,6" />
        </Style>
        <Style Selector="StackPanel.section">
            <Setter Property="Margin" Value="0,15,0,0" />
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style Selector="Border.group">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <!-- Sections on the left, like the navigation bar -->
        <Style Selector="TabControl#uiTabControl">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="TabControl#uiTabControl > TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="230" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Bg" Background="{TemplateBinding Background}" CornerRadius="12" Padding="14,0" Height="44" Margin="0,2">
                        <ContentPresenter Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabControl#uiTabControl > TabItem:pointerover /template/ Border#PART_Bg">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
        </Style>
        <Style Selector="TabControl#uiTabControl > TabItem:selected /template/ Border#PART_Bg">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent3}" />
        </Style>
        <Style Selector="TabControl#uiTabControl > TabItem:selected, TabControl#uiTabControl > TabItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}" />
        </Style>
        <Style Selector="TabControl#uiTabControl > TabItem Path.tabIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{Binding $parent[TabItem].Foreground}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Rectangle.integrationBar">
            <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="Width" Value="2" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="28,20,28,14">
            <TextBlock Classes="pageTitle" Text="{l:T 'Settings'}" />
        </StackPanel>
        <TextBlock Grid.Row="1" Classes="muted" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Text="{Binding Version, StringFormat='SanctuaryVault {0}'}"
                   Margin="42,0,0,16" ZIndex="1" PointerPressed="DevMode_Click" />
        <TabControl Grid.Row="1" x:Name="uiTabControl" TabStripPlacement="Left" Margin="28,0,0,0" SelectionChanged="TabControl_SelectionChanged">
            <!-- 0: Application -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Path Classes="tabIcon" Data="{StaticResource IconNavSettings}" />
                        <TextBlock Text="{l:T 'Application'}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,0,28,40" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Classes="h1" Text="{l:T 'Language'}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                            <ComboBox ItemsSource="{Binding LanguageNames}" SelectedIndex="{Binding LanguageIndex}" Width="180" />
                            <TextBlock Text="{l:T 'Applies at the next start'}" VerticalAlignment="Center" Opacity="0.7" />
                        </StackPanel>
                        <TextBlock Classes="h1" Text="{l:T 'Startup'}" />
                        <ToggleSwitch x:Name="uiAutostartToggle" Content="{l:T 'Launch SanctuaryVault on Computer Startup'}" />
                        <ToggleSwitch Content="{l:T 'Minimize SanctuaryVault to System Tray on Startup'}" IsChecked="{Binding BackgroundStart}" />
                        <ToggleSwitch Content="{l:T 'Auto-Load Library from Server on Startup'}" IsChecked="{Binding LibStartup}" />
                        <ToggleSwitch Content="{l:T 'Notify me when new games are added to the server'}" IsChecked="{Binding NotifyNewGames}" />
                        <StackPanel Classes="section">
                            <TextBlock Classes="h1" Text="{l:T 'Theme'}" />
                            <TextBlock Text="{l:T 'Installed Themes'}" Margin="10,5,0,0" FontSize="14" />
                            <WrapPanel Orientation="Horizontal" Margin="10,10,0,0">
                                <ComboBox x:Name="uiCbTheme" ItemsSource="{Binding Themes}" Width="520" SelectionChanged="Themes_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="470" ToolTip.Tip="{Binding Description}">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Author, StringFormat={l:T 'Author: {0}'}}" FontSize="10" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Classes="wrapper" Height="25" Width="25" Margin="20,0,10,0" ToolTip.Tip="{l:T 'Reload Theme List'}" Click="ReloadThemeList_Click">
                                    <Grid Classes="hover" Background="Transparent">
                                        <Path Data="{StaticResource IconReload}" Fill="{DynamicResource Brush.Foreground}" RenderTransform="scale(1.51)" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <local:IconButton Text="{l:T 'Uninstall Theme'}" Kind="Danger" IsEnabled="{Binding IsCommunityThemeSelected}" FontSize="15" Icon="{StaticResource IconTrash}" IconMargin="0,0,5,2" MinWidth="175" Height="40" Margin="10,0,0,0" Click="UninstallTheme_Click" />
                                <local:IconButton Text="{l:T 'Open Theme Folder'}" FontSize="15" Icon="{StaticResource IconGameSettingsFolder}" IconMargin="0,0,5,2" MinWidth="175" Height="40" Margin="10,0,0,0" Click="OpenThemeFolder_Click" />
                            </WrapPanel>
                            <TextBlock Text="{l:T 'Community Themes'}" Margin="10,10,0,0" FontSize="14" />
                            <WrapPanel Orientation="Horizontal" Margin="10,5,0,0">
                                <Grid>
                                    <ComboBox x:Name="uiCBCommunityThemes" ItemsSource="{Binding CommunityThemes}" Width="520" DropDownOpened="CommunityThemes_DropDownOpened">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="470" ToolTip.Tip="{Binding Description}">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Author, StringFormat={l:T 'Author: {0}'}}" FontSize="10" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock IsHitTestVisible="False" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{l:T 'Click to Load'}"
                                               IsVisible="{Binding CommunityThemes, Converter={x:Static ObjectConverters.IsNull}}" />
                                </Grid>
                                <Button Classes="wrapper" Height="25" Width="25" Margin="20,0,10,0" ToolTip.Tip="{l:T 'Reload Theme List'}" Click="ReloadCommunityThemeList_Click">
                                    <Grid Classes="hover" Background="Transparent">
                                        <Path Data="{StaticResource IconReload}" Fill="{DynamicResource Brush.Foreground}" RenderTransform="scale(1.51)" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <local:IconButton Text="{l:T 'Install Theme'}" Height="40" FontSize="15" Icon="{StaticResource IconGameSettingsInstallation}" IconMargin="0,0,10,0" MinWidth="175" Margin="10,0,0,0" Click="InstallCommunityTheme_Click" />
                                <local:IconButton Text="{l:T 'Open Repository'}" Height="40" FontSize="15" Icon="{StaticResource IconGameSettingsGithub}" IconMargin="0,0,10,0" MinWidth="175" Margin="10,0,0,0" Click="OpenCommunityThemeRepository_Click" />
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel Classes="section">
                            <TextBlock Classes="h1" Text="{l:T 'Library'}" />
                            <ToggleSwitch Content="{l:T 'Retain Sorting and Filter preferences after restart'}" IsChecked="{Binding RetainLibarySortByAndOrderBy}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 1: Installation -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Path Classes="tabIcon" Data="{StaticResource IconArrowDown}" />
                        <TextBlock Text="{l:T 'Installation'}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,0,28,40" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Classes="h1" Text="{l:T 'Downloads'}" />
                        <Border Classes="group" Width="510">
                            <StackPanel>
                                <TextBlock Text="{l:T 'Download Bandwidth Limit (KB/s, 0 = unlimited)'}" FontWeight="Bold" />
                                <TextBox x:Name="uiDownloadLimit" Text="{Binding DownloadLimitUIValue}" Margin="0,10,0,5" MaxLength="8" UseFloatingWatermark="True"
                                         Watermark="{Binding DownloadLimitUIValue, Converter={StaticResource downloadLimitConv}}" TextChanged="DownloadLimit_InputValidation" KeyDown="DownloadLimit_KeyDown" />
                                <local:IconButton Text="{l:T 'Save'}" FontSize="15" Icon="{StaticResource IconGameSettingsSave}" IconMargin="0,0,5,2" MinWidth="80" Height="30" HorizontalAlignment="Left" Click="DownloadLimit_Save" />
                            </StackPanel>
                        </Border>
                        <Border Classes="group" Width="510">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{l:T 'Download queue'}" FontWeight="Bold" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{l:T 'Simultaneous downloads'}" VerticalAlignment="Center" MinWidth="200" />
                                    <ComboBox ItemsSource="{Binding MaxConcurrentDownloadsValues}" SelectedIndex="{Binding MaxConcurrentDownloadsIndex}" Width="130" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{l:T 'Connections per download'}" VerticalAlignment="Center" MinWidth="200" />
                                    <ComboBox ItemsSource="{Binding DownloadConnectionsValues}" SelectedIndex="{Binding DownloadConnectionsIndex}" Width="130"
                                              ToolTip.Tip="{l:T 'Big archives (from 64 MB) are downloaded in several parts at once. Faster over the internet; 1 is enough on a local network.'}" />
                                </StackPanel>
                                <ToggleSwitch Content="{l:T 'Only download during these hours'}" IsChecked="{Binding DownloadScheduleEnabled}" />
                                <StackPanel Orientation="Horizontal" Spacing="10" IsEnabled="{Binding DownloadScheduleEnabled}">
                                    <TextBlock Text="{l:T 'From'}" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding DownloadScheduleStart}" Width="80" Watermark="01:00" />
                                    <TextBlock Text="{l:T 'to'}" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding DownloadScheduleEnd}" Width="80" Watermark="07:00" />
                                </StackPanel>
                                <TextBlock Text="{l:T 'Further downloads wait in the queue. Outside of the hours, running downloads are paused and continue automatically (e.g. 22:00 to 06:00 for night downloads). &quot;Start now&quot; or resuming by hand ignores the queue.'}" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />
                            </StackPanel>
                        </Border>
                        <StackPanel Classes="section">
                            <TextBlock Classes="h1" Text="{l:T 'Extraction'}" />
                            <ToggleSwitch Content="{l:T 'Auto-Extract Downloaded Games'}" IsChecked="{Binding AutoExtract}" />
                            <Border Classes="group" Width="510">
                                <StackPanel>
                                    <TextBlock Text="{l:T 'Default extraction password'}" FontWeight="Bold" />
                                    <TextBlock Text="{l:T 'Set a password that will automatically be tried when extracting games.'}" TextWrapping="Wrap" FontSize="14" />
                                    <TextBox x:Name="uiPwExtraction" PasswordChar="●" Classes="revealPasswordButton" Watermark="{l:T 'Optional Password'}" Margin="0,5,0,0" />
                                    <local:IconButton Text="{l:T 'Save'}" FontSize="15" Icon="{StaticResource IconGameSettingsSave}" IconMargin="0,0,5,2" MinWidth="80" Height="30" Margin="0,5,0,0" HorizontalAlignment="Left" Click="ExtractionPasswordSave_Click" />
                                </StackPanel>
                            </Border>
                            <ToggleSwitch Content="{l:T 'Mount ISO instead of extracting (Must be unmounted manually)'}" IsChecked="{Binding MountIso}" />
                        </StackPanel>
                        <StackPanel Classes="section">
                            <TextBlock Classes="h1" Text="{l:T 'Installation'}" />
                            <ToggleSwitch Content="{l:T 'Auto-Install Portable Games'}" IsChecked="{Binding AutoInstallPortable}" />
                            <ToggleSwitch Content="{l:T 'Auto-Delete Install files of Portable Games on successful installation'}" IsChecked="{Binding AutoDeletePortableGameFiles}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2: User -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Path Classes="tabIcon" Data="{StaticResource IconUser}" />
                        <TextBlock Text="{l:T 'User'}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Margin="30,0,0,0">
                    <TextBlock Classes="h1" Text="{l:T 'User'}" />
                    <local:IconButton Text="{l:T 'Edit User'}" Icon="{StaticResource IconEditUser}" IconMargin="0,0,7,2" IconScale="0.9" HorizontalAlignment="Left" Height="30" Margin="10,10,0,0" MinWidth="215" FontSize="15" Click="EditUser_Click" />
                    <TextBlock Classes="h1" Text="{l:T 'Profile'}" Margin="0,10,0,0" />
                    <local:IconButton Text="{l:T 'Change Profile'}" Icon="{StaticResource IconChangeProfile}" IconMargin="0,0,5,2" HorizontalAlignment="Left" Height="30" Margin="10,10,0,0" MinWidth="215" FontSize="15" Click="ChangeUserProfile_Click" />
                    <local:IconButton Kind="Danger" Text="{l:T 'Logout from this Device'}" Icon="{StaticResource IconLogout}" IconMargin="0,0,5,2" HorizontalAlignment="Left" Height="30" Margin="10,10,0,0" MinWidth="215" FontSize="15" Click="Logout_Click" />
                    <local:IconButton Kind="Danger" Text="{l:T 'Logout from all Devices'}" Icon="{StaticResource IconLogout}" IconMargin="0,0,5,2" HorizontalAlignment="Left" Height="30" Margin="10,10,0,0" MinWidth="215" FontSize="15" Click="LogoutFromAllDevices_Click" />
                </StackPanel>
            </TabItem>

            <!-- 3: Data -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Path Classes="tabIcon" Data="{StaticResource IconGameSettingsFolder}" />
                        <TextBlock Text="{l:T 'Data'}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,0,28,40" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Classes="h1" Text="{l:T 'File System'}" />
                        <StackPanel Margin="10,10,0,0">
                            <TextBlock Text="{l:T 'Root Directories (A \&#x27;GameVault\&#x27; subfolder will be created)'}" Margin="0,2,0,2" FontSize="15" />
                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" Width="560" HorizontalAlignment="Left">
                                <ItemsControl ItemsSource="{Binding RootDirectories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBox IsReadOnly="True" Text="{Binding Uri}" Width="510" />
                                                <Button Classes="wrapper" Height="30" Width="30" Click="RemoveRootDirectory_Click" ToolTip.Tip="{l:T 'Remove'}">
                                                    <Grid Classes="hover" Background="Transparent">
                                                        <Path Data="m11.25 4.75l-6.5 6.5m0-6.5l6.5 6.5" Stroke="IndianRed" StrokeThickness="2" RenderTransform="scale(2)" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <local:IconButton Icon="{StaticResource IconAddTag}" Text="{l:T 'Add'}" FontSize="15" IconMargin="0,0,5,2" HorizontalAlignment="Left" MinWidth="100" Height="30" Margin="0,5,10,0" Click="AddRootDirectory_Click" />
                        </StackPanel>
                        <StackPanel Classes="section">
                            <TextBlock Classes="h1" Text="{l:T 'Cache Management'}" />
                            <StackPanel Margin="10,10,0,0" Orientation="Horizontal">
                                <local:IconButton Text="{l:T 'Clear image cache'}" FontSize="15" Icon="{StaticResource IconCleanup}" IconScale="0.08" IconMargin="-110,-100,-105,-100" MinWidth="185" Height="30" ToolTip.Tip="{l:T 'Clears the entire image cache'}" Click="ClearImageCache_Clicked" />
                                <TextBlock Text="{Binding ImageCacheSize, Converter={StaticResource sizeConv}, StringFormat='({0})'}" FontSize="20" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="10,10,0,0">
                                <local:IconButton Text="{l:T 'Clear offline cache'}" FontSize="15" Icon="{StaticResource IconCleanup}" IconScale="0.08" IconMargin="-110,-100,-105,-100" MinWidth="185" Height="30" Click="ClearOfflineCache_Clicked" ToolTip.Tip="{l:T 'Clears the entire offline cache'}" />
                                <TextBlock Text="{Binding OfflineCacheSize, Converter={StaticResource sizeConv}, StringFormat='({0})'}" FontSize="20" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Classes="group" HorizontalAlignment="Stretch">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Text="{l:T 'Ignored Executables'}" FontWeight="Bold" />
                                        <TextBox Text="{Binding IgnoreList, Converter={StaticResource stringToArrayConv}, ConverterParameter=','}" Watermark="{l:T 'Edit ignorelist (separate entries by comma)'}" Margin="0,5,10,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <local:IconButton Text="{l:T 'Reset'}" FontSize="15" Icon="{DynamicResource IconReload}" IconMargin="0,0,5,2" MinWidth="115" Height="33" Click="IgnoredExecutablesReset_Click" />
                                        <local:IconButton Text="{l:T 'Save'}" FontSize="15" Icon="{DynamicResource IconGameSettingsSave}" IconMargin="0,0,5,2" MinWidth="115" Height="33" Click="IgnoredExecutablesSave_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Free up disk space -->
                        <StackPanel Classes="section">
                            <Grid ColumnDefinitions="*,Auto" Width="900" HorizontalAlignment="Left">
                                <TextBlock Classes="h1" Text="{l:T 'Free up disk space'}" />
                                <local:IconButton Grid.Column="1" Text="{l:T 'Analyze'}" Icon="{StaticResource IconCleanup}" IconScale="0.06" IconMargin="-110,-100,-105,-100" FontSize="14" MinWidth="120" Height="32" Click="AnalyzeStorage_Click" IsEnabled="{Binding !IsStorageCleanupRunning}" />
                            </Grid>
                            <TextBlock Margin="10,0,0,0" FontSize="13" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" Opacity="0.8"
                                       Text="{l:T 'Finds archives of games that are already installed, downloads that were never installed and, on Linux, Wine prefixes of uninstalled games and Proton/Wine versions no game uses. Nothing is deleted without your confirmation.'}" />
                            <Border Classes="group" Width="900" HorizontalAlignment="Left" IsVisible="{Binding StorageCleanupSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <StackPanel Spacing="4">
                                    <ItemsControl ItemsSource="{Binding StorageCleanupItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Margin="5,0,10,0">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Candidate.Title}" FontWeight="Bold" />
                                                            <TextBlock Text="{Binding KindText}" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Candidate.Path}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="Bold" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding StorageCleanupSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <local:IconButton Grid.Column="1" Kind="Danger" Text="{l:T 'Delete selected'}" Icon="{DynamicResource IconTrash}" IconMargin="0,0,5,2" FontSize="14" MinWidth="160" Height="32" Click="CleanStorage_Click"
                                                          IsEnabled="{Binding !IsStorageCleanupRunning}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 4: Integrations -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Path Classes="tabIcon" Data="{StaticResource IconCollection}" />
                        <TextBlock Text="{l:T 'Integrations'}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="30,0,20,20" Spacing="20">
                        <TextBlock Classes="h1" Text="{l:T 'Integrations'}" />
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                            <Rectangle Classes="integrationBar" />
                            <StackPanel Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconGameSettingsSteam}" Fill="{DynamicResource Brush.Foreground}" VerticalAlignment="Center" />
                                    <Button Classes="link" Margin="5,0,0,0" Tag="https://gamevau.lt/docs/gamevault-plus/integrations/steam" Click="Hyperlink_RequestNavigate">
                                        <TextBlock Text="Steam" FontSize="20" FontWeight="Bold" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{l:T 'SanctuaryVault offers seamless integration with Steam through the Steam Sync Integration. When enabled, all your installed games are automatically synced to your Steam Library and appear as Non-Steam Games. Launching these games via Steam will route them through SanctuaryVault, ensuring all your custom launch options are preserved.'}" FontSize="15" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" />
                                <ToggleSwitch x:Name="uiSteamSync" Content="{l:T 'Sync (You have to restart the steam client to see the changes)'}" Margin="0,10,0,0" IsChecked="{Binding SyncSteamShortcuts}" />
                                <local:IconButton Text="{l:T 'Restore Backup'}" Kind="Danger" FontSize="15" Icon="{DynamicResource IconReload}" IconMargin="0,0,5,2" MinWidth="150" Height="30" HorizontalAlignment="Left" Margin="0,10,0,0" Click="RestoreSteamShortcutBackup_Click" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                            <Rectangle Classes="integrationBar" />
                            <StackPanel Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconGameSettingsDiscord}" Fill="{DynamicResource Brush.Foreground}" VerticalAlignment="Center" />
                                    <Button Classes="link" Margin="5,0,0,0" Tag="https://gamevau.lt/docs/gamevault-plus/integrations/discord" Click="Hyperlink_RequestNavigate">
                                        <TextBlock Text="Discord" FontSize="20" FontWeight="Bold" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{l:T 'When enabled, your currently played game will be synced with the Discord Presence. This means that all your discord friends can see what you are currently playing'}" FontSize="15" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" />
                                <ToggleSwitch Content="{l:T 'Sync'}" Margin="0,10,0,0" IsChecked="{Binding SyncDiscordPresence}" />
                                <TextBlock Text="{l:T 'Discord shows the game, its total play time and the time of the current session, with the cover when it comes from a public source (IGDB).'}"
                                           TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Opacity="0.8" Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                            <Rectangle Classes="integrationBar" />
                            <StackPanel Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCloudSave}" Fill="{DynamicResource Brush.Foreground}" VerticalAlignment="Center" RenderTransform="scale(0.9)" />
                                    <Button Classes="link" Margin="5,0,0,0" Tag="https://gamevau.lt/docs/gamevault-plus/cloud-saves" Click="Hyperlink_RequestNavigate">
                                        <TextBlock Text="{l:T 'Cloud Saves'}" FontSize="20" FontWeight="Bold" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{l:T 'Automatically backs up and restores your latest savefiles via your SanctuaryVault Server, ensuring seamless transitions between installations and devices.'}" FontSize="15" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" />
                                <TextBlock Text="{l:T 'Requires SanctuaryVault Server with savefiles feature enabled.'}" FontSize="12" FontStyle="Italic" />
                                <ToggleSwitch Margin="0,5,0,0" IsChecked="{Binding CloudSaves}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{l:T 'Custom Ludusavi Manifests'}" Margin="0,2,0,2" FontSize="15" VerticalAlignment="Center" />
                                    <CheckBox Content="{l:T 'Use Primary Manifest'}" IsChecked="{Binding UsePrimaryCloudSaveManifest}" Margin="15,0,0,0" ToolTip.Tip="{l:T 'Disable primary Ludusavi manifest to only use the custom ones'}" />
                                </StackPanel>
                                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" Width="560" HorizontalAlignment="Left">
                                    <ItemsControl ItemsSource="{Binding CustomCloudSaveManifests}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                    <TextBox Text="{Binding Uri}" Watermark="{l:T 'File path or URL'}" Width="510" />
                                                    <Button Classes="wrapper" Height="30" Width="30" Click="RemoveCustomCloudSaveManifest_Click">
                                                        <Grid Classes="hover" Background="Transparent">
                                                            <Path Data="m11.25 4.75l-6.5 6.5m0-6.5l6.5 6.5" Stroke="IndianRed" StrokeThickness="2" RenderTransform="scale(2)" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Spacing="10">
                                    <local:IconButton Icon="{StaticResource IconAddTag}" Text="{l:T 'Add'}" FontSize="15" IconMargin="0,0,5,2" MinWidth="100" Height="30" Click="AddCustomCloudSaveManifest_Click" />
                                    <local:IconButton Icon="{StaticResource IconGameSettingsSave}" Text="{l:T 'Save'}" FontSize="15" IconMargin="0,0,5,2" MinWidth="100" Height="30" Click="SaveCustomCloudSaveManifests_Click" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                            <Rectangle Classes="integrationBar" />
                            <StackPanel Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconGameSettingsPlaynite}" Fill="{DynamicResource Brush.Foreground}" VerticalAlignment="Center" />
                                    <TextBlock Text="{l:T 'Playnite'}" FontSize="20" FontWeight="Bold" Margin="5,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{l:T 'SanctuaryVault integrates seamlessly with Playnite (Windows) using our Playnite Library Extension'}" FontSize="15" />
                                <Button Classes="link" Tag="https://playnite.link/addons.html#GameVault_fab8be77-18ab-4e6c-ad3d-89097b492d74" Click="Hyperlink_RequestNavigate">
                                    <TextBlock Text="{l:T 'Download Playnite Extension'}" FontSize="15" TextDecorations="Underline" />
                                </Button>
                                <Button Classes="link" Tag="https://gamevau.lt/docs/gamevault-plus/integrations/playnite/" Click="Hyperlink_RequestNavigate">
                                    <TextBlock Text="{l:T 'Setup Guide'}" FontSize="15" TextDecorations="Underline" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 5: Linux compatibility layer -->
            <TabItem IsVisible="{Binding IsLinux}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Path Classes="tabIcon" Data="{StaticResource IconPlatformLinux}" />
                        <TextBlock Text="{l:T 'Linux'}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="30,0,20,20" Spacing="10">
                        <TextBlock Classes="h1" Text="{l:T 'Running Windows games'}" />
                        <TextBlock FontSize="15" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"
                                   Text="{l:T 'Windows games, installers and uninstallers are started through a compatibility layer. Native Linux games (Linux Portable) are started directly.'}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,5,0,0">
                            <TextBlock Text="{l:T 'Default tool'}" FontSize="15" VerticalAlignment="Center" MinWidth="200" />
                            <ComboBox x:Name="uiDefaultCompatibilityTool" ItemsSource="{Binding CompatibilityTools}" SelectedItem="{Binding DefaultCompatibilityTool}" Width="500">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel MaxWidth="480">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Margin="10,0,0,0" FontSize="13" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" Opacity="0.8"
                                   Text="{l:T 'Used by every game without a tool of its own. Like on the Steam Deck, each game can use another Proton or Wine version (Game Settings → Launch Options). Proton builds start through umu-run when it is installed, otherwise directly. Custom: your own command, with {exe} (the program) and {args} (the launch parameters).'}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,5,0,0" IsVisible="{Binding IsCustomRunner}">
                            <TextBlock Text="{l:T 'Custom command'}" FontSize="15" VerticalAlignment="Center" MinWidth="200" />
                            <TextBox Text="{Binding CustomRunnerCommand}" Watermark="{l:T 'gamemoderun wine {exe} {args}'}" Width="500" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,5,0,0">
                            <TextBlock Text="{l:T 'Shared Wine prefix'}" FontSize="15" VerticalAlignment="Center" MinWidth="200" />
                            <TextBox Text="{Binding WinePrefix}" Watermark="{Binding EffectiveWinePrefix}" Width="500" />
                            <local:IconButton Text="{l:T 'Browse'}" FontSize="14" MinWidth="90" Height="32" Click="BrowseWinePrefix_Click" />
                        </StackPanel>

                        <!-- Compatibility tool manager -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,15,0,0" MaxWidth="900" HorizontalAlignment="Left" Width="900">
                            <TextBlock Classes="h1" Text="{l:T 'Compatibility tools'}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <local:IconButton Text="{l:T 'Open folder'}" Icon="{DynamicResource IconGameSettingsFolder}" IconMargin="0,0,5,0" FontSize="14" Height="32" Padding="10,0" Click="OpenManagedToolsFolder_Click" />
                                <local:IconButton Text="{l:T 'Refresh'}" Icon="{StaticResource IconReload}" IconMargin="0,0,5,0" FontSize="14" Height="32" Padding="10,0" Click="RefreshCompatibilityTools_Click" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="10,0,0,0" FontSize="13" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" Opacity="0.8"
                                   Text="{l:T 'Proton and Wine builds found on this computer: downloaded by SanctuaryVault, installed for Steam (compatibilitytools.d, ProtonUp-Qt) or for Lutris.'}" />
                        <Border Classes="group" Width="900" HorizontalAlignment="Left" Margin="10,0,0,0">
                            <Panel>
                                <TextBlock Text="{l:T 'No Proton or Wine build found yet. Download one below.'}" Opacity="0.7" IsVisible="{Binding !InstalledCompatibilityBuilds.Count}" />
                                <ItemsControl x:Name="uiInstalledTools" ItemsSource="{Binding InstalledCompatibilityBuilds}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" />
                                                        <Border CornerRadius="4" Padding="5,0" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="White" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Source}" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Path}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <local:IconButton Text="{l:T 'Open'}" Kind="Skeleton" FontSize="13" Height="28" MinWidth="70" Tag="{Binding}" Click="OpenToolFolder_Click" />
                                                    <local:IconButton Text="{l:T 'Delete'}" Kind="Danger" FontSize="13" Height="28" MinWidth="80" Tag="{Binding}" Click="DeleteTool_Click" IsVisible="{Binding IsManaged}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Panel>
                        </Border>
                        <TextBlock Text="{l:T 'Download a version'}" FontSize="15" FontWeight="Bold" Margin="10,10,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,0,0,0" IsEnabled="{Binding !IsToolDownloadRunning}">
                            <ComboBox ItemsSource="{Binding ToolFlavors}" SelectedItem="{Binding SelectedToolFlavor}" Width="170">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource toolFlavorConv}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <local:IconButton Text="{l:T 'Load versions'}" FontSize="14" Height="32" MinWidth="130" Click="LoadToolVersions_Click" />
                            <ComboBox ItemsSource="{Binding AvailableToolDownloads}" SelectedItem="{Binding SelectedToolDownload}" Width="300" PlaceholderText="{l:T 'Load the versions first'}" />
                            <local:IconButton Text="{l:T 'Install'}" Icon="{DynamicResource IconDownload}" IconMargin="0,0,5,0" IconScale="0.8" FontSize="14" Height="32" MinWidth="110" Click="InstallTool_Click"
                                              IsEnabled="{Binding SelectedToolDownload, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                        <StackPanel Margin="10,0,0,0" Spacing="4" IsVisible="{Binding ToolDownloadStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Width="900" HorizontalAlignment="Left">
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding ToolDownloadProgress}" Height="6" IsVisible="{Binding IsToolDownloadRunning}" />
                            <TextBlock Text="{Binding ToolDownloadStatus}" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Margin="10,0,0,0" FontSize="13" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" Opacity="0.8"
                                   Text="{l:T 'GE-Proton comes from GloriousEggroll/proton-ge-custom, Wine and Wine Staging from Kron4ek/Wine-Builds (WoW64 builds, they also run 32-bit games). Downloads are checked against their published checksums.'}" />
                        <TextBlock Classes="h1" Text="{l:T 'Detected tools'}" Margin="0,15,0,0" />
                        <Border Classes="group" Width="760">
                            <SelectableTextBlock x:Name="uiDetectedTools" Text="{Binding DetectedCompatibilityTools}" FontFamily="monospace" FontSize="13" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Margin="10,0,0,0" FontSize="13" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" Opacity="0.8"
                                   Text="{l:T 'Saves of Windows games running in the prefix are included in cloud saves automatically. Steam shortcuts start the games through SanctuaryVault.'}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 6: About -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Path Classes="tabIcon" Data="{StaticResource IconInfo}" />
                        <TextBlock Text="{l:T 'About'}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Margin="30,0,0,0" HorizontalAlignment="Left" Spacing="20">
                    <TextBlock Classes="h1" Text="{l:T 'About'}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:T 'Application Version'}" FontSize="15" MinWidth="200" />
                        <TextBlock Text="{Binding Version}" FontSize="15" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:T 'This build'}" FontSize="15" MinWidth="200" />
                        <Button Classes="link" x:Name="uiForkLink" Click="Hyperlink_RequestNavigate">
                            <TextBlock x:Name="uiForkLinkText" FontSize="15" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:T 'Developed by Phalcode'}" FontSize="15" MinWidth="200" />
                        <Button Classes="link" Tag="https://phalco.de" Click="Hyperlink_RequestNavigate">
                            <TextBlock Text="https://phalco.de" FontSize="15" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:T 'License'}" FontSize="15" MinWidth="200" />
                        <Button Classes="link" Tag="https://gamevau.lt/license" Click="Hyperlink_RequestNavigate">
                            <TextBlock Text="{l:T 'CC BY-NC-SA 4.0 (https://gamevau.lt/license)'}" FontSize="15" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:T 'Legal Notice'}" FontSize="15" MinWidth="200" />
                        <Button Classes="link" Tag="https://phalco.de/legal" Click="Hyperlink_RequestNavigate">
                            <TextBlock Text="https://phalco.de/legal" FontSize="15" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:T 'Privacy Policy'}" FontSize="15" MinWidth="200" />
                        <Button Classes="link" Tag="https://phalco.de/privacy" Click="Hyperlink_RequestNavigate">
                            <TextBlock Text="https://phalco.de/privacy" FontSize="15" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:T 'Terms of Service'}" FontSize="15" MinWidth="200" />
                        <Button Classes="link" Tag="https://phalco.de/tos" Click="Hyperlink_RequestNavigate">
                            <TextBlock Text="https://phalco.de/tos" FontSize="15" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:T 'Metadata Providers:'}" FontSize="15" MinWidth="200" />
                        <TextBlock Text="IGDB" FontSize="15" />
                        <Button Classes="link" Margin="10,0,0,0" Tag="https://www.igdb.com" Click="Hyperlink_RequestNavigate">
                            <TextBlock Text="https://www.igdb.com" FontSize="15" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- 7: Developer -->
            <TabItem IsVisible="{Binding DevModeEnabled}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Path Classes="tabIcon" Data="{StaticResource IconFilterLines}" />
                        <TextBlock Text="{l:T 'Developer'}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Margin="30,0,0,0">
                    <TextBlock Classes="h1" Text="{l:T 'Developer Settings'}" />
                    <TextBlock Text="{l:T 'You may need to restart the client for the changes to take effect'}" Margin="0,5,0,0" />
                    <local:IconButton Text="{l:T 'Open User Cache Folder'}" Height="30" Icon="{StaticResource IconGameSettingsFolder}" FontSize="15" IconMargin="0,0,5,5" MinWidth="220" Margin="0,20,0,0" HorizontalAlignment="Left" Click="OpenUserCacheFolder_Click" />
                    <local:IconButton Text="{l:T 'Open Log File'}" Height="30" Icon="{StaticResource IconGameSettingsFolder}" FontSize="15" IconMargin="0,0,5,5" MinWidth="220" Margin="0,10,0,0" HorizontalAlignment="Left" Click="OpenLogFolder_Click" />
                </StackPanel>
            </TabItem>
        </TabControl>
        <local:CacheImage Grid.Row="1" x:Name="imgAwesome" UseUriSource="True" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="100" Width="150" Margin="0,0,40,0" IsHitTestVisible="False" />
    </Grid>
</UserControl>

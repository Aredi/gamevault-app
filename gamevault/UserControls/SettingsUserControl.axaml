<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:gamevault.Converter"
             xmlns:local="clr-namespace:gamevault.UserControls"
             x:Class="gamevault.UserControls.SettingsUserControl">
    <UserControl.Resources>
        <conv:GameSizeConverter x:Key="sizeConv" />
        <conv:DownloadLimitConverter x:Key="downloadLimitConv" />
        <conv:StringToArrayConverter x:Key="stringToArrayConv" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="StackPanel.section">
            <Setter Property="Margin" Value="0,15,0,0" />
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="Margin" Value="10,10,0,0" />
        </Style>
        <Style Selector="Border.group">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="10,10,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="TabControl#uiTabControl > TabItem">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="MinWidth" Value="140" />
        </Style>
        <Style Selector="Rectangle.integrationBar">
            <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="Width" Value="2" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="50,*">
        <Border Background="{DynamicResource Brush.Background2}" Grid.Row="0">
            <TextBlock Text="Settings" FontSize="35" Margin="20,0,0,0" VerticalAlignment="Center" />
        </Border>
        <TextBlock Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Text="{Binding Version, StringFormat='V {0}'}" Margin="20,0,0,5" ZIndex="1" PointerPressed="DevMode_Click" />
        <TabControl Grid.Row="1" x:Name="uiTabControl" TabStripPlacement="Left" Margin="10" SelectionChanged="TabControl_SelectionChanged">
            <!-- 0: Application -->
            <TabItem Header="Application">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="30,0,20,20">
                        <TextBlock Classes="h1" Text="Startup" />
                        <ToggleSwitch x:Name="uiAutostartToggle" Content="Launch GameVault on Computer Startup" />
                        <ToggleSwitch Content="Minimize GameVault to System Tray on Startup" IsChecked="{Binding BackgroundStart}" />
                        <ToggleSwitch Content="Auto-Load Library from Server on Startup" IsChecked="{Binding LibStartup}" />
                        <StackPanel Classes="section">
                            <TextBlock Classes="h1" Text="Theme" />
                            <TextBlock Text="Installed Themes" Margin="10,5,0,0" FontSize="14" />
                            <WrapPanel Orientation="Horizontal" Margin="10,10,0,0">
                                <ComboBox x:Name="uiCbTheme" ItemsSource="{Binding Themes}" Width="520" SelectionChanged="Themes_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="470" ToolTip.Tip="{Binding Description}">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Author, StringFormat='Author: {0}'}" FontSize="10" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Classes="wrapper" Height="25" Width="25" Margin="20,0,10,0" ToolTip.Tip="Reload Theme List" Click="ReloadThemeList_Click">
                                    <Grid Classes="hover" Background="Transparent">
                                        <Path Data="{StaticResource IconReload}" Fill="{DynamicResource Brush.Foreground}" RenderTransform="scale(1.51)" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <local:IconButton Text="Uninstall Theme" Kind="Danger" IsEnabled="{Binding IsCommunityThemeSelected}" FontSize="15" Icon="{StaticResource IconTrash}" IconMargin="0,0,5,2" Width="175" Height="40" Margin="10,0,0,0" Click="UninstallTheme_Click" />
                                <local:IconButton Text="Open Theme Folder" FontSize="15" Icon="{StaticResource IconGameSettingsFolder}" IconMargin="0,0,5,2" Width="175" Height="40" Margin="10,0,0,0" Click="OpenThemeFolder_Click" />
                            </WrapPanel>
                            <TextBlock Text="Community Themes" Margin="10,10,0,0" FontSize="14" />
                            <WrapPanel Orientation="Horizontal" Margin="10,5,0,0">
                                <Grid>
                                    <ComboBox x:Name="uiCBCommunityThemes" ItemsSource="{Binding CommunityThemes}" Width="520" DropDownOpened="CommunityThemes_DropDownOpened">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="470" ToolTip.Tip="{Binding Description}">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Author, StringFormat='Author: {0}'}" FontSize="10" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock IsHitTestVisible="False" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Click to Load"
                                               IsVisible="{Binding CommunityThemes, Converter={x:Static ObjectConverters.IsNull}}" />
                                </Grid>
                                <Button Classes="wrapper" Height="25" Width="25" Margin="20,0,10,0" ToolTip.Tip="Reload Theme List" Click="ReloadCommunityThemeList_Click">
                                    <Grid Classes="hover" Background="Transparent">
                                        <Path Data="{StaticResource IconReload}" Fill="{DynamicResource Brush.Foreground}" RenderTransform="scale(1.51)" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <local:IconButton Text="Install Theme" Height="40" FontSize="15" Icon="{StaticResource IconGameSettingsInstallation}" IconMargin="0,0,10,0" Width="175" Margin="10,0,0,0" Click="InstallCommunityTheme_Click" />
                                <local:IconButton Text="Open Repository" Height="40" FontSize="15" Icon="{StaticResource IconGameSettingsGithub}" IconMargin="0,0,10,0" Width="175" Margin="10,0,0,0" Click="OpenCommunityThemeRepository_Click" />
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel Classes="section">
                            <TextBlock Classes="h1" Text="Library" />
                            <ToggleSwitch Content="Retain Sorting and Filter preferences after restart" IsChecked="{Binding RetainLibarySortByAndOrderBy}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 1: Installation -->
            <TabItem Header="Installation">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="30,0,20,20">
                        <TextBlock Classes="h1" Text="Download" />
                        <Border Classes="group" Width="510">
                            <StackPanel>
                                <TextBlock Text="Download Bandwidth Limit (KB/s, 0 = unlimited)" FontWeight="Bold" />
                                <TextBox x:Name="uiDownloadLimit" Text="{Binding DownloadLimitUIValue}" Margin="0,10,0,5" MaxLength="8" UseFloatingWatermark="True"
                                         Watermark="{Binding DownloadLimitUIValue, Converter={StaticResource downloadLimitConv}}" TextChanged="DownloadLimit_InputValidation" KeyDown="DownloadLimit_KeyDown" />
                                <local:IconButton Text="Save" FontSize="15" Icon="{StaticResource IconGameSettingsSave}" IconMargin="0,0,5,2" Width="80" Height="30" HorizontalAlignment="Left" Click="DownloadLimit_Save" />
                            </StackPanel>
                        </Border>
                        <StackPanel Classes="section">
                            <TextBlock Classes="h1" Text="Extraction" />
                            <ToggleSwitch Content="Auto-Extract Downloaded Games" IsChecked="{Binding AutoExtract}" />
                            <Border Classes="group" Width="510">
                                <StackPanel>
                                    <TextBlock Text="Default extraction password" FontWeight="Bold" />
                                    <TextBlock Text="Set a password that will automatically be tried when extracting games." TextWrapping="Wrap" FontSize="14" />
                                    <TextBox x:Name="uiPwExtraction" PasswordChar="●" Classes="revealPasswordButton" Watermark="Optional Password" Margin="0,5,0,0" />
                                    <local:IconButton Text="Save" FontSize="15" Icon="{StaticResource IconGameSettingsSave}" IconMargin="0,0,5,2" Width="80" Height="30" Margin="0,5,0,0" HorizontalAlignment="Left" Click="ExtractionPasswordSave_Click" />
                                </StackPanel>
                            </Border>
                            <ToggleSwitch Content="Mount ISO instead of extracting (Must be unmounted manually)" IsChecked="{Binding MountIso}" />
                        </StackPanel>
                        <StackPanel Classes="section">
                            <TextBlock Classes="h1" Text="Installation" />
                            <ToggleSwitch Content="Auto-Install Portable Games" IsChecked="{Binding AutoInstallPortable}" />
                            <ToggleSwitch Content="Auto-Delete Install files of Portable Games on successful installation" IsChecked="{Binding AutoDeletePortableGameFiles}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2: User -->
            <TabItem Header="User">
                <StackPanel Margin="30,0,0,0">
                    <TextBlock Classes="h1" Text="User" />
                    <local:IconButton Text="Edit User" Icon="{StaticResource IconEditUser}" IconMargin="0,0,7,2" IconScale="0.9" HorizontalAlignment="Left" Height="30" Margin="10,10,0,0" Width="215" FontSize="15" Click="EditUser_Click" />
                    <TextBlock Classes="h1" Text="Profile" Margin="0,10,0,0" />
                    <local:IconButton Text="Change Profile" Icon="{StaticResource IconChangeProfile}" IconMargin="0,0,5,2" HorizontalAlignment="Left" Height="30" Margin="10,10,0,0" Width="215" FontSize="15" Click="ChangeUserProfile_Click" />
                    <local:IconButton Kind="Danger" Text="Logout from this Device" Icon="{StaticResource IconLogout}" IconMargin="0,0,5,2" HorizontalAlignment="Left" Height="30" Margin="10,10,0,0" Width="215" FontSize="15" Click="Logout_Click" />
                    <local:IconButton Kind="Danger" Text="Logout from all Devices" Icon="{StaticResource IconLogout}" IconMargin="0,0,5,2" HorizontalAlignment="Left" Height="30" Margin="10,10,0,0" Width="215" FontSize="15" Click="LogoutFromAllDevices_Click" />
                </StackPanel>
            </TabItem>

            <!-- 3: Data -->
            <TabItem Header="Data">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="30,0,20,20">
                        <TextBlock Classes="h1" Text="File System" />
                        <StackPanel Margin="10,10,0,0">
                            <TextBlock Text="Root Directories (A 'GameVault' subfolder will be created)" Margin="0,2,0,2" FontSize="15" />
                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" Width="560" HorizontalAlignment="Left">
                                <ItemsControl ItemsSource="{Binding RootDirectories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBox IsReadOnly="True" Text="{Binding Uri}" Width="510" />
                                                <Button Classes="wrapper" Height="30" Width="30" Click="RemoveRootDirectory_Click" ToolTip.Tip="Remove">
                                                    <Grid Classes="hover" Background="Transparent">
                                                        <Path Data="m11.25 4.75l-6.5 6.5m0-6.5l6.5 6.5" Stroke="IndianRed" StrokeThickness="2" RenderTransform="scale(2)" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <local:IconButton Icon="{StaticResource IconAddTag}" Text="Add" FontSize="15" IconMargin="0,0,5,2" HorizontalAlignment="Left" Width="100" Height="30" Margin="0,5,10,0" Click="AddRootDirectory_Click" />
                        </StackPanel>
                        <StackPanel Classes="section">
                            <TextBlock Classes="h1" Text="Cache Management" />
                            <StackPanel Margin="10,10,0,0" Orientation="Horizontal">
                                <local:IconButton Text="Clear image cache" FontSize="15" Icon="{StaticResource IconCleanup}" IconScale="0.08" IconMargin="-110,-100,-105,-100" Width="185" Height="30" ToolTip.Tip="Clears the entire image cache" Click="ClearImageCache_Clicked" />
                                <TextBlock Text="{Binding ImageCacheSize, Converter={StaticResource sizeConv}, StringFormat='({0})'}" FontSize="20" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="10,10,0,0">
                                <local:IconButton Text="Clear offline cache" FontSize="15" Icon="{StaticResource IconCleanup}" IconScale="0.08" IconMargin="-110,-100,-105,-100" Width="185" Height="30" Click="ClearOfflineCache_Clicked" ToolTip.Tip="Clears the entire offline cache" />
                                <TextBlock Text="{Binding OfflineCacheSize, Converter={StaticResource sizeConv}, StringFormat='({0})'}" FontSize="20" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Classes="group" HorizontalAlignment="Stretch">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Text="Ignored Executables" FontWeight="Bold" />
                                        <TextBox Text="{Binding IgnoreList, Converter={StaticResource stringToArrayConv}, ConverterParameter=','}" Watermark="Edit ignorelist (separate entries by comma)" Margin="0,5,10,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <local:IconButton Text="Reset" FontSize="15" Icon="{DynamicResource IconReload}" IconMargin="0,0,5,2" Width="115" Height="33" Click="IgnoredExecutablesReset_Click" />
                                        <local:IconButton Text="Save" FontSize="15" Icon="{DynamicResource IconGameSettingsSave}" IconMargin="0,0,5,2" Width="115" Height="33" Click="IgnoredExecutablesSave_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 4: Integrations -->
            <TabItem Header="Integrations">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="30,0,20,20" Spacing="20">
                        <TextBlock Classes="h1" Text="Integrations" />
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                            <Rectangle Classes="integrationBar" />
                            <StackPanel Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconGameSettingsSteam}" Fill="{DynamicResource Brush.Foreground}" VerticalAlignment="Center" />
                                    <Button Classes="link" Margin="5,0,0,0" Tag="https://gamevau.lt/docs/gamevault-plus/integrations/steam" Click="Hyperlink_RequestNavigate">
                                        <TextBlock Text="Steam" FontSize="20" FontWeight="Bold" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="GameVault offers seamless integration with Steam through the Steam Sync Integration. When enabled, all your installed games are automatically synced to your Steam Library and appear as Non-Steam Games. Launching these games via Steam will route them through GameVault, ensuring all your custom launch options are preserved." FontSize="15" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" />
                                <ToggleSwitch x:Name="uiSteamSync" Content="Sync (You have to restart the steam client to see the changes)" Margin="0,10,0,0" IsChecked="{Binding SyncSteamShortcuts}" />
                                <local:IconButton Text="Restore Backup" Kind="Danger" FontSize="15" Icon="{DynamicResource IconReload}" IconMargin="0,0,5,2" Width="150" Height="30" HorizontalAlignment="Left" Margin="0,10,0,0" Click="RestoreSteamShortcutBackup_Click" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                            <Rectangle Classes="integrationBar" />
                            <StackPanel Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconGameSettingsDiscord}" Fill="{DynamicResource Brush.Foreground}" VerticalAlignment="Center" />
                                    <Button Classes="link" Margin="5,0,0,0" Tag="https://gamevau.lt/docs/gamevault-plus/integrations/discord" Click="Hyperlink_RequestNavigate">
                                        <TextBlock Text="Discord" FontSize="20" FontWeight="Bold" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="When enabled, your currently played game will be synced with the Discord Presence. This means that all your discord friends can see what you are currently playing" FontSize="15" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" />
                                <ToggleSwitch Content="Sync" Margin="0,10,0,0" IsChecked="{Binding SyncDiscordPresence}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                            <Rectangle Classes="integrationBar" />
                            <StackPanel Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCloudSave}" Fill="{DynamicResource Brush.Foreground}" VerticalAlignment="Center" RenderTransform="scale(0.9)" />
                                    <Button Classes="link" Margin="5,0,0,0" Tag="https://gamevau.lt/docs/gamevault-plus/cloud-saves" Click="Hyperlink_RequestNavigate">
                                        <TextBlock Text="Cloud Saves" FontSize="20" FontWeight="Bold" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Automatically backs up and restores your latest savefiles via your GameVault Server, ensuring seamless transitions between installations and devices." FontSize="15" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" />
                                <TextBlock Text="Requires GameVault Server with savefiles feature enabled." FontSize="12" FontStyle="Italic" />
                                <ToggleSwitch Margin="0,5,0,0" IsChecked="{Binding CloudSaves}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Custom Ludusavi Manifests" Margin="0,2,0,2" FontSize="15" VerticalAlignment="Center" />
                                    <CheckBox Content="Use Primary Manifest" IsChecked="{Binding UsePrimaryCloudSaveManifest}" Margin="15,0,0,0" ToolTip.Tip="Disable primary Ludusavi manifest to only use the custom ones" />
                                </StackPanel>
                                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" Width="560" HorizontalAlignment="Left">
                                    <ItemsControl ItemsSource="{Binding CustomCloudSaveManifests}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                    <TextBox Text="{Binding Uri}" Watermark="File path or URL" Width="510" />
                                                    <Button Classes="wrapper" Height="30" Width="30" Click="RemoveCustomCloudSaveManifest_Click">
                                                        <Grid Classes="hover" Background="Transparent">
                                                            <Path Data="m11.25 4.75l-6.5 6.5m0-6.5l6.5 6.5" Stroke="IndianRed" StrokeThickness="2" RenderTransform="scale(2)" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Spacing="10">
                                    <local:IconButton Icon="{StaticResource IconAddTag}" Text="Add" FontSize="15" IconMargin="0,0,5,2" Width="100" Height="30" Click="AddCustomCloudSaveManifest_Click" />
                                    <local:IconButton Icon="{StaticResource IconGameSettingsSave}" Text="Save" FontSize="15" IconMargin="0,0,5,2" Width="100" Height="30" Click="SaveCustomCloudSaveManifests_Click" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                            <Rectangle Classes="integrationBar" />
                            <StackPanel Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconGameSettingsPlaynite}" Fill="{DynamicResource Brush.Foreground}" VerticalAlignment="Center" />
                                    <TextBlock Text="Playnite" FontSize="20" FontWeight="Bold" Margin="5,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="GameVault integrates seamlessly with Playnite (Windows) using our Playnite Library Extension" FontSize="15" />
                                <Button Classes="link" Tag="https://playnite.link/addons.html#GameVault_fab8be77-18ab-4e6c-ad3d-89097b492d74" Click="Hyperlink_RequestNavigate">
                                    <TextBlock Text="Download Playnite Extension" FontSize="15" TextDecorations="Underline" />
                                </Button>
                                <Button Classes="link" Tag="https://gamevau.lt/docs/gamevault-plus/integrations/playnite/" Click="Hyperlink_RequestNavigate">
                                    <TextBlock Text="Setup Guide" FontSize="15" TextDecorations="Underline" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 5: Linux compatibility layer -->
            <TabItem Header="Linux" IsVisible="{Binding IsLinux}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="30,0,20,20" Spacing="10">
                        <TextBlock Classes="h1" Text="Running Windows games" />
                        <TextBlock FontSize="15" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"
                                   Text="Windows games, installers and uninstallers are started through a compatibility layer. Native Linux games (Linux Portable) are started directly." />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,5,0,0">
                            <TextBlock Text="Compatibility layer" FontSize="15" VerticalAlignment="Center" Width="200" />
                            <ComboBox ItemsSource="{Binding LinuxRunners}" SelectedItem="{Binding LinuxRunner}" Width="220" />
                        </StackPanel>
                        <TextBlock Margin="10,0,0,0" FontSize="13" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" Opacity="0.8"
                                   Text="Auto: Proton via umu-run when it is installed, otherwise Wine. Proton: umu-launcher downloads and manages GE-Proton by itself. Custom: your own command, with {exe} (the program) and {args} (the launch parameters)." />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,5,0,0" IsVisible="{Binding IsCustomRunner}">
                            <TextBlock Text="Custom command" FontSize="15" VerticalAlignment="Center" Width="200" />
                            <TextBox Text="{Binding CustomRunnerCommand}" Watermark="gamemoderun wine {exe} {args}" Width="500" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,5,0,0">
                            <TextBlock Text="Wine prefix" FontSize="15" VerticalAlignment="Center" Width="200" />
                            <TextBox Text="{Binding WinePrefix}" Watermark="{Binding EffectiveWinePrefix}" Width="500" />
                            <local:IconButton Text="Browse" FontSize="14" Width="90" Height="32" Click="BrowseWinePrefix_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,5,0,0">
                            <TextBlock Text="Proton path (umu)" FontSize="15" VerticalAlignment="Center" Width="200" />
                            <TextBox Text="{Binding ProtonPath}" Watermark="Empty: latest GE-Proton (downloaded by umu)" Width="500" />
                            <local:IconButton Text="Browse" FontSize="14" Width="90" Height="32" Click="BrowseProtonPath_Click" />
                        </StackPanel>
                        <TextBlock Classes="h1" Text="Detected tools" Margin="0,15,0,0" />
                        <Border Classes="group" Width="760">
                            <SelectableTextBlock x:Name="uiDetectedTools" Text="{Binding DetectedCompatibilityTools}" FontFamily="monospace" FontSize="13" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Margin="10,0,0,0" FontSize="13" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" Opacity="0.8"
                                   Text="Saves of Windows games running in the prefix are included in cloud saves automatically. Steam shortcuts start the games through GameVault." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 6: About -->
            <TabItem Header="About">
                <StackPanel Margin="30,0,0,0" HorizontalAlignment="Left" Spacing="20">
                    <TextBlock Classes="h1" Text="About" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Application Version" FontSize="15" Width="200" />
                        <TextBlock Text="{Binding Version}" FontSize="15" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="This build" FontSize="15" Width="200" />
                        <Button Classes="link" x:Name="uiForkLink" Click="Hyperlink_RequestNavigate">
                            <TextBlock x:Name="uiForkLinkText" FontSize="15" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Developed by Phalcode" FontSize="15" Width="200" />
                        <Button Classes="link" Tag="https://phalco.de" Click="Hyperlink_RequestNavigate">
                            <TextBlock Text="https://phalco.de" FontSize="15" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="License" FontSize="15" Width="200" />
                        <Button Classes="link" Tag="https://gamevau.lt/license" Click="Hyperlink_RequestNavigate">
                            <TextBlock Text="CC BY-NC-SA 4.0 (https://gamevau.lt/license)" FontSize="15" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Legal Notice" FontSize="15" Width="200" />
                        <Button Classes="link" Tag="https://phalco.de/legal" Click="Hyperlink_RequestNavigate">
                            <TextBlock Text="https://phalco.de/legal" FontSize="15" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Privacy Policy" FontSize="15" Width="200" />
                        <Button Classes="link" Tag="https://phalco.de/privacy" Click="Hyperlink_RequestNavigate">
                            <TextBlock Text="https://phalco.de/privacy" FontSize="15" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Terms of Service" FontSize="15" Width="200" />
                        <Button Classes="link" Tag="https://phalco.de/tos" Click="Hyperlink_RequestNavigate">
                            <TextBlock Text="https://phalco.de/tos" FontSize="15" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Metadata Providers:" FontSize="15" Width="200" />
                        <TextBlock Text="IGDB" FontSize="15" />
                        <Button Classes="link" Margin="10,0,0,0" Tag="https://www.igdb.com" Click="Hyperlink_RequestNavigate">
                            <TextBlock Text="https://www.igdb.com" FontSize="15" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- 7: Developer -->
            <TabItem Header="Developer" IsVisible="{Binding DevModeEnabled}">
                <StackPanel Margin="30,0,0,0">
                    <TextBlock Classes="h1" Text="Developer Settings" />
                    <TextBlock Text="You may need to restart the client for the changes to take effect" Margin="0,5,0,0" />
                    <local:IconButton Text="Open User Cache Folder" Height="30" Icon="{StaticResource IconGameSettingsFolder}" FontSize="15" IconMargin="0,0,5,5" Width="220" Margin="0,20,0,0" HorizontalAlignment="Left" Click="OpenUserCacheFolder_Click" />
                    <local:IconButton Text="Open Log File" Height="30" Icon="{StaticResource IconGameSettingsFolder}" FontSize="15" IconMargin="0,0,5,5" Width="220" Margin="0,10,0,0" HorizontalAlignment="Left" Click="OpenLogFolder_Click" />
                </StackPanel>
            </TabItem>
        </TabControl>
        <local:CacheImage Grid.Row="1" x:Name="imgAwesome" UseUriSource="True" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="100" Width="150" Margin="0,0,40,0" IsHitTestVisible="False" />
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:gamevault.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:gamevault.Converter"
             xmlns:local="clr-namespace:gamevault.UserControls"
             x:Class="gamevault.UserControls.RetroUserControl"
             Focusable="True">
    <!-- The games of the other platforms (RomM), played with RetroArch: laid out as the library (toolbar, chips, cards); a card opens the game's page -->
    <UserControl.Resources>
        <conv:AccentBrushConverter x:Key="accentBrushConv" />
        <conv:AccentShadowConverter x:Key="accentShadowConv" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="WrapPanel.chips > :is(Control)">
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- Top of the page tinted with the color of the shown game -->
        <Border Grid.RowSpan="2" Height="620" VerticalAlignment="Top" IsHitTestVisible="False" Background="{Binding AmbientBrush}" />

        <!-- ===== Toolbar ===== -->
        <StackPanel Grid.Row="0" Margin="28,20,28,6" Spacing="14">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Classes="pageTitle" Text="{l:T 'Retro'}" VerticalAlignment="Center" />
                    <TextBlock Classes="muted" FontSize="14" VerticalAlignment="Center" Margin="0,4,0,0" Text="{Binding CountText}" />
                </StackPanel>
                <TextBox x:Name="uiSearch" Grid.Column="1" Classes="librarySearch" MaxWidth="460" Margin="28,0" HorizontalAlignment="Stretch"
                         Watermark="{l:T 'Search the retro games'}" Text="{Binding Search}">
                    <TextBox.InnerLeftContent>
                        <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource Brush.Muted}" Stretch="Uniform" Width="16" Height="16" Margin="12,0,6,0" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="uiMenu" Classes="round small" Click="Menu_Click" ToolTip.Tip="{l:T 'RetroArch without a game: controls, picture, sound'}">
                        <Path Data="{StaticResource IconNavSettings}" Width="16" Height="16" />
                    </Button>
                    <Button Classes="round small" Click="Reload_Click" ToolTip.Tip="{l:T 'Reload'}">
                        <Path Data="{StaticResource IconReload}" Width="15" Height="15" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Platforms, then the filters and the sorting -->
            <Grid ColumnDefinitions="*,Auto">
                <WrapPanel Classes="chips" Margin="0,0,0,-8">
                    <ToggleButton x:Name="uiAll" Classes="chip" IsChecked="{Binding ShowsAll, Mode=OneWay}" Click="All_Click" Content="{l:T 'All'}" />
                    <ItemsControl x:Name="uiPlatforms" ItemsSource="{Binding Platforms}" Margin="0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Classes="chip" Margin="0,0,8,8" IsChecked="{Binding IsSelected, Mode=OneWay}" Click="Platform_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Count}" Opacity="0.6" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Width="1" Height="20" Background="{DynamicResource Brush.Line}" Margin="4,6,12,14" />
                    <ToggleButton Classes="chip" IsChecked="{Binding OnlyInstalled}" Content="{l:T 'Installed'}" />
                    <ToggleButton Classes="chip" IsChecked="{Binding OnlyFavorites}" Content="{l:T 'Bookmarks'}" />
                    <ToggleButton Classes="chip" IsChecked="{Binding ShowFilters}" Content="{l:T 'Filters'}" />
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <ComboBox x:Name="uiCollections" MinWidth="170" MaxWidth="260" MinHeight="32" ItemsSource="{Binding Collections}" SelectedIndex="{Binding Collection}"
                              SelectionChanged="Collections_SelectionChanged" ToolTip.Tip="{l:T 'Collections'}" />
                    <TextBlock Classes="muted" Text="{l:T 'Sort by'}" FontSize="13" VerticalAlignment="Center" />
                    <ComboBox MinWidth="160" MinHeight="32" ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortBy}" />
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowFilters}">
                <ComboBox x:Name="uiGenres" MinWidth="170" MinHeight="32" ItemsSource="{Binding Genres}" SelectedIndex="{Binding Genre}" />
                <ComboBox MinWidth="160" MinHeight="32" ItemsSource="{Binding PlayerOptions}" SelectedIndex="{Binding Players}" />
                <ComboBox x:Name="uiDecades" MinWidth="140" MinHeight="32" ItemsSource="{Binding Decades}" SelectedIndex="{Binding Decade}" />
                <ComboBox MinWidth="130" MinHeight="32" ItemsSource="{Binding RatingOptions}" SelectedIndex="{Binding Rating}" />
                <Button Classes="link" VerticalAlignment="Center" Click="ClearFilters_Click" IsVisible="{Binding HasFilters}" Content="{l:T 'Clear'}" />
            </StackPanel>
        </StackPanel>

        <!-- ===== Games ===== -->
        <ScrollViewer x:Name="uiScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,8,0,40">
                <TextBlock Classes="muted" FontSize="13.5" Margin="28,16" TextWrapping="Wrap" Text="{Binding Message}"
                           IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <local:ProgressRing IsActive="{Binding Loading}" IsVisible="{Binding Loading}" Width="32" Height="32" HorizontalAlignment="Left" Margin="38,16" />
                <!-- Continue playing: the games played last, whatever the console -->
                <StackPanel Margin="28,8,28,14" Spacing="10" IsVisible="{Binding HasRecent}">
                    <TextBlock Classes="sectionTitle" Text="{l:T 'Continue playing'}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Recent}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="14" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="gameCard" Width="124" VerticalAlignment="Top" Click="RecentCard_Click">
                                        <StackPanel Spacing="6">
                                            <local:AspectBox Ratio="{Binding Platform.System.CoverRatio}">
                                                <Border CornerRadius="10" ClipToBounds="True" Background="{DynamicResource Brush.Surface}">
                                                    <Panel>
                                                        <TextBlock Text="{Binding Name}" Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="8"
                                                                   IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNull}}" />
                                                        <Image Source="{Binding CoverImage}" Stretch="Uniform" />
                                                    </Panel>
                                                </Border>
                                            </local:AspectBox>
                                            <StackPanel Spacing="1">
                                                <TextBlock Classes="cardTitle" Text="{Binding Name}" />
                                                <TextBlock Classes="cardInfo" Text="{Binding Platform.Name}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
                <ItemsRepeater x:Name="uiGames" ItemsSource="{Binding Games}" Margin="20,0">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout ItemsStretch="Uniform" MinItemWidth="186" MinItemHeight="320" MinRowSpacing="10" MinColumnSpacing="0" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Button Classes="gameCard" Margin="8,8,8,0" VerticalAlignment="Top" Click="GameCard_Click">
                                <StackPanel Spacing="8">
                                    <local:AspectBox Ratio="{Binding Platform.System.CoverRatio}">
                                        <Panel Classes="lift">
                                            <Border Classes="glow" CornerRadius="10" Background="{DynamicResource Brush.Surface}"
                                                    BoxShadow="{Binding Accent, Converter={StaticResource accentShadowConv}, ConverterParameter='16 36 -8 0.75'}" />
                                            <Border CornerRadius="10" ClipToBounds="True" Background="{DynamicResource Brush.Surface}">
                                                <Panel>
                                                    <TextBlock Text="{Binding Name}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="14"
                                                               IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNull}}" />
                                                    <!-- Whole: a cover of another shape than the platform's is not cut -->
                                                    <Image Source="{Binding CoverImage}" Stretch="Uniform" />
                                                </Panel>
                                            </Border>
                                            <Border Classes="selection" BorderBrush="{Binding Accent, Converter={StaticResource accentBrushConv}}" IsVisible="{Binding IsSelected}" />
                                            <!-- State -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Spacing="4">
                                                <Border Classes="badge" IsVisible="{Binding IsFavorite}" ToolTip.Tip="{l:T 'Bookmarks'}">
                                                    <Path Data="{StaticResource IconBookmarkFilled}" Fill="Yellow" Stretch="Uniform" Width="9" Height="11" VerticalAlignment="Center" />
                                                </Border>
                                                <Border Classes="badge" IsVisible="{Binding Installed}">
                                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                                        <Path Data="{StaticResource IconTick}" Fill="{DynamicResource Brush.Success}" Stretch="Uniform" Width="9" Height="9" VerticalAlignment="Center" />
                                                        <TextBlock Text="{l:T 'INSTALLED'}" Foreground="{DynamicResource Brush.Success}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <!-- What is going on (download, unpacking, playing) -->
                                            <Border VerticalAlignment="Bottom" Margin="8" Padding="10,6" CornerRadius="8" Background="#CC000000"
                                                    IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11.5" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </Panel>
                                    </local:AspectBox>
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="cardTitle" Text="{Binding Name}" />
                                        <TextBlock Classes="cardInfo" Text="{Binding Info}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

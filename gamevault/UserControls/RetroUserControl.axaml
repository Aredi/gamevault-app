<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:gamevault.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:gamevault.UserControls"
             x:Class="gamevault.UserControls.RetroUserControl"
             Focusable="True">
    <!-- The games of the other platforms (RomM), played with RetroArch: installed and set up by the client -->
    <Grid RowDefinitions="Auto,*" Margin="40,24,20,0">
        <StackPanel Spacing="4" Margin="0,0,20,12">
            <TextBlock Classes="pageTitle" Text="{l:T 'Retro'}" />
            <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                       Text="{l:T 'The games of the other platforms, played with RetroArch: it is installed and set up the first time. Select+Start quits the game, L3+R3 opens its menu. The saves follow you from PC to PC.'}" />
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                <ComboBox x:Name="uiPlatforms" MinWidth="220" SelectionChanged="Platform_SelectionChanged" />
                <TextBox x:Name="uiSearch" Width="260" Watermark="{l:T 'Search'}" TextChanged="Search_TextChanged" />
                <Button x:Name="uiMenu" Classes="ghost" Content="{l:T 'RetroArch settings'}" Click="Menu_Click"
                        ToolTip.Tip="{l:T 'RetroArch without a game: controls, picture, sound'}" />
            </StackPanel>
            <TextBlock x:Name="uiMessage" Classes="muted" FontSize="13" Margin="0,16" IsVisible="False" TextWrapping="Wrap" />
            <local:ProgressRing x:Name="uiLoading" IsActive="False" IsVisible="False" Width="32" Height="32" HorizontalAlignment="Left" Margin="10,16" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsRepeater x:Name="uiGames" Margin="0,0,20,40">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="170" MinItemHeight="330" MinRowSpacing="14" MinColumnSpacing="14" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="170" Spacing="6" ToolTip.Tip="{Binding Summary}">
                            <Border Width="170" Height="220" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource Brush.Surface3}">
                                <Panel>
                                    <TextBlock Text="{Binding Name}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="10" />
                                    <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                </Panel>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Status}" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding SizeText}" Classes="muted" FontSize="12"
                                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                            <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding !Busy}">
                                <Button Classes="action small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{l:T 'Install'}"
                                        Click="Install_Click" IsVisible="{Binding !Installed}" />
                                <Button Classes="action small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{l:T 'Play'}"
                                        Click="Play_Click" IsVisible="{Binding Installed}" />
                                <Button Grid.Column="1" Classes="wrapper" Margin="8,0,0,0" Cursor="Hand" Click="Delete_Click" IsVisible="{Binding Installed}"
                                        ToolTip.Tip="{l:T 'Delete'}">
                                    <Path Data="{DynamicResource IconTrash}" Fill="IndianRed" Width="18" Height="18" Stretch="Uniform" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>

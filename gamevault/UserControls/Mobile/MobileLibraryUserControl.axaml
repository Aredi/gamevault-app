<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:gamevault.Localization"
             xmlns:uc="clr-namespace:gamevault.UserControls"
             x:Class="gamevault.UserControls.Mobile.MobileLibraryUserControl">
    <!-- The phone's games: the search, the consoles and the lists in chips, a grid of covers; unfolded, a game's page beside it -->
    <Grid x:Name="uiPanes" ColumnDefinitions="*,0">
        <Panel>
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                <Grid ColumnDefinitions="*,Auto" Margin="20,12,20,6">
                    <TextBlock Classes="mTitle" Text="{l:T 'Games'}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="mIcon" Click="Couch_Click" ToolTip.Tip="{l:T 'Living-room mode'}">
                        <Path Data="{DynamicResource M.Tv}" />
                    </Button>
                </Grid>
                <!-- The search -->
                <Border Grid.Row="1" Margin="16,6,16,10" Height="48" CornerRadius="24" Background="{DynamicResource Brush.Surface}" Padding="16,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Data="{DynamicResource M.Search}" Fill="{DynamicResource Brush.Foreground}" Opacity="0.5" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBox x:Name="uiSearch" Grid.Column="1" Text="{Binding Search}" Watermark="{l:T 'Search a game'}" Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center" FontSize="15" Margin="6,0,0,0" />
                    </Grid>
                </Border>
                <!-- The consoles -->
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="16,0">
                        <ToggleButton Classes="mChip" IsChecked="{Binding ShowsAll, Mode=OneWay}" Click="All_Click" Content="{l:T 'All'}" />
                        <ItemsControl ItemsSource="{Binding Platforms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Classes="mChip" IsChecked="{Binding IsSelected, Mode=OneWay}" Click="Platform_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding Count}" Opacity="0.55" FontWeight="Medium" />
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <!-- The lists -->
                <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                    <StackPanel x:Name="uiLists" Orientation="Horizontal" Margin="16,0">
                        <ToggleButton Classes="mChip" IsChecked="{Binding OnlyInstalled}" Content="{l:T 'Installed'}" />
                        <ToggleButton Classes="mChip" IsChecked="{Binding OnlyFavorites}" Content="{l:T 'Bookmarks'}" />
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="20,10,16,2">
                    <TextBlock x:Name="uiCount" Classes="mMuted" FontSize="13" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" MinHeight="34" FontSize="13" ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortBy}" BorderThickness="0" Background="Transparent" />
                </Grid>
                <ScrollViewer x:Name="uiScroll" Grid.Row="5" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Classes="mMuted" Margin="20,12" TextWrapping="Wrap" Text="{Binding Message}" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <uc:ProgressRing IsActive="{Binding Loading}" IsVisible="{Binding Loading}" Width="32" Height="32" HorizontalAlignment="Center" Margin="0,24" />
                        <ItemsRepeater x:Name="uiGrid" Margin="12,8,12,96" VerticalCacheLength="4">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout ItemsStretch="Uniform" MinItemWidth="116" MinItemHeight="200" MinRowSpacing="14" MinColumnSpacing="0" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <!-- A game at random -->
            <Button Classes="mPrimary" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18" Height="56" CornerRadius="18" Click="Random_Click">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Data="{DynamicResource M.Dice}" />
                    <TextBlock Text="{l:T 'At random'}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Panel>

        <!-- Unfolded: the chosen game's page beside the list -->
        <Border x:Name="uiDetail" Grid.Column="1" Background="{DynamicResource Brush.Background2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1,0,0,0" IsVisible="False" />

        <!-- A long press: what can be done with the game, in a sheet from the bottom -->
        <Panel x:Name="uiSheetLayer" Grid.ColumnSpan="2" IsVisible="False">
            <Border Background="#A005040C" PointerPressed="SheetDim_PointerPressed" />
            <Border x:Name="uiSheet" VerticalAlignment="Bottom" CornerRadius="28,28,0,0" Background="{DynamicResource Brush.Background2}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="0,1,0,0" Padding="20,10,20,24" MaxWidth="560">
                <StackPanel Spacing="4">
                    <Border Width="40" Height="5" CornerRadius="3" Background="#40FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,0,0,6">
                        <Border Classes="mCover" Width="56" Height="74" CornerRadius="10">
                            <Image x:Name="uiSheetCover" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="uiSheetTitle" FontFamily="{DynamicResource Font.Display}" FontWeight="Bold" FontSize="18" TextWrapping="Wrap" MaxLines="2" />
                            <TextBlock x:Name="uiSheetInfo" Classes="mMuted" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="uiSheetActions" Spacing="2" />
                </StackPanel>
            </Border>
        </Panel>
    </Grid>
</UserControl>

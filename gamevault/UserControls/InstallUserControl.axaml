<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:gamevault.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:gamevault.ViewModels"
             xmlns:conv="clr-namespace:gamevault.Converter"
             xmlns:local="clr-namespace:gamevault.UserControls"
             x:Class="gamevault.UserControls.InstallUserControl">
    <UserControl.Resources>
        <conv:CountConverter x:Key="countConv" />
        <conv:GameUpdateAvailableConverter x:Key="gameUpdateAvailableConv" />
        <conv:MappedTitleConverter x:Key="mappedTitleConv" />
        <conv:AccentBrushConverter x:Key="accentBrushConv" />
        <conv:AccentShadowConverter x:Key="accentShadowConv" />
        <conv:PlayInfoConverter x:Key="playInfoConv" />
    </UserControl.Resources>
    <!-- "Continue playing": the installed games, the last played first -->
    <StackPanel Spacing="12">
        <Grid Margin="28,0" ColumnDefinitions="Auto,*,Auto">
            <ToggleButton x:Name="uiInstalledGames" Classes="sectionToggle" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0">
                <ToggleButton.Template>
                    <ControlTemplate>
                        <ContentPresenter Content="{TemplateBinding Content}" Background="Transparent" />
                    </ControlTemplate>
                </ToggleButton.Template>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="sectionTitle" Text="{l:T 'Continue playing'}" VerticalAlignment="Center" />
                    <TextBlock Classes="muted" FontSize="13" VerticalAlignment="Center" Text="{Binding InstalledGamesFilter.Count, Converter={StaticResource countConv}, ConverterParameter='{}{0} installed game|{0} installed'}" />
                    <Path Data="{StaticResource IconChevronDown}" Fill="{DynamicResource Brush.Muted}" Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center"
                          RenderTransform="{Binding #uiInstalledGames.IsChecked, Converter={x:Static conv:LibraryStatic.FlipWhenFalse}}" />
                </StackPanel>
            </ToggleButton>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" IsVisible="{Binding #uiInstalledGames.IsChecked}">
                <Button Classes="round small" Click="ScrollPrevious_Click" ToolTip.Tip="{l:T 'Previous'}"><Path Data="{StaticResource IconChevronLeft}" /></Button>
                <Button Classes="round small" Click="ScrollNext_Click" ToolTip.Tip="{l:T 'Next'}"><Path Data="{StaticResource IconChevronRight}" /></Button>
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="uiInstalledGamesScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden" IsVisible="{Binding #uiInstalledGames.IsChecked}">
            <ItemsControl ItemsSource="{Binding InstalledGamesFilter}" Margin="28,8,28,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="16" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Classes="gameCard" Width="300" Click="GameCard_Clicked">
                            <StackPanel Spacing="8">
                                <Panel Classes="lift" Height="169">
                                    <Border Classes="glow" CornerRadius="12" Background="{DynamicResource Brush.Surface}"
                                            BoxShadow="{Binding #art.AccentColor, Converter={StaticResource accentShadowConv}, ConverterParameter='14 34 -10 0.75'}" />
                                    <Border CornerRadius="12" ClipToBounds="True" Background="{DynamicResource Brush.Surface}">
                                        <Panel>
                                            <local:CacheImage x:Name="art" ImageCacheType="GameBackground" FallbackToCover="True" ComputeAccent="True" Stretch="UniformToFill" Data="{Binding Key}" />
                                            <Border>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
                                                        <GradientStop Color="#D9000000" Offset="0" />
                                                        <GradientStop Color="#00000000" Offset="0.62" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock FontFamily="{StaticResource Font.Display}" FontWeight="Bold" FontSize="17" Foreground="White" TextWrapping="Wrap" MaxLines="2"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" Margin="14,0,64,13">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource mappedTitleConv}">
                                                        <Binding Path="Key" />
                                                        <Binding Source="{x:Static vm:SettingsViewModel.Instance}" Path="ShowMappedTitle" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Panel>
                                    </Border>
                                    <Border Classes="badge update" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                                            IsVisible="{Binding Key, Converter={StaticResource gameUpdateAvailableConv}}">
                                        <TextBlock Text="{l:T 'UPDATE'}" />
                                    </Border>
                                    <Panel Classes="hoverOnly">
                                        <Button Classes="round small" Width="30" Height="30" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                                                Click="Settings_Click" ToolTip.Tip="{l:T 'Game Settings'}">
                                            <Path Data="{StaticResource IconInstalledGamesSettings}" Width="14" Height="14" />
                                        </Button>
                                    </Panel>
                                    <Button Classes="round" Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                                            Foreground="White" Background="{Binding #art.AccentColor, Converter={StaticResource accentBrushConv}}"
                                            Click="Play_Click" ToolTip.Tip="{l:T 'Play'}">
                                        <Path Data="{StaticResource IconPlay}" Width="19" Height="19" Margin="2,0,0,0" />
                                    </Button>
                                </Panel>
                                <TextBlock Classes="cardInfo" Margin="2,0">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource playInfoConv}">
                                            <Binding Path="Key" />
                                            <Binding Source="{x:Static vm:InstallViewModel.Instance}" Path="PlayRecordsVersion" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:gamevault.Converter"
             xmlns:vm="clr-namespace:gamevault.ViewModels"
             xmlns:local="clr-namespace:gamevault.UserControls"
             x:Class="gamevault.UserControls.LibraryUserControl"
             Focusable="True">
    <UserControl.Resources>
        <conv:GameSizeConverter x:Key="sizeConv" />
        <conv:LibraryPermissionRoleToVisibilityConverter x:Key="libCardsPermVisConv" />
        <conv:IsGameDownloadedConverter x:Key="isGameDownloadedConv" />
        <conv:ContainsCurrentUserConverter x:Key="containsCurrentUserConv" />
        <conv:MappedTitleConverter x:Key="mappedTitleConv" />
        <conv:GreaterThanConverter x:Key="greaterThanConv" />
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- Game cards: overlay with actions while hovered, slight shrink animation -->
        <Style Selector="Button.card Grid.cardInner">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.card:pointerover Grid.cardInner">
            <Setter Property="RenderTransform" Value="scale(0.95)" />
        </Style>
        <Style Selector="Button.card Border.cardOverlay">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.card:pointerover Border.cardOverlay">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="50,*">
        <Border Background="{DynamicResource Brush.Background2}" Grid.Row="0">
            <TextBlock Text="Library" FontSize="35" Margin="20,0,0,0" VerticalAlignment="Center" />
        </Border>
        <ScrollViewer x:Name="uiMainScrollBar" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Viewbox Stretch="Uniform" StretchDirection="Both">
                    <local:InstallUserControl x:Name="uiGameInstalls" Width="2000" />
                </Viewbox>
                <Viewbox Stretch="Uniform" StretchDirection="Both">
                    <Expander x:Name="uiExpanderGameCards" Classes="gv" Width="2000" Margin="10,0,10,10">
                        <Expander.Header>
                            <Grid Height="35" Width="1920">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="10">
                                    <TextBlock Text="Server Games" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource Brush.Foreground2}" />
                                    <TextBlock FontWeight="Bold" FontSize="20" Foreground="{DynamicResource Brush.Foreground2}"
                                               IsVisible="{Binding TotalGamesCount, Converter={StaticResource greaterThanConv}, ConverterParameter=0}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="({0} of {1})">
                                                <Binding Path="GameCards.Count" />
                                                <Binding Path="TotalGamesCount" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15">
                                    <TextBox Classes="search" Width="378" Margin="0,4,0,4" TextChanged="Search_TextChanged" />
                                    <Button Classes="wrapper" x:Name="uiBtnReloadLibrary" Height="25" Width="25" ToolTip.Tip="Reload Library (F5)">
                                        <Grid Classes="hover" Background="Transparent">
                                            <Path Data="{StaticResource IconReload}" Fill="{DynamicResource Brush.Foreground2}" RenderTransform="scale(1.51)" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Button Classes="wrapper" Height="30" Width="33" ToolTip.Tip="I'm Feeling Lucky" Click="RandomGame_Click">
                                        <Grid Classes="hover" Background="Transparent">
                                            <Path Data="{StaticResource IconLibraryDices}" Fill="{DynamicResource Brush.Foreground2}" Stretch="Uniform" Width="28" Height="28" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10">
                                    <Grid Classes="hover" Height="30" Width="30" Cursor="Hand" ToolTip.Tip="Clear all Filters" Background="Transparent" PointerPressed="ClearAllFilters_Click"
                                          IsVisible="{Binding FilterCounter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <Path Data="m11.25 4.75l-6.5 6.5m0-6.5l6.5 6.5" Stroke="IndianRed" StrokeThickness="2" RenderTransform="scale(2)" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <local:Badged Badge="{Binding FilterCounter}" BadgeBackground="IndianRed">
                                        <Grid Classes="hover" Height="30" Width="30" Cursor="Hand" ToolTip.Tip="Toggle Filters &amp; Sorting" Background="Transparent" PointerPressed="Filter_Click">
                                            <Path Data="{StaticResource IconOpenFilter}" Fill="{DynamicResource Brush.Foreground2}" RenderTransform="scale(1.5)" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </local:Badged>
                                </StackPanel>
                            </Grid>
                        </Expander.Header>
                        <StackPanel>
                            <Grid IsVisible="{Binding FilterVisibility}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <local:PillSelector x:Name="uiFilterGameTypeSelector" SelectionType="GameType" Margin="12,0,24,0" Width="175" />
                                    <local:PillSelector x:Name="uiFilterTagSelector" SelectionType="Tags" Margin="0,0,24,0" Width="175" />
                                    <local:PillSelector x:Name="uiFilterGenreSelector" SelectionType="Genres" Margin="0,0,24,0" Width="175" />
                                    <local:PillSelector x:Name="uiFilterDeveloperSelector" SelectionType="Developers" Margin="0,0,24,0" Width="175" />
                                    <local:PillSelector x:Name="uiFilterPublisherSelector" SelectionType="Publishers" Margin="0,0,24,0" Width="175" />
                                    <local:PillSelector x:Name="uiFilterGameStateSelector" SelectionType="GameState" IsMultiSelection="False" Margin="0,0,23,0" Width="175" />
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Text="Release Year" FontSize="15" />
                                        <local:DateRangeSelector x:Name="uiFilterReleaseDateRangeSelector" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Text="Early Access" FontSize="15" />
                                        <ToggleButton x:Name="uiFilterEarlyAccess" Classes="icon earlyAccess" Width="30" Height="30" Margin="3,3,0,0" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,40,0">
                                        <TextBlock Text="Bookmarks" FontSize="15" />
                                        <ToggleButton x:Name="uiFilterBookmarks" Classes="icon bookmark" Width="30" Height="30" Margin="0,3,0,0" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Played" FontSize="15" />
                                        <ComboBox x:Name="uiFilterPlayStatus" Width="150" Margin="0,3,0,0" ItemsSource="{Binding PlayStatusValues}" SelectedItem="{Binding SelectedPlayStatus}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Key}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Collection" FontSize="15" />
                                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,3,0,0">
                                            <ComboBox x:Name="uiFilterCollection" Width="170" ItemsSource="{Binding CollectionNames}" SelectedItem="{Binding SelectedCollection}" />
                                            <Button Classes="wrapper" Width="30" Height="30" ToolTip.Tip="Manage collections" Click="ManageCollections_Click">
                                                <Grid Classes="hover" Background="Transparent">
                                                    <Path Data="{StaticResource IconInstalledGamesSettings}" Fill="{DynamicResource Brush.Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <ToggleButton x:Name="uiFilterOrderBy" Classes="icon orderBy" Width="35" Height="35" Margin="0,10,0,0" ToolTip.Tip="Sort order" />
                                    <ComboBox x:Name="uiFilterSortBy" Width="175" Margin="25,10,10,0" ItemsSource="{Binding GameFilterSortByValues}" SelectedItem="{Binding SelectedGameFilterSortBy}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Key}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <Border Background="{DynamicResource Brush.Background2}" CornerRadius="5" Margin="-6,5,-6,0" VerticalAlignment="Top">
                                <Grid>
                                    <!-- No Games Found -->
                                    <StackPanel ZIndex="1" HorizontalAlignment="Center" IsVisible="{Binding ShowNoGamesFound}">
                                        <Image Source="/Resources/Images/library_NoGameFound.png" Height="190" />
                                        <TextBlock Text="No Games found" FontSize="20" HorizontalAlignment="Center" Margin="0,-10,0,0" />
                                        <Button Classes="link" HorizontalAlignment="Center" FontSize="10" Margin="0,5,0,10" Opacity="0.8" Tag="https://gamevau.lt/docs/troubleshooting/#games-not-appearing-in-the-installations--servers-list" Click="Hyperlink_RequestNavigate">
                                            <TextBlock Text="Troubleshooting" TextDecorations="Underline" Foreground="{DynamicResource Brush.Foreground}" />
                                        </Button>
                                    </StackPanel>
                                    <!-- Server Error -->
                                    <StackPanel ZIndex="1" HorizontalAlignment="Center" IsVisible="{Binding !CanLoadServerGames}">
                                        <Image Source="/Resources/Images/install_NoGameFound.png" Height="190" />
                                        <TextBlock Text="Failed to load Library" FontSize="20" HorizontalAlignment="Center" Margin="0,-10,0,0" />
                                        <Button Classes="link" HorizontalAlignment="Center" FontSize="10" Margin="0,5,0,10" Opacity="0.8" Tag="https://gamevau.lt/docs/troubleshooting/#unable-to-connect-to-server--500-internal-server-error" Click="Hyperlink_RequestNavigate">
                                            <TextBlock Text="Troubleshooting" TextDecorations="Underline" Foreground="{DynamicResource Brush.Foreground}" />
                                        </Button>
                                    </StackPanel>
                                    <!-- Games found -->
                                    <ScrollViewer x:Name="uiServerGamesScroll" MaxHeight="891" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="Library_ScrollChanged">
                                        <ItemsRepeater x:Name="uiServerGamesItemsControl" ItemsSource="{Binding GameCards}" Margin="5,5,5,5">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout MaximumRowsOrColumns="10" MinItemWidth="197" ItemsJustification="Start" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Classes="wrapper card" Click="GameCard_Clicked" HorizontalAlignment="Center">
                                                        <Grid Background="Transparent" Height="267" Width="178" Margin="0,10,0,10">
                                                            <Grid Classes="cardInner">
                                                                <Border Background="{DynamicResource Brush.Background}" CornerRadius="8">
                                                                    <local:CacheImage Stretch="Fill" ImageCacheType="GameCover" Data="{Binding}" CornerRadius="8" />
                                                                </Border>
                                                                <Border Classes="cardOverlay" Background="{DynamicResource GameVault.Brushes.Blur}" CornerRadius="8">
                                                                    <Grid>
                                                                        <Button Classes="wrapper" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,10,0" Click="CardSettings_Click"
                                                                                IsVisible="{Binding Title, Converter={StaticResource libCardsPermVisConv}}">
                                                                            <Grid Classes="hover" Background="#02000000">
                                                                                <Path Data="{StaticResource IconInstalledGamesSettings}" Fill="{DynamicResource Brush.Foreground}" RenderTransform="scale(1.3)" />
                                                                            </Grid>
                                                                        </Button>
                                                                        <ToggleButton Classes="icon bookmark" Width="25" Height="25" Margin="10,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                                      IsChecked="{Binding BookmarkedUsers, Converter={StaticResource containsCurrentUserConv}, Mode=OneWay}" Click="CardBookmark_Click" />
                                                                        <TextBlock FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="5,0">
                                                                            <TextBlock.Text>
                                                                                <MultiBinding Converter="{StaticResource mappedTitleConv}">
                                                                                    <Binding />
                                                                                    <Binding Source="{x:Static vm:SettingsViewModel.Instance}" Path="ShowMappedTitle" />
                                                                                </MultiBinding>
                                                                            </TextBlock.Text>
                                                                        </TextBlock>
                                                                        <Button Classes="wrapper" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30" Click="Download_Click">
                                                                            <Grid Classes="hover" Background="Transparent" Height="61" Width="65" ToolTip.Tip="{Binding DownloadCount, StringFormat='Downloaded {0} times'}">
                                                                                <Path Fill="{DynamicResource Brush.Foreground}" Data="{StaticResource IconReDownload}" RenderTransform="scale(3)" RenderTransformOrigin="0%,0%" Margin="10,5,0,0"
                                                                                      IsVisible="{Binding ID, Converter={StaticResource isGameDownloadedConv}}" />
                                                                                <Path Fill="{DynamicResource Brush.Foreground}" Data="{StaticResource IconDownload}" RenderTransform="scale(3)" RenderTransformOrigin="0%,0%" Margin="10,5,0,0"
                                                                                      IsVisible="{Binding ID, Converter={StaticResource isGameDownloadedConv}, ConverterParameter=invert}" />
                                                                                <TextBlock FontSize="10" FontWeight="Bold" Text="{Binding Size, Converter={StaticResource sizeConv}}" Margin="0,50,0,0" HorizontalAlignment="Center" />
                                                                            </Grid>
                                                                        </Button>
                                                                    </Grid>
                                                                </Border>
                                                            </Grid>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </ScrollViewer>
                                    <Border Classes="hover" VerticalAlignment="Bottom" HorizontalAlignment="Right" IsVisible="{Binding ScrollToTopVisibility}" Background="{DynamicResource Brush.Accent2}"
                                            CornerRadius="5" Cursor="Hand" Width="50" Height="50" Margin="0,0,15,15" ZIndex="2" PointerReleased="ScrollToTop_Click">
                                        <Path Data="{StaticResource IconLibraryScrollToTop}" Fill="{DynamicResource Brush.Foreground}" RenderTransform="scale(2)" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Expander>
                </Viewbox>
            </StackPanel>
        </ScrollViewer>
        <NativeWebView x:Name="uiImgRandom" Grid.Row="0" Grid.RowSpan="2" ZIndex="1000" IsVisible="False" />
    </Grid>
</UserControl>

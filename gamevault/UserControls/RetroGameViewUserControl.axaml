<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:gamevault.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:gamevault.UserControls"
             x:Class="gamevault.UserControls.RetroGameViewUserControl"
             Focusable="True">
    <!-- The page of a retro game: laid out as the library's game page (artwork, header, play data, gallery, facts, friends) -->
    <UserControl.Styles>
        <Style Selector="Border.chip">
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="11,0" />
        </Style>
        <Style Selector="Border.chip TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Grid.fact">
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style Selector="Grid.fact > TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.fact > TextBlock.value">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="16,0,0,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style Selector="StackPanel.stat">
            <Setter Property="Spacing" Value="4" />
            <Setter Property="Margin" Value="0,14,40,14" />
            <Setter Property="MinWidth" Value="110" />
        </Style>
        <Style Selector="StackPanel.stat TextBlock.label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1.2" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
        </Style>
        <Style Selector="StackPanel.stat > TextBlock.value">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style Selector="TabControl.page TabItem">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="0,0,22,0" />
        </Style>
        <Style Selector="Button.heroLink">
            <Setter Property="Background" Value="{DynamicResource Brush.Background}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.heroLink:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.heroLink TextBlock">
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>
        <Style Selector="Button.thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}" Background="Transparent" />
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Grid>
        <ScrollViewer Classes="page" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Panel>
                <!-- Artwork across the top (a screenshot), fading into the page and tinted with the game color -->
                <Panel Height="620" VerticalAlignment="Top" ClipToBounds="True">
                    <Panel.OpacityMask>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="Black" Offset="0" />
                            <GradientStop Color="Black" Offset="0.45" />
                            <GradientStop Color="#C0000000" Offset="0.62" />
                            <GradientStop Color="#70000000" Offset="0.76" />
                            <GradientStop Color="#28000000" Offset="0.88" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </LinearGradientBrush>
                    </Panel.OpacityMask>
                    <!-- Small pictures (a GBA screen is 240 pixels): softened as the library's artwork without a background -->
                    <Image Source="{Binding Game.Banner}" Stretch="UniformToFill">
                        <Image.Effect>
                            <BlurEffect Radius="14" />
                        </Image.Effect>
                    </Image>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
                                <GradientStop Color="{DynamicResource GameVault.Colors.Background}" Offset="0" />
                                <GradientStop Color="{DynamicResource GameVault.Colors.BackgroundSoft}" Offset="0.45" />
                                <GradientStop Color="{DynamicResource GameVault.Colors.BackgroundClear}" Offset="0.85" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border Background="{Binding AccentBrush}" Opacity="0.35">
                        <Border.OpacityMask>
                            <RadialGradientBrush Center="15%,100%" GradientOrigin="15%,100%" RadiusX="65%" RadiusY="80%">
                                <GradientStop Color="Black" Offset="0" />
                                <GradientStop Color="Transparent" Offset="1" />
                            </RadialGradientBrush>
                        </Border.OpacityMask>
                    </Border>
                </Panel>

                <StackPanel x:Name="uiContent" Margin="44,250,44,48" MaxWidth="1500" Spacing="26">
                    <!-- Header: cover, title, actions -->
                    <Grid ColumnDefinitions="Auto,*">
                        <Border x:Name="uiCoverFrame" Width="220" CornerRadius="14" ClipToBounds="True" VerticalAlignment="Bottom"
                                BoxShadow="0 30 60 -20 #E6000000" Background="{DynamicResource Brush.Surface}">
                            <local:AspectBox Ratio="{Binding Game.CoverRatio}">
                                <Image Source="{Binding Game.CoverImage}" Stretch="Uniform" />
                            </local:AspectBox>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="30,0,0,4" VerticalAlignment="Bottom" Spacing="12">
                            <ScrollViewer HorizontalAlignment="Left" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Classes="chip" Background="{DynamicResource Brush.Glass}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Data="{StaticResource IconNavRetro}" Fill="{DynamicResource Brush.Foreground}" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Game.Platform.Name}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="chip" Background="{DynamicResource Brush.Glass}" IsVisible="{Binding HasLanguages}" ToolTip.Tip="{Binding LanguagesText}">
                                        <TextBlock Text="{Binding LanguageCodes}" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Game.Genres}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="chip" Background="{Binding $parent[local:RetroGameViewUserControl].DataContext.AccentSoftBrush}">
                                                    <TextBlock Text="{Binding}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                            <TextBlock x:Name="uiTitle" Classes="display" FontSize="50" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" Text="{Binding Game.Name}" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="15" Opacity="0.85" TextWrapping="Wrap" />
                            <!-- Actions -->
                            <WrapPanel Margin="0,6,0,0" IsEnabled="{Binding !Game.Busy}">
                                <Button Classes="action" Height="48" Padding="24,0" Margin="0,0,10,10" Background="{Binding AccentBrush}" Click="InstallAndPlay_Click" IsVisible="{Binding !Game.Installed}"
                                        ToolTip.Tip="{l:T 'Download, install and start the game'}">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <Path Data="{StaticResource IconPlay}" Width="18" Height="18" />
                                        <TextBlock Text="{l:T 'Install &amp; Play'}" FontSize="15" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="action" Height="48" Padding="30,0" Margin="0,0,10,10" Background="{Binding AccentBrush}" Click="Play_Click" IsVisible="{Binding Game.Installed}">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <Path Data="{StaticResource IconPlay}" Width="18" Height="18" />
                                        <TextBlock Text="{l:T 'Play'}" FontSize="15" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="ghost" Height="48" Margin="0,0,10,10" Click="Install_Click" IsVisible="{Binding !Game.Installed}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Data="{StaticResource IconArrowDown}" />
                                        <TextBlock VerticalAlignment="Center" Text="{l:T 'Download'}" />
                                        <TextBlock VerticalAlignment="Center" Opacity="0.7" FontWeight="Medium" Text="{Binding Game.SizeText}" />
                                    </StackPanel>
                                </Button>
                                <Border Background="{DynamicResource Brush.Glass}" CornerRadius="11" Width="48" Height="48" Margin="0,0,8,10">
                                    <ToggleButton Classes="icon bookmark" Width="48" Height="48" IsChecked="{Binding Game.IsFavorite}" ToolTip.Tip="{l:T 'Bookmark'}" />
                                </Border>
                                <Button Classes="round" Width="48" Height="48" Margin="0,0,8,10" Click="Collections_Click" ToolTip.Tip="{l:T 'Collections'}">
                                    <Path Data="{StaticResource IconCollection}" Width="18" Height="18" />
                                </Button>
                                <Button Classes="round" Width="48" Height="48" Margin="0,0,8,10" Click="Delete_Click" IsVisible="{Binding Game.Installed}"
                                        ToolTip.Tip="{l:T 'Delete from this PC (the saves are kept)'}">
                                    <Path Data="{StaticResource IconTrash}" Fill="IndianRed" Width="18" Height="18" />
                                </Button>
                            </WrapPanel>
                            <!-- What is going on (download, unpacking, playing), on a pill: readable whatever the artwork behind -->
                            <Border HorizontalAlignment="Left" Background="{DynamicResource Brush.Background}" CornerRadius="12" Padding="12,6" Opacity="0.9"
                                    IsVisible="{Binding Game.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding Game.Status}" FontSize="13" TextWrapping="Wrap" />
                            </Border>
                            <WrapPanel>
                                <Button Classes="heroLink" Click="Manual_Click" IsVisible="{Binding Game.HasManual}">
                                    <TextBlock Text="{l:T 'Open the manual'}" />
                                </Button>
                                <Button Classes="heroLink" Click="OpenFolder_Click" IsVisible="{Binding Game.Installed}">
                                    <TextBlock Text="{l:T 'Open the game folder'}" />
                                </Button>
                                <Button Classes="heroLink" Click="Menu_Click">
                                    <TextBlock Text="{Binding MenuText}" />
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Play data -->
                    <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1">
                        <WrapPanel>
                            <StackPanel Classes="stat">
                                <TextBlock Classes="label" Text="{l:T 'PLAYTIME'}" />
                                <TextBlock Classes="value" Text="{Binding Game.PlaytimeText}" />
                            </StackPanel>
                            <StackPanel Classes="stat">
                                <TextBlock Classes="label" Text="{l:T 'LAST PLAYED'}" />
                                <TextBlock Classes="value" Text="{Binding LastPlayedText}" />
                            </StackPanel>
                            <StackPanel Classes="stat" ToolTip.Tip="{l:T 'To finish the main story (HowLongToBeat)'}">
                                <TextBlock Classes="label" Text="{l:T 'DURATION'}" />
                                <TextBlock Classes="value" Text="{Binding Game.DurationText}" />
                            </StackPanel>
                            <StackPanel Classes="stat">
                                <TextBlock Classes="label" Text="{l:T 'RATING'}" />
                                <TextBlock Classes="value" Text="{Binding Game.RatingText}" />
                            </StackPanel>
                            <!-- The player's own status and rating, kept in their RomM -->
                            <StackPanel Classes="stat" IsVisible="{Binding HasRomm}">
                                <TextBlock Classes="label" Text="{l:T 'MY GAME'}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ComboBox MinWidth="150" MinHeight="30" ItemsSource="{Binding StatusOptions}" SelectedIndex="{Binding StatusIndex}" ToolTip.Tip="{l:T 'Your status of the game, kept in your RomM'}" />
                                    <ComboBox MinWidth="96" MinHeight="30" ItemsSource="{Binding RatingOptions}" SelectedIndex="{Binding RatingIndex}" ToolTip.Tip="{l:T 'Your rating of the game, kept in your RomM'}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Classes="stat" IsVisible="{Binding !HasRomm}">
                                <TextBlock Classes="label" Text="{l:T 'MY GAME'}" />
                                <TextBlock Text="{Binding RommNote}" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxWidth="300" />
                            </StackPanel>
                            <!-- The console's language the game starts in (Settings > Retro, or this game's own) -->
                            <StackPanel Classes="stat" IsVisible="{Binding HasConsoleLanguage}">
                                <TextBlock Classes="label" Text="{l:T 'LANGUAGE'}" />
                                <ComboBox x:Name="uiLanguage" MinWidth="170" MinHeight="30" ItemsSource="{Binding LanguageOptions}" SelectedIndex="{Binding LanguageIndex}"
                                          ToolTip.Tip="{l:T 'The language of the console the game starts in; a game without it keeps its own'}" />
                            </StackPanel>
                            <StackPanel Classes="stat">
                                <TextBlock Classes="label" Text="{l:T 'CLOUD SAVES'}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Classes="ghost small" Click="RestoreCloudSaves_Click" ToolTip.Tip="{l:T 'Take the saves of the cloud (the ones of this PC are kept in a backup)'}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Data="{StaticResource IconCloudSaveUpload}" RenderTransform="rotate(180deg)" Width="14" Height="14" />
                                            <TextBlock Text="{l:T 'Restore'}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="ghost small" Click="UploadCloudSaves_Click" ToolTip.Tip="{l:T 'Send the saves of this PC to the cloud now'}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Data="{StaticResource IconCloudSaveUpload}" Width="14" Height="14" />
                                            <TextBlock Text="{l:T 'Upload'}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="ghost small" Click="SaveHistory_Click" ToolTip.Tip="{l:T 'The cloud saves the server keeps: restore an older one'}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Data="{StaticResource IconGameViewCalendar}" Width="14" Height="14" />
                                            <TextBlock Text="{l:T 'History'}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{Binding SavesText}" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxWidth="420" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <!-- Media and description | facts and friends -->
                    <Grid x:Name="uiBody" ColumnDefinitions="*,36,330" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Column="0" Spacing="12">
                            <StackPanel Spacing="10" MaxWidth="860" HorizontalAlignment="Left" IsVisible="{Binding HasScreenshots}">
                                <local:AspectBox Ratio="0.6667">
                                    <Border CornerRadius="14" ClipToBounds="True" Background="Black">
                                        <Panel>
                                            <Image Source="{Binding SelectedScreenshot}" Stretch="Uniform" />
                                            <Button Classes="round" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" Click="PreviousScreenshot_Click"
                                                    IsVisible="{Binding HasSeveralScreenshots}" ToolTip.Tip="{l:T 'Previous'}">
                                                <Path Data="{StaticResource IconChevronLeft}" />
                                            </Button>
                                            <Button Classes="round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Click="NextScreenshot_Click"
                                                    IsVisible="{Binding HasSeveralScreenshots}" ToolTip.Tip="{l:T 'Next'}">
                                                <Path Data="{StaticResource IconChevronRight}" />
                                            </Button>
                                            <Button Classes="action" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16" Background="{Binding AccentBrush}"
                                                    Click="Video_Click" IsVisible="{Binding Game.HasVideo}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Path Data="{StaticResource IconPlay}" />
                                                    <TextBlock Text="{l:T 'Watch the trailer'}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" Background="{DynamicResource Brush.Glass}" CornerRadius="8" Padding="9,4"
                                                    IsVisible="{Binding HasSeveralScreenshots}">
                                                <TextBlock Text="{Binding ScreenshotCounter}" FontSize="12" FontWeight="Bold" />
                                            </Border>
                                        </Panel>
                                    </Border>
                                </local:AspectBox>
                                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding HasSeveralScreenshots}">
                                    <ItemsControl ItemsSource="{Binding Game.ScreenshotImages}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="10" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Classes="thumb" Click="Screenshot_Click">
                                                    <Border Width="144" Height="96" CornerRadius="9" ClipToBounds="True" Background="Black">
                                                        <Image Source="{Binding}" Stretch="Uniform" />
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                            <!-- Without screenshots: the trailer still plays -->
                            <Button Classes="action" HorizontalAlignment="Left" Background="{Binding AccentBrush}" Click="Video_Click">
                                <Button.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="Game.HasVideo" />
                                        <Binding Path="!HasScreenshots" />
                                    </MultiBinding>
                                </Button.IsVisible>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Data="{StaticResource IconPlay}" />
                                    <TextBlock Text="{l:T 'Watch the trailer'}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TabControl Classes="page" Padding="0,8,0,0" Margin="0,8,0,0">
                                <TabItem Header="{l:T 'Description'}">
                                    <TextBlock Text="{Binding Game.Summary, TargetNullValue={l:T 'No description'}}" TextWrapping="Wrap" FontSize="15" LineHeight="24" Opacity="0.9" />
                                </TabItem>
                                <!-- RetroAchievements, from the player's RomM: the earned ones bright -->
                                <TabItem Header="{l:T 'Achievements'}" IsVisible="{Binding HasAchievements}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="{Binding AchievementsText}" Classes="muted" FontSize="13" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding Achievements}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="12" Background="{DynamicResource Brush.Surface}" Margin="0,0,0,8" Padding="10" Opacity="{Binding Opacity}">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <Border Width="48" Height="48" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource Brush.Surface3}">
                                                                <Image Source="{Binding Badge}" Stretch="UniformToFill" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                                                <TextBlock Text="{Binding PointsText}" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Right" />
                                                                <Path Data="{StaticResource IconTick}" Fill="{DynamicResource Brush.Success}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Right"
                                                                      IsVisible="{Binding Earned}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </TabItem>
                                <!-- The save states RetroArch made, with its picture: the game starts from one -->
                                <TabItem Header="{l:T 'Save states'}" IsVisible="{Binding HasStates}">
                                    <ItemsControl ItemsSource="{Binding States}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="220" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource Brush.Surface}" Margin="0,0,12,12">
                                                    <StackPanel>
                                                        <local:AspectBox Ratio="0.75">
                                                            <Border Background="Black">
                                                                <Image Source="{Binding Picture}" Stretch="Uniform" />
                                                            </Border>
                                                        </local:AspectBox>
                                                        <Grid ColumnDefinitions="*,Auto" Margin="10,8">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SlotText}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding WhenText}" Classes="muted" FontSize="12" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Classes="ghost small" Click="ResumeState_Click"
                                                                    IsEnabled="{Binding !$parent[local:RetroGameViewUserControl].DataContext.Game.Busy}">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <Path Data="{StaticResource IconPlay}" Width="12" Height="12" />
                                                                    <TextBlock Text="{l:T 'Resume'}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </TabItem>
                            </TabControl>
                        </StackPanel>

                        <StackPanel x:Name="uiSide" Grid.Column="2" Spacing="26">
                            <StackPanel>
                                <TextBlock Classes="sectionTitle" Text="{l:T 'About the game'}" Margin="0,0,0,8" />
                                <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
                                    <Grid Classes="fact" ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="label" Text="{l:T 'Companies'}" />
                                        <TextBlock Classes="value" Text="{Binding CompaniesText}" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
                                    <Grid Classes="fact" ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="label" Text="{l:T 'Series'}" />
                                        <TextBlock Classes="value" Text="{Binding SeriesText}" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
                                    <Grid Classes="fact" ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="label" Text="{l:T 'Release'}" />
                                        <TextBlock Classes="value" Text="{Binding ReleaseText}" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
                                    <Grid Classes="fact" ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="label" Text="{l:T 'Platform'}" />
                                        <TextBlock Classes="value" Text="{Binding Game.Platform.Name}" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
                                    <Grid Classes="fact" ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="label" Text="{l:T 'Size'}" />
                                        <TextBlock Classes="value" Text="{Binding Game.SizeText}" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
                                    <Grid Classes="fact" ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="label" Text="{l:T 'Game modes'}" />
                                        <TextBlock Classes="value" Text="{Binding ModesText}" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
                                    <Grid Classes="fact" ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="label" Text="{l:T 'Players'}" />
                                        <TextBlock Classes="value" Text="{Binding PlayersText}" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
                                    <Grid Classes="fact" ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="label" Text="{l:T 'Regions'}" />
                                        <TextBlock Classes="value" Text="{Binding RegionsText}" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
                                    <Grid Classes="fact" ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="label" Text="{l:T 'Languages'}" />
                                        <TextBlock Classes="value" Text="{Binding LanguagesText}" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
                                    <Grid Classes="fact" ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="label" Text="{l:T 'Age Rating'}" />
                                        <TextBlock Classes="value" Text="{Binding AgeRatingsText}" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
                                    <Grid Classes="fact" ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="label" Text="{l:T 'File'}" />
                                        <TextBlock Classes="value" Text="{Binding Game.FileName}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="10" IsVisible="{Binding HasPlayers}">
                                <TextBlock Classes="sectionTitle" Text="{l:T 'Your friends played it'}" />
                                <ItemsControl ItemsSource="{Binding Players}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12" Background="{DynamicResource Brush.Surface}" Margin="0,0,0,8" Padding="10">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Width="38" Height="38" CornerRadius="19" ClipToBounds="True" Background="{DynamicResource Brush.Surface3}">
                                                        <Panel>
                                                            <TextBlock Text="{Binding Username[0]}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                                            <local:CacheImage Data="{Binding User}" Stretch="UniformToFill" ImageCacheType="UserAvatar"
                                                                              IsVisible="{Binding User, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        </Panel>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Text="{Binding Username}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock Text="{Binding TimeText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                        <TextBlock Classes="muted" FontSize="12" HorizontalAlignment="Right" Text="{Binding WhenText}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Panel>
        </ScrollViewer>

        <!-- Back, always reachable -->
        <Button Classes="ghost small" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,18,0,0" Click="Back_Click" ToolTip.Tip="{l:T 'Back (Esc)'}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{StaticResource IconChevronLeft}" Width="14" Height="14" />
                <TextBlock Text="{l:T 'Back'}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>

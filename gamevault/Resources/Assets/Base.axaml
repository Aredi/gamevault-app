<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uc="clr-namespace:gamevault.UserControls">

    <!-- Brushes (Brush.*, GameVault.Brushes.*) are created at runtime by ThemeManager from the selected theme. -->

    <x:Int32 x:Key="Zero">0</x:Int32>
    <CornerRadius x:Key="ControlCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

    <!-- IconButton -->
    <ControlTheme x:Key="{x:Type uc:IconButton}" TargetType="uc:IconButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground2}" />
        <Setter Property="Background" Value="{DynamicResource GameVault.Brushes.Button}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameVault.Brushes.Button}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                        <Path Name="PART_Icon"
                              Data="{TemplateBinding Icon}"
                              Fill="{TemplateBinding Foreground}"
                              VerticalAlignment="Center"
                              IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Text="{TemplateBinding Text}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Name="PART_Disabled"
                            IsVisible="False"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{DynamicResource GameVault.Brushes.Button.Disabled}" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:skeleton">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^:danger">
            <Setter Property="Background" Value="IndianRed" />
            <Setter Property="BorderBrush" Value="IndianRed" />
        </Style>

        <Style Selector="^:primary:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource GameVault.Brushes.Button.MouseOver}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GameVault.Brushes.Button.MouseOver}" />
        </Style>
        <Style Selector="^:skeleton:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource GameVault.Brushes.Button.MouseOver}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GameVault.Brushes.Button.MouseOver}" />
        </Style>
        <Style Selector="^:danger:pointerover /template/ Border#PART_Border">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="^:primary:pressed /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource GameVault.Brushes.Button.Focus}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GameVault.Brushes.Button.Focus}" />
        </Style>
        <Style Selector="^:skeleton:pressed /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource GameVault.Brushes.Button.Focus}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GameVault.Brushes.Button.Focus}" />
        </Style>
        <Style Selector="^:danger:pressed /template/ Border#PART_Border">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="^:disabled /template/ Border#PART_Disabled">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled /template/ Border#PART_Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </ControlTheme>

    <!-- ProgressRing -->
    <ControlTheme x:Key="{x:Type uc:ProgressRing}" TargetType="uc:ProgressRing">
        <Setter Property="Width" Value="60" />
        <Setter Property="Height" Value="60" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Arc Name="PART_Arc"
                     Stroke="{TemplateBinding Foreground}"
                     StrokeThickness="5"
                     StrokeLineCap="Round"
                     StartAngle="0"
                     SweepAngle="270"
                     IsVisible="{TemplateBinding IsActive}">
                    <Arc.RenderTransform>
                        <RotateTransform />
                    </Arc.RenderTransform>
                </Arc>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Arc#PART_Arc">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </ControlTheme>

    <!-- Badged -->
    <ControlTheme x:Key="{x:Type uc:Badged}" TargetType="uc:Badged">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                    <Border IsVisible="{TemplateBinding HasBadge}"
                            Background="{TemplateBinding BadgeBackground}"
                            CornerRadius="9" MinWidth="18" Height="18" Padding="4,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0">
                        <ContentPresenter Content="{TemplateBinding Badge}" Foreground="White" FontSize="11" FontWeight="Bold"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>

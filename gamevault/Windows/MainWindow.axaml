<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:gamevault.Windows"
        x:Class="gamevault.Windows.MainWindow"
        Title="SanctuaryVault" Icon="/Resources/Images/icon.ico"
        Width="1280" Height="800" MinWidth="600" MinHeight="345"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <!-- The pages are MainView's: the same view fills the Android app -->
    <local:MainView x:Name="View" />
</Window>

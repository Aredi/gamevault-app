<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:gamevault.UserControls"
        xmlns:conv="clr-namespace:gamevault.Converter"
        xmlns:local="clr-namespace:gamevault.Windows"
        x:Class="gamevault.Windows.LoginWindow"
        Title="GameVault" Icon="/Resources/Images/icon.ico"
        Width="720" Height="500" CanResize="False" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background2}">
    <Window.Resources>
        <conv:InverseBoolConverter x:Key="invBoolConv" />
    </Window.Resources>
    <Window.Styles>
        <!-- Profile tiles: details, settings button and blur only while hovered -->
        <Style Selector="Button.profile Border.hoverBlur, Button.profile Button.profileSettings, Button.profile StackPanel.profileInfo">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.profile:pointerover Border.hoverBlur, Button.profile:pointerover Button.profileSettings, Button.profile:pointerover StackPanel.profileInfo">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Image.rotating">
            <Setter Property="RenderTransform">
                <RotateTransform />
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:5" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="TextDecorations" Value="Underline" />
            <Setter Property="Margin" Value="0,15,0,5" />
        </Style>
        <Style Selector="TextBlock.mandatory">
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Panel>
        <Carousel SelectedIndex="{Binding LoginStepIndex}">
            <!-- 0: Loading -->
            <Grid Height="220" VerticalAlignment="Center">
                <Image Classes="rotating" Source="/Resources/Images/icon.png" Height="130" VerticalAlignment="Top" Margin="15" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="10" FontSize="15" FontWeight="Bold" />
            </Grid>

            <!-- 1: Choose profile -->
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Choose Your Profile" FontSize="30" HorizontalAlignment="Center" />
                    <StackPanel Margin="0,30,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="560">
                            <ItemsControl ItemsSource="{Binding UserProfiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="wrapper profile" Click="ProfileLogin_Click" Margin="0,0,25,0" VerticalAlignment="Top">
                                            <StackPanel Classes="hover" Background="Transparent">
                                                <Border Background="{DynamicResource Brush.Background}" CornerRadius="5">
                                                    <Grid Height="100" Width="100">
                                                        <uc:CacheImage UseUriSource="True" ImageCacheType="UserAvatar" Data="{Binding UserCacheAvatar}" CornerRadius="5" />
                                                        <Border Classes="hoverBlur" Background="{DynamicResource GameVault.Brushes.Blur}" CornerRadius="5" />
                                                        <Button Classes="wrapper profileSettings" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5" Click="UserProfileContextMenu_Click">
                                                            <Border Classes="hover" Background="Transparent" CornerRadius="5">
                                                                <Path Data="{StaticResource IconInstalledGamesSettings}" Fill="White" />
                                                            </Border>
                                                            <Button.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="Edit User Profile" Click="EditUserProfile_Click" />
                                                                    <MenuItem Header="Delete User Profile" Click="DeleteUserProfile_Click" />
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Classes="profileInfo" Width="100">
                                                    <TextBlock Text="{Binding Name}" FontSize="17" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding ServerUrl}" TextAlignment="Center" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel Margin="0,20,0,0">
                            <Button Classes="wrapper" Height="50" Width="50" HorizontalAlignment="Center" Click="NewProfile_Click">
                                <Grid Classes="hover" Background="Transparent">
                                    <Path Data="{StaticResource IconAddSimple}" Fill="White" RenderTransform="scale(2)" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <TextBlock Text="New Profile" FontSize="15" HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Button Classes="wrapper" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,5,5,0" Click="LoginWindowSettings_Click" ToolTip.Tip="Client Settings">
                    <Border Classes="hover" Background="Transparent" CornerRadius="5">
                        <Path Data="{StaticResource IconInstalledGamesSettings}" Fill="White" Margin="0,0,5,2" />
                    </Border>
                </Button>
                <CheckBox Content="Remember Me" IsChecked="{Binding RememberMe}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" />
            </Grid>

            <!-- 2: Sign in or sign up -->
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Sign In or Sign Up" FontSize="30" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                        <StackPanel>
                            <Button Classes="wrapper" Height="50" Width="50" HorizontalAlignment="Center" Click="SignIn_Click">
                                <Grid Classes="hover" Background="Transparent">
                                    <Path Data="{StaticResource IconLogin}" Fill="White" RenderTransform="scale(2)" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <TextBlock Text="Sign In" FontSize="15" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Margin="80,0,0,0">
                            <Button Classes="wrapper" Height="50" Width="50" HorizontalAlignment="Center" Click="SignUp_Click">
                                <Grid Classes="hover" Background="Transparent">
                                    <Path Data="{StaticResource IconAddSimple}" Fill="White" RenderTransform="scale(2)" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <TextBlock Text="Sign Up" FontSize="15" HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <uc:IconButton Text="Back" Kind="Skeleton" BorderThickness="1" Height="30" Margin="10,0,0,10" Width="100" HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="Back_Click" Tag="{x:Static local:LoginStep.ChooseProfile}" />
            </Grid>

            <!-- 3: Sign in -->
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
                    <TextBlock Text="Sign In" FontSize="30" HorizontalAlignment="Center" />
                    <TextBlock Classes="label" Text="Specify Your Server URL" />
                    <Panel>
                        <TextBox Text="{Binding LoginUser.ServerUrl}" Watermark="https://gamevault.example.com" TextChanged="ServerUrlInput_TextChanged" KeyDown="UserLoginTextBox_KeyDown" />
                        <Path Data="{StaticResource IconCheck}" Fill="Green" Margin="0,0,-30,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding LoginServerInfo.IsAvailable}" />
                        <Path Data="{StaticResource IconErrorCircle}" Fill="IndianRed" Margin="0,0,-30,0" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Help"
                              IsVisible="{Binding LoginServerInfo.HasError}" ToolTip.Tip="{Binding LoginServerInfo.ErrorMessage}" />
                    </Panel>
                    <StackPanel>
                        <StackPanel.IsEnabled>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="LoginServerInfo.IsBasicAuthEnabled" />
                                <Binding Path="!LoginUser.IsLoggedInWithSSO" />
                            </MultiBinding>
                        </StackPanel.IsEnabled>
                        <TextBlock Classes="label" Text="Username or Email" />
                        <TextBox Text="{Binding LoginUser.Username}" KeyDown="UserLoginTextBox_KeyDown" />
                        <TextBlock Classes="label" Text="Password" />
                        <TextBox Text="{Binding LoginUser.Password}" PasswordChar="●" Classes="revealPasswordButton" KeyDown="UserLoginTextBox_KeyDown" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Rectangle Fill="{DynamicResource Brush.Foreground}" Width="70" Height="2" VerticalAlignment="Center" />
                        <TextBlock Text="OR" Margin="10,0,10,0" />
                        <Rectangle Fill="{DynamicResource Brush.Foreground}" Width="70" Height="2" VerticalAlignment="Center" />
                    </StackPanel>
                    <CheckBox IsChecked="{Binding LoginUser.IsLoggedInWithSSO}" IsEnabled="{Binding LoginServerInfo.IsSSOEnabled}" Content="Sign in using your Identity Provider" HorizontalAlignment="Center" Margin="0,15,0,0" />
                </StackPanel>
                <uc:IconButton Text="Save" Kind="Skeleton" Height="30" BorderThickness="1" Margin="0,0,120,10" Width="100" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="SaveWithoutLogin_Click">
                    <uc:IconButton.IsEnabled>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <Binding Path="!LoginServerInfo.IsBasicAuthEnabled" />
                            <Binding Path="!LoginUser.IsLoggedInWithSSO" />
                        </MultiBinding>
                    </uc:IconButton.IsEnabled>
                </uc:IconButton>
                <uc:IconButton Text="Save and Login" Height="30" Margin="0,0,10,10" Width="100" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="SaveAndLogin_Click" />
                <uc:IconButton Text="Back" Kind="Skeleton" BorderThickness="1" Height="30" Margin="10,0,0,10" Width="100" HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="Back_Click" Tag="{x:Static local:LoginStep.SignInOrSignUp}" />
            </Grid>

            <!-- 4: Sign up -->
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" Margin="0,8,0,0">
                    <TextBlock Text="Sign Up" FontSize="30" HorizontalAlignment="Center" />
                    <TextBlock Classes="label" Text="Specify Your Server URL" />
                    <Panel>
                        <TextBox Text="{Binding SignupUser.ServerUrl}" TextChanged="ServerUrlInput_TextChanged" KeyDown="UserRegistrationTextBox_KeyDown" />
                        <Path Data="{StaticResource IconCheck}" Fill="Green" Margin="0,0,-30,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding SignUpServerInfo.IsAvailable}" />
                        <Path Data="{StaticResource IconErrorCircle}" Fill="IndianRed" Margin="0,0,-30,0" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Help"
                              IsVisible="{Binding SignUpServerInfo.HasError}" ToolTip.Tip="{Binding SignUpServerInfo.ErrorMessage}" />
                    </Panel>
                    <StackPanel>
                        <StackPanel.IsEnabled>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="SignUpServerInfo.IsBasicAuthEnabled" />
                                <Binding Path="!SignupUser.IsLoggedInWithSSO" />
                            </MultiBinding>
                        </StackPanel.IsEnabled>
                        <Grid ColumnDefinitions="195,10,195">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="label" Text="Username" />
                                <TextBox Text="{Binding SignupUser.Username}" KeyDown="UserRegistrationTextBox_KeyDown" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal" Margin="0,15,0,5">
                                    <TextBlock Text="Birth Date" TextDecorations="Underline" />
                                    <TextBlock Classes="mandatory" Text="(Mandatory)" IsVisible="{Binding SignUpServerInfo.IsBirthDateMandatory}" />
                                </StackPanel>
                                <CalendarDatePicker SelectedDate="{Binding SignupUser.BirthDate}" HorizontalAlignment="Stretch" KeyDown="UserRegistrationTextBox_KeyDown" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,15,0,5">
                            <TextBlock Text="E-Mail" TextDecorations="Underline" />
                            <TextBlock Classes="mandatory" Text="(Mandatory)" IsVisible="{Binding SignUpServerInfo.IsEMailMandatory}" />
                        </StackPanel>
                        <TextBox Text="{Binding SignupUser.EMail}" KeyDown="UserRegistrationTextBox_KeyDown" />
                        <Grid ColumnDefinitions="195,10,195">
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,15,0,5">
                                    <TextBlock Text="First Name" TextDecorations="Underline" />
                                    <TextBlock Classes="mandatory" Text="(Mandatory)" IsVisible="{Binding SignUpServerInfo.IsFirstNameMandatory}" />
                                </StackPanel>
                                <TextBox Text="{Binding SignupUser.FirstName}" KeyDown="UserRegistrationTextBox_KeyDown" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal" Margin="0,15,0,5">
                                    <TextBlock Text="Last Name" TextDecorations="Underline" />
                                    <TextBlock Classes="mandatory" Text="(Mandatory)" IsVisible="{Binding SignUpServerInfo.IsLastNameMandatory}" />
                                </StackPanel>
                                <TextBox Text="{Binding SignupUser.LastName}" KeyDown="UserRegistrationTextBox_KeyDown" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="195,10,195">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="label" Text="Password" />
                                <TextBox Text="{Binding SignupUser.Password}" PasswordChar="●" Classes="revealPasswordButton" KeyDown="UserRegistrationTextBox_KeyDown" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="label" Text="Repeat Password" />
                                <TextBox Text="{Binding SignupUser.RepeatPassword}" PasswordChar="●" Classes="revealPasswordButton" KeyDown="UserRegistrationTextBox_KeyDown" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                            <Rectangle Fill="{DynamicResource Brush.Foreground}" Width="70" Height="2" VerticalAlignment="Center" />
                            <TextBlock Text="OR" Margin="10,0,10,0" />
                            <Rectangle Fill="{DynamicResource Brush.Foreground}" Width="70" Height="2" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <CheckBox IsChecked="{Binding SignupUser.IsLoggedInWithSSO}" IsEnabled="{Binding SignUpServerInfo.IsSSOEnabled}" Content="Sign up using your Identity Provider" HorizontalAlignment="Center" Margin="0,15,0,0" />
                </StackPanel>
                <uc:IconButton Text="Save and Sign Up" Height="30" Margin="0,0,10,10" Width="120" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="SaveAndSignUp_Click" />
                <uc:IconButton Text="Back" Kind="Skeleton" BorderThickness="1" Height="30" Margin="10,0,0,10" Width="100" HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="Back_Click" Tag="{x:Static local:LoginStep.SignInOrSignUp}" />
            </Grid>

            <!-- 5: Edit profile -->
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
                    <TextBlock Text="Edit User Profile" FontSize="30" HorizontalAlignment="Center" />
                    <TextBlock Classes="label" Text="Specify Your Server URL" />
                    <TextBox Text="{Binding EditUser.ServerUrl}" />
                    <TextBlock Classes="label" Text="Username or Email" />
                    <TextBox Text="{Binding EditUser.Username}" />
                    <TextBlock Classes="label" Text="Password" />
                    <TextBox Text="{Binding EditUser.Password}" PasswordChar="●" Classes="revealPasswordButton" />
                </StackPanel>
                <uc:IconButton Text="Save" Height="30" Margin="0,0,10,10" Width="100" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="UserProfileEditSave_Click" />
                <uc:IconButton Text="Back" Kind="Skeleton" BorderThickness="1" Height="30" Margin="10,0,0,10" Width="100" HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="Back_Click" Tag="{x:Static local:LoginStep.ChooseProfile}" />
            </Grid>

            <!-- 6: Pending activation -->
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Your Account is pending Admin Approval" FontSize="30" HorizontalAlignment="Center" />
                    <uc:ProgressRing HorizontalAlignment="Center" IsActive="True" Margin="0,40,0,0" />
                    <TextBlock Text="You can wait or close this screen and check again later." HorizontalAlignment="Center" Margin="0,30,0,0" FontSize="20" />
                    <uc:IconButton Text="Back to Profile Selection" Height="30" Width="250" HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="20" Click="Back_Click" Tag="{x:Static local:LoginStep.ChooseProfile}" />
                </StackPanel>
            </Grid>

            <!-- 7: Client settings -->
            <Grid>
                <TextBlock Text="Client Settings" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,40,0,0">
                    <TextBlock Text="Advanced" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="Additional Request Headers" FontSize="15" Margin="10,10,0,0" />
                    <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto" Width="580" HorizontalAlignment="Left" Margin="10,10,0,0">
                        <ItemsControl ItemsSource="{Binding AdditionalRequestHeaders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,5">
                                        <TextBox Text="{Binding Name}" Watermark="Name" Width="245" />
                                        <TextBox Text="{Binding Value}" Watermark="Value" Width="245" />
                                        <Button Classes="wrapper" Height="30" Width="30" Click="RemoveAdditionalRequestHeader_Click">
                                            <Grid Classes="hover" Background="Transparent">
                                                <Path Data="{StaticResource IconErrorCross}" Stroke="IndianRed" StrokeThickness="2" RenderTransform="scale(2)" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" Margin="10,5,0,0" Spacing="10">
                        <uc:IconButton Icon="{StaticResource IconAddTag}" Text="Add" FontSize="15" IconMargin="0,0,5,2" Width="100" Height="30" Click="AddAdditionalRequestHeader_Click" />
                        <uc:IconButton Icon="{StaticResource IconGameSettingsSave}" Text="Save" FontSize="15" IconMargin="0,0,5,2" Width="100" Height="30" Click="SaveAdditionalHeaders_Click" />
                    </StackPanel>
                </StackPanel>
                <uc:IconButton Text="Back" Kind="Skeleton" BorderThickness="1" Height="30" Margin="10,0,0,10" Width="100" HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="Back_Click" Tag="{x:Static local:LoginStep.ChooseProfile}" />
            </Grid>
        </Carousel>

        <!-- App bar (bottom toast) -->
        <Border Classes="appBar" IsVisible="{Binding IsAppBarOpen}" VerticalAlignment="Bottom" Height="80" Background="{DynamicResource Brush.Background}" ZIndex="2">
            <TextBlock VerticalAlignment="Center" Text="{Binding AppBarText}" FontSize="20" TextWrapping="Wrap" Margin="10,0,35,0" />
        </Border>

        <Panel x:Name="DialogLayer" IsHitTestVisible="False" ZIndex="10" />
    </Panel>
</Window>
